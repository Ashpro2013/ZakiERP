<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Zaki ERP - POS</ApplicationTitle>
    <RootNamespace>ZakiSAASERP.POS</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZakiSAASERP.Interface\ZakiSAASERP.Interface.csproj" />
    <ProjectReference Include="..\ZakiSAASERP.Models\ZakiSAASERP.Models.csproj" />
    <ProjectReference Include="..\ZakiSAASERP.MSSQL\ZakiSAASERP.MSSQL.csproj" />
    <ProjectReference Include="..\ZakiSAASERP.Repo\ZakiSAASERP.Repo.csproj" />
    <ProjectReference Include="..\ZakiSAASERP.ZatcaEngine\ZakiSAASERP.ZatcaEngine.csproj" />
  </ItemGroup>

</Project>
