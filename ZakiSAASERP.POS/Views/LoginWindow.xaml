<Window x:Class="ZakiSAASERP.POS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ZakiSAASERP.POS.Services"
        mc:Ignorable="d"
        Title="Login — Zaki ERP"
        Height="760" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Dark Glass TextBox Style -->
        <Style x:Key="GlassInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#0F0B24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="#3B3564" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#7c3aed" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#06b6d4" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Glass PasswordBox Style -->
        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#0F0B24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="#3B3564" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#7c3aed" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#06b6d4" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#181533" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#7c3aed" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#6366f1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#A5A5C7"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#7c3aed" />
                    <Setter TargetName="Arrow" Property="Fill" Value="White" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#06b6d4" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#06b6d4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Dark Glass ComboBox Style -->
        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#0F0B24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3B3564" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,36,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#181533"
                                        BorderBrush="#4A3B9B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5" />
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="56" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7c3aed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="24" ClipToBounds="True" BorderThickness="1" BorderBrush="#352F64">
        <Border.Background>
            <!-- Background gradient matching .Desk LoginLayout -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f0c29" Offset="0.0" />
                <GradientStop Color="#302b63" Offset="0.55" />
                <GradientStop Color="#1a1a3e" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Top-left orb (Orb 1) -->
            <Ellipse Width="340" Height="340"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-120,-120,0,0" Opacity="0.32" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7c3aed" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="0.75" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Bottom-right orb (Orb 2) -->
            <Ellipse Width="300" Height="300"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-90,-90" Opacity="0.28" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06b6d4" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="0.75" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Close Button -->
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,16,0"
                    Width="30" Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#8E8EA8"
                    FontSize="13"
                    Cursor="Hand"
                    Click="Close_Click" />

            <!-- Login Card Container -->
            <Border Width="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="#3D356A"
                    Padding="32,28"
                    Background="#181533">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.55" />
                </Border.Effect>

                <StackPanel>
                    <!-- Brand Icon Ring (Clicking allows database switch / config) -->
                    <Button Command="{Binding OpenDatabaseConfigCommand}"
                            Width="74" Height="74"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            BorderThickness="0"
                            ToolTip="Click or press Alt+F3 to configure database">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="74" Height="74" CornerRadius="37">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7c3aed" Offset="0.0" />
                                            <GradientStop Color="#06b6d4" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7c3aed" BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
                                    </Border.Effect>
                                    <TextBlock Text="🔒" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Title -->
                    <TextBlock Text="Welcome Back"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />

                    <!-- Gradient Divider Line -->
                    <Border Height="3" Width="52" CornerRadius="2" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#7c3aed" Offset="0.0" />
                                <GradientStop Color="#06b6d4" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Subtitle -->
                    <TextBlock Text="Sign in to your Zaki ERP account"
                               FontSize="11"
                               Foreground="#9999BB"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,18" />

                    <!-- Username Field -->
                    <TextBlock Text="Username" Foreground="#B0B0CE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtUser"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource GlassInputBox}"
                             LostFocus="TxtUser_LostFocus"
                             Margin="0,0,0,12" />

                    <!-- Password Field -->
                    <TextBlock Text="Password" Foreground="#B0B0CE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="TxtPasswordBox"
                                     PasswordChanged="TxtPasswordBox_PasswordChanged"
                                     Style="{StaticResource GlassPasswordBox}"
                                     Padding="12,0,40,0"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                        <TextBox x:Name="TxtPasswordText"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="TxtPasswordText_TextChanged"
                                 Style="{StaticResource GlassInputBox}"
                                 Padding="12,0,40,0"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />

                        <Button Content="👁"
                                HorizontalAlignment="Right"
                                Width="36" Height="36"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#8E8EA8"
                                FontSize="14"
                                Cursor="Hand"
                                Command="{Binding ToggleShowPasswordCommand}" />
                    </Grid>

                    <!-- Remember Me Option -->
                    <CheckBox IsChecked="{Binding IsRememberMe}"
                              Content="Remember Me"
                              Foreground="#C5C5E0"
                              FontSize="11"
                              Margin="0,0,0,12" />

                    <!-- Financial Year Field -->
                    <TextBlock Text="Financial Year" Foreground="#B0B0CE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FinancialYears}"
                              SelectedItem="{Binding SelectedFinancialYear}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource GlassComboBox}"
                              Margin="0,0,0,12" />

                    <!-- Branch Field -->
                    <TextBlock Text="Branch" Foreground="#B0B0CE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Branches}"
                              SelectedItem="{Binding SelectedBranch}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource GlassComboBox}"
                              Margin="0,0,0,16" />

                    <!-- Error Message Banner -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#F87171"
                               FontSize="11"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />

                    <!-- Sign In Submit Button -->
                    <Button Content="SIGN IN"
                            Command="{Binding LoginCommand}"
                            Height="48"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand">
                        <Button.Background>
                            <!-- Gradient button matching .Desk .login-submit-btn -->
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7c3aed" Offset="0.0" />
                                <GradientStop Color="#2563eb" Offset="0.5" />
                                <GradientStop Color="#06b6d4" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Loading Progress -->
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 Foreground="#7c3aed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,10,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                    <!-- Footer -->
                    <TextBlock Text="© 2026 Zaki ERP — All rights reserved"
                               FontSize="10"
                               Foreground="#5E5E7A"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
