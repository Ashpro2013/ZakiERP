<Window x:Class="ZakiSAASERP.POS.Views.DiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Enter Discount" Height="260" Width="380"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, sans-serif">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter Discount Amount" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Discount (SAR):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                <TextBox x:Name="TxtDiscount"
                         Text="{Binding DiscountAmount, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20" FontWeight="Bold" Foreground="#0F172A"
                         Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5"
                         Padding="8" HorizontalContentAlignment="Right"
                         KeyDown="TxtDiscount_KeyDown" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel (Esc)" Style="{DynamicResource DialogCancelBtnStyle}" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="Apply (Enter)" Style="{DynamicResource DialogOkBtnStyle}"
                    Command="{Binding ApplyCommand}" />
        </Grid>
    </Grid>
</Window>

