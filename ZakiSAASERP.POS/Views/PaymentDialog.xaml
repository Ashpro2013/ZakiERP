<Window x:Class="ZakiSAASERP.POS.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Payment" Height="580" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, sans-serif">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="#EFF6FF" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Payment Settlement" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" />
                    <TextBlock Text="Enter customer tender amount to calculate change" FontSize="12" Foreground="#64748B" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Two Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Summary & Inputs -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <!-- Total Payable Card -->
                <Border Background="#1E3A8A" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="TOTAL AMOUNT TO PAY" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} SAR'}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tender Input Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Cash Received (Tendered):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                            <Border Background="#EFF6FF" CornerRadius="4" HorizontalAlignment="Right" Padding="6,2">
                                <TextBlock Text="Cash" FontSize="10" FontWeight="Bold" Foreground="#2563EB" />
                            </Border>
                        </Grid>
                        <TextBox x:Name="TxtTenderInput"
                                 Text="{Binding TenderedBuffer, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                                 Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                 Padding="8" Margin="0,8,0,0" HorizontalContentAlignment="Right"
                                 KeyDown="TxtTenderInput_KeyDown" />
                    </StackPanel>
                </Border>

                <!-- Change / Shortage Display Card -->
                <Border Margin="0,10,0,0" CornerRadius="8" Padding="12"
                        Background="{Binding IsValid, Converter={StaticResource BoolToBackgroundConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding IsValid, Converter={StaticResource BoolToChangeTitleConverter}}" 
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding IsValid, Converter={StaticResource BoolToChangeHeaderColorConverter}}" />
                        <TextBlock Text="{Binding ChangeAmount, StringFormat='{}{0:N2} SAR'}" 
                                   FontSize="24" FontWeight="Bold" Margin="0,2,0,0"
                                   Foreground="{Binding IsValid, Converter={StaticResource BoolToChangeColorConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Quick Presets -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick Presets:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Button Content="Exact" Style="{DynamicResource QuickChipBtnStyle}" Command="{Binding SetExactCommand}" />
                            <Button Content="50" Style="{DynamicResource QuickChipBtnStyle}" Command="{Binding SetPresetCommand}" CommandParameter="{StaticResource Dec50}" />
                            <Button Content="100" Style="{DynamicResource QuickChipBtnStyle}" Command="{Binding SetPresetCommand}" CommandParameter="{StaticResource Dec100}" />
                            <Button Content="200" Style="{DynamicResource QuickChipBtnStyle}" Command="{Binding SetPresetCommand}" CommandParameter="{StaticResource Dec200}" />
                            <Button Content="500" Style="{DynamicResource QuickChipBtnStyle}" Command="{Binding SetPresetCommand}" CommandParameter="{StaticResource Dec500}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Add:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="+5" Style="{DynamicResource QuickAddBtnStyle}" Command="{Binding AddTenderedCommand}" CommandParameter="{StaticResource Dec5}" />
                            <Button Content="+10" Style="{DynamicResource QuickAddBtnStyle}" Command="{Binding AddTenderedCommand}" CommandParameter="{StaticResource Dec10}" />
                            <Button Content="+20" Style="{DynamicResource QuickAddBtnStyle}" Command="{Binding AddTenderedCommand}" CommandParameter="{StaticResource Dec20}" />
                            <Button Content="+50" Style="{DynamicResource QuickAddBtnStyle}" Command="{Binding AddTenderedCommand}" CommandParameter="{StaticResource Dec50}" />
                            <Button Content="+100" Style="{DynamicResource QuickAddBtnStyle}" Command="{Binding AddTenderedCommand}" CommandParameter="{StaticResource Dec100}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Touch NumPad -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 0 -->
                    <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="7" />
                    <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="8" />
                    <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="9" />
                    <Button Grid.Row="0" Grid.Column="3" Content="⌫" Style="{DynamicResource DialogNumActionBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="Backspace" />

                    <!-- Row 1 -->
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="4" />
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="5" />
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="6" />
                    <Button Grid.Row="1" Grid.Column="3" Content="C" Style="{DynamicResource DialogNumActionBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="Clear" />

                    <!-- Row 2 -->
                    <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="1" />
                    <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="2" />
                    <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="3" />
                    <Button Grid.Row="2" Grid.Column="3" Content="Exact" Style="{DynamicResource DialogNumActionBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="Exact" />

                    <!-- Row 3 -->
                    <Button Grid.Row="3" Grid.Column="0" Content="0" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="0" />
                    <Button Grid.Row="3" Grid.Column="1" Content="00" Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="00" />
                    <Button Grid.Row="3" Grid.Column="2" Content="." Style="{DynamicResource DialogNumBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="." />
                    <Button Grid.Row="3" Grid.Column="3" Content="Enter" Style="{DynamicResource DialogNumOkBtnStyle}" Command="{Binding HandleNumKeyCommand}" CommandParameter="Enter" />
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cancel (Esc)" Style="{DynamicResource DialogCancelBtnStyle}" Command="{Binding CancelCommand}" />

            <Button Grid.Column="2" Content="Pay Card (Bank)" Style="{DynamicResource DialogPayCardBtnStyle}" Margin="0,0,10,0"
                    Command="{Binding ConfirmPaymentCommand}" CommandParameter="Bank" />
            <Button Grid.Column="3" Content="Pay Cash" Style="{DynamicResource DialogPayCashBtnStyle}"
                    Command="{Binding ConfirmPaymentCommand}" CommandParameter="Cash"
                    IsEnabled="{Binding IsValid}" />
        </Grid>
    </Grid>
</Window>

