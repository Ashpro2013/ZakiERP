<Window x:Class="ZakiSAASERP.POS.Views.ShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZakiSAASERP.POS.ViewModels"
        mc:Ignorable="d"
        Title="Shift Reconciliation &amp; Handover"
        Icon="/Assets/appicon.ico"
        Height="680" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, Outfit, sans-serif">

    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>

    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header -->
                <RowDefinition Height="*" />
                <!-- Summary & Cash Input -->
                <RowDefinition Height="65" />
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="#F0FDF4" CornerRadius="10" Margin="0,0,14,0">
                        <TextBlock Text="⏱" FontSize="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Shift Reconciliation &amp; Handover" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0">
                            <Run Text="Cashier: " />
                            <Run Text="{Binding CurrentShift.UserName}" FontWeight="Bold" Foreground="#1E3A8A" />
                            <Run Text=" | Terminal: " />
                            <Run Text="{Binding CurrentShift.Terminal}" FontWeight="Bold" Foreground="#1E3A8A" />
                            <Run Text=" | Started: " />
                            <Run Text="{Binding CurrentShift.DateFrom, StringFormat='dd-MM-yyyy hh:mm tt'}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Width="32" Height="32" Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- ==================== CONTENT ==================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14">
                <StackPanel>
                    <!-- Metrics Summary (3 Columns) -->
                    <TextBlock Text="Shift Transaction Totals" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" />
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Opening Cash" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShift.OpeningBalance, StringFormat='{}{0:N2} SAR'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Cash Sales" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShift.TotalCashSales, StringFormat='{}{0:N2} SAR'}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Card / Bank Sales" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShift.TotalCardSales, StringFormat='{}{0:N2} SAR'}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Credit Sales" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShift.TotalCreditSales, StringFormat='{}{0:N2} SAR'}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Sales Returns" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShift.TotalSalesReturn, StringFormat='{}{0:N2} SAR'}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Net Total Sales" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding NetSales, StringFormat='{}{0:N2} SAR'}" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Drawer Reconciliation Section -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,14,4,0">
                        <StackPanel>
                            <TextBlock Text="Cash Drawer Reconciliation" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Expected In Drawer -->
                                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Expected Cash in Drawer:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding ExpectedCash, StringFormat='{}{0:N2} SAR'}" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0" />
                                        <TextBlock Text="(Opening Cash + Cash Sales + Receipts - Payments)" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Actual Cash Counted -->
                                <Border Grid.Column="1" Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Counted Cash in Drawer (SAR):" FontSize="12" FontWeight="Bold" Foreground="#854D0E" />
                                        <TextBox Text="{Binding ActualCash, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                                 FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                                                 Background="#FFFFFF" BorderBrush="#CA8A04" BorderThickness="1"
                                                 Padding="8,4" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Difference Status Banner -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,10">
                                <Grid>
                                    <TextBlock Text="Drawer Discrepancy / Variance:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DifferenceStatus}" FontSize="15" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Next Shift Opening Float -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Next Shift Opening Float (SAR)" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                                    <TextBlock Text="Initial cash balance left in drawer for incoming cashier" FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding NewOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                         FontSize="16" FontWeight="Bold" Padding="8,6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== ACTIONS FOOTER ==================== -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12">
                <Grid>
                    <Button Content="🖨 Print Shift Report" HorizontalAlignment="Left" Padding="14,8" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Command="{Binding PrintShiftReportCommand}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Padding="18,8" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Command="{Binding CancelCommand}" />
                        <Button Content="🔄 Close &amp; Change Shift" Padding="20,8" Background="#16A34A" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Command="{Binding CloseAndChangeShiftCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

