<Window x:Class="ZakiSAASERP.POS.Views.ItemMasterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Item Master - New Product"
        Icon="/Assets/appicon.ico"
        Width="740" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, sans-serif">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource FieldInput}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" Background="#EFF6FF" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Item Master — Add New Product" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Create a new item and add it directly to the POS invoice" FontSize="12" Foreground="#64748B" Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Width="32" Height="32" Background="Transparent" Foreground="#64748B"
                            FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>

            <!-- ==================== FORM CONTENT ==================== -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <!-- Validation / Error Banner -->
                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Basic Identification Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Item Code -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Item Code *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TxtItemCode"
                                     Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsAutoCode}"
                                     Style="{StaticResource FieldInput}" />
                        </StackPanel>

                        <!-- Item Name -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3">
                            <TextBlock Text="Item Name *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TxtItemName"
                                     Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInput}" />
                        </StackPanel>

                        <!-- Arabic Name -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Arabic Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ItemNameArabic, UpdateSourceTrigger=PropertyChanged}"
                                     FlowDirection="RightToLeft"
                                     Style="{StaticResource FieldInput}" />
                        </StackPanel>

                        <!-- Barcode with Clear & Auto-Fill Actions -->
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtBarcode"
                                         Grid.Column="0"
                                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldInput}" />
                                <Button Grid.Column="1" Content="✕" ToolTip="Clear Barcode"
                                        Margin="4,0,0,0" Height="34" Background="#F1F5F9" Foreground="#64748B"
                                        BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"
                                        Command="{Binding ClearBarcodeCommand}" />
                                <Button Grid.Column="2" Content="⚡" ToolTip="Generate from Item Code"
                                        Margin="4,0,0,0" Height="34" Background="#EFF6FF" Foreground="#2563EB"
                                        BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand"
                                        Command="{Binding GenerateBarcodeFromCodeCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Classification & Unit Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Sub Category" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding FilteredSubCategories}" SelectedItem="{Binding SelectedSubCategory}"
                                      DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Brand" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}"
                                      DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Base Unit *" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                                      DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="VAT Rate *" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Vats}" SelectedItem="{Binding SelectedVat}"
                                      DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="Stock Mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding StockModes}" SelectedItem="{Binding StockMode}"
                                      Style="{StaticResource FieldCombo}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pricing & Cost Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Purchase Rate" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PurchaseRateText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInput}" GotFocus="SelectAllText_GotFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Standard Cost" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StandardCostText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInput}" GotFocus="SelectAllText_GotFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Sales Rate (Excl.)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SalesRateText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInput}" GotFocus="SelectAllText_GotFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="6">
                            <TextBlock Text="Inclusive Rate (Incl.) *" Style="{StaticResource FieldLabel}" Foreground="#1E3A8A" />
                            <TextBox Text="{Binding InclusiveRateText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInput}" BorderBrush="#93C5FD" Background="#EFF6FF"
                                     GotFocus="SelectAllText_GotFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5">
                            <TextBlock Text="Location / Shelf / Notes" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInput}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="6" VerticalAlignment="Bottom" Height="34">
                            <CheckBox Content="Is Saleable" IsChecked="{Binding IsSaleable}"
                                      FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== FOOTER ==================== -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="Cancel (Esc)" Style="{DynamicResource DialogCancelBtnStyle}" Margin="0,0,10,0"
                            Command="{Binding CancelCommand}" />

                    <Button Grid.Column="2" Content="Save Product" Style="{DynamicResource DialogOkBtnStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

