<UserControl x:Class="ZakiSAASERP.POS.Views.POSNumPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="360"
             x:Name="RootNumPad">
    <Grid Background="#EEF2F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Row 0 -->
        <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="7" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="8" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="9" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="0" Grid.Column="3" Content="Qty" Style="{DynamicResource NumPadActionBtnStyle}" Click="OnKeyClick" Tag="Qty" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ActionFontSize, ElementName=RootNumPad}" />

        <!-- Row 1 -->
        <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="4" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="5" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="6" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="1" Grid.Column="3" Content="Rate" Style="{DynamicResource NumPadActionBtnStyle}" Click="OnKeyClick" Tag="Rate" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ActionFontSize, ElementName=RootNumPad}" />

        <!-- Row 2 -->
        <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="1" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="2" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="3" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="2" Grid.Column="3" Content="Clear" Style="{DynamicResource NumPadActionBtnStyle}" Click="OnKeyClick" Tag="Clear" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ActionFontSize, ElementName=RootNumPad}" />

        <!-- Row 3 -->
        <Button Grid.Row="3" Grid.Column="0" Content="0" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="0" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="3" Grid.Column="1" Content="." Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="." Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{DynamicResource NumPadBtnStyle}" Click="OnKeyClick" Tag="Backspace" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ButtonFontSize, ElementName=RootNumPad}" />
        <Button Grid.Row="3" Grid.Column="3" Content="Enter" Style="{DynamicResource NumPadActionBtnStyle}" Click="OnKeyClick" Tag="Enter" Focusable="False"
                Height="{Binding ButtonHeight, ElementName=RootNumPad}" FontSize="{Binding ActionFontSize, ElementName=RootNumPad}" />
    </Grid>
</UserControl>
