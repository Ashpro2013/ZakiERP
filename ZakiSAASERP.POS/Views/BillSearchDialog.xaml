<Window x:Class="ZakiSAASERP.POS.Views.BillSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Search Bills / Previous Invoices" Height="540" Width="840"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, sans-serif">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="8" BorderThickness="1" BorderBrush="#CBD5E1"
                         Background="#F8FAFC"
                         KeyDown="TxtSearch_KeyDown" />
                <Button Grid.Column="1" Content="Search" Style="{DynamicResource DialogHeaderBtnStyle}" Margin="8,0,0,0"
                        Command="{Binding SearchCommand}" />
            </Grid>
        </Border>

        <!-- Invoices DataGrid & Overlays -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
            <Grid>
                <DataGrid x:Name="GridBills"
                          ItemsSource="{Binding Bills}"
                          SelectedItem="{Binding SelectedBill}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="#FFFFFF"
                          Foreground="#1E293B"
                          RowHeight="36"
                          FontSize="13"
                          EnableRowVirtualization="True"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          KeyDown="GridBills_KeyDown"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#1E293B" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="#334155" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding Code}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding Description}" Width="110" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Bill Type" Binding="{Binding ReferenceNo}" Width="100" />
                        <DataGridTextColumn Header="Ref No" Binding="{Binding ExtraField}" Width="100" />
                        <DataGridTextColumn Header="Grand Total" Binding="{Binding Amount, StringFormat='{}{0:N2} SAR'}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="#059669" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <Grid Background="#B3FFFFFF"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="140" Height="6" Margin="0,0,0,8" />
                        <TextBlock Text="Loading invoices..." FontSize="13" Foreground="#475569" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- No Results / Error Overlay -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                        <Condition Binding="{Binding Bills.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🧾" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.5" />
                    <TextBlock Text="No invoices found" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel (Esc)" Style="{DynamicResource DialogCancelBtnStyle}" Command="{Binding CancelCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding Bills.Count, StringFormat='{}{0} bill(s) found'}"
                       Foreground="#64748B" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="2" Content="Load Bill (Enter)" Style="{DynamicResource DialogOkBtnStyle}" Command="{Binding SelectCommand}" />
        </Grid>
    </Grid>
</Window>

