<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AshproSAASERP.Desk.CustomerDisplayPage"
    Title="Zaki ERP - Customer Display"
    BackgroundColor="#0F172A"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="80,*,90">

        <!-- Header -->
        <Border
            Grid.Row="0"
            BackgroundColor="#2563EB"
            StrokeThickness="0">

            <Grid Padding="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    Text="ZAKI ERP POS"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="1"
                    Text="CUSTOMER DISPLAY"
                    FontSize="22"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Padding="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="5*,1*,2*,2*"
                Padding="0,0,0,10">

                <Label
                    Text="ITEM"
                    FontAttributes="Bold"
                    FontSize="24"
                    TextColor="#FACC15"/>

                <Label
                    Grid.Column="1"
                    Text="QTY"
                    HorizontalTextAlignment="Center"
                    FontAttributes="Bold"
                    FontSize="24"
                    TextColor="#FACC15"/>

                <Label
                    Grid.Column="2"
                    Text="PRICE"
                    HorizontalTextAlignment="End"
                    FontAttributes="Bold"
                    FontSize="24"
                    TextColor="#FACC15"/>

                <Label
                    Grid.Column="3"
                    Text="TOTAL"
                    HorizontalTextAlignment="End"
                    FontAttributes="Bold"
                    FontSize="24"
                    TextColor="#FACC15"/>

            </Grid>

            <!-- Items -->
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Items}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,5"
                            BackgroundColor="#1E293B"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">

                            <Grid
                                Padding="15"
                                ColumnDefinitions="5*,1*,2*,2*">

                                <Label
                                    Text="{Binding ItemName}"
                                    FontSize="24"
                                    TextColor="White"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Qty}"
                                    FontSize="24"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Rate,StringFormat='₹ {0:N2}'}"
                                    FontSize="24"
                                    TextColor="White"
                                    HorizontalTextAlignment="End"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="3"
                                    Text="{Binding Total,StringFormat='₹ {0:N2}'}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#22C55E"
                                    HorizontalTextAlignment="End"
                                    VerticalOptions="Center"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- Footer -->
        <Border
            Grid.Row="2"
            BackgroundColor="#16A34A"
            StrokeThickness="0">

            <Grid Padding="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    Text="TOTAL"
                    FontSize="42"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"/>

                <Label
                    Grid.Column="1"
                    Text="{Binding Total,StringFormat='₹ {0:N2}'}"
                    FontSize="46"
                    FontAttributes="Bold"
                    TextColor="Yellow"
                    VerticalOptions="Center"/>

            </Grid>

        </Border>

    </Grid>

</ContentPage>