@page "/ledgerreport"
@using AshproSAASERP.Shared.Pages.Component
@using AshproSAASERP.Shared.SubWindows
@inject IViewService api;
@inject Downloader downloader
@inject ModelService Dialog
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TabService tabService

<PageTitle>@AppData.OEMAgency | @Localizer("Ledger Report")</PageTitle>

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Ledger Report")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => tabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Date Range *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("FromDate")</MudText>
                <MudDatePicker @bind-Date="FromDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("ToDate")</MudText>
                <MudDatePicker @bind-Date="ToDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* Branch *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Branch")</MudText>
                <MudSelect T="int" @bind-Value="BranchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Account *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Account")</MudText>
                <MudStack Row>
                    <MudTextField @bind-Value="AccountName" Variant="Variant.Outlined"
                                  Class="w-100" Margin="Margin.Dense" Clearable="true" Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="AccountSearchMethod" ReadOnly="true" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => { AccountId = 0; AccountName = ""; })" Disabled="@(AccountId == 0)" />
                </MudStack>
            </MudItem>

        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Receipt" Color="Color.Success" OnClick="ReportGenerate">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.TableView" Color="Color.Primary" OnClick="ExcelExportMethod">@Localizer("Excel")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" OnClick="PDFExportMethod">@Localizer("PDF")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudStack>
    </MudCardActions>
    <MudOverlay Visible="IsLoading" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    </MudOverlay>
</MudCard>
@if (reportData.Any())
{
    <MudGrid Class="ma-2 px-4 py-2 border-1 rounded-sm mud-border-primary" Style="background-color: var(--mud-palette-background-grey)">
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudText Typo="Typo.body2"><b>@Localizer("Opening Balance"):</b></MudText>
            <MudText Typo="Typo.body2" Class="ml-2">@result!.OpeningBalance</MudText>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudText Typo="Typo.body2"><b>@Localizer("Total Debit"):</b></MudText>
            <MudText Typo="Typo.body2" Class="ml-2" Style="color:var(--mud-palette-success)">@PermanentSettingsData.FormatCurrency(result!.TotalDebit)</MudText>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudText Typo="Typo.body2"><b>@Localizer("Total Credit"):</b></MudText>
            <MudText Typo="Typo.body2" Class="ml-2" Style="color:var(--mud-palette-error)">@PermanentSettingsData.FormatCurrency(result!.TotalCredit)</MudText>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudText Typo="Typo.body2"><b>@Localizer("Closing Balance"):</b></MudText>
            <MudText Typo="Typo.body2" Class="ml-2">@result!.TotalBalance</MudText>
        </MudItem>
    </MudGrid>
}
@if (reportData.Any())
{
    @* Result Grid *@
    <MudTable T="LedgerReportDtls" Items="@reportData" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="500px" Class="ma-2" Elevation="3" OnRowClick="RowClickEvent">
        <HeaderContent>
            <MudTh>@Localizer("SL")</MudTh>
            <MudTh>@Localizer("Date")</MudTh>
            <MudTh>@Localizer("VoucherNo")</MudTh>
            <MudTh>@Localizer("Type")</MudTh>
            <MudTh>@Localizer("Narration")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Debit")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Credit")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Balance")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SL">@context.SL</MudTd>
            <MudTd DataLabel="Date">@(context.Date)</MudTd>
            <MudTd DataLabel="VoucherNo">@context.VoucherNo</MudTd>
            <MudTd DataLabel="Type">@context.VoucherType</MudTd>
            <MudTd DataLabel="Narration">@context.Narration</MudTd>
            <MudTd DataLabel="Debit" Style="text-align:right; color:green">@((context.Debit == 0) ? "" : PermanentSettingsData.FormatCurrency(context.Debit))</MudTd>
            <MudTd DataLabel="Credit" Style="text-align:right; color:red">@((context.Credit == 0) ? "" : PermanentSettingsData.FormatCurrency(context.Credit))</MudTd>
            <MudTd DataLabel="Balance" Style="text-align:right; font-weight:bold">@context.Balance</MudTd>
        </RowTemplate>

    </MudTable>
}

