@page "/itemtransactionhistoryreport"
@inject IViewService ViewService
@inject ISnackbar Snackbar
@inject Downloader downloader
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ModelService Dialog
@inject TabService TabService

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Item Transaction History")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("FromDate")</MudText>
                <MudDatePicker @bind-Date="req.FromDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("ToDate")</MudText>
                <MudDatePicker @bind-Date="req.ToDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("Branch")</MudText>
                <MudSelect T="int?" @bind-Value="req.BranchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem T="int?" Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("Store")</MudText>
                <MudSelect T="int?" @bind-Value="req.StoreId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var store in storeList)
                    {
                        <MudSelectItem T="int?" Value="@store.Id">@store.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
               <MudText>@Localizer("Item")</MudText>
                <MudAutocomplete T="CommonModel" Label="@Localizer("Search Item")" @bind-Value="selectedItem" SearchFunc="@SearchItem"
                                 ToStringFunc="@(e => e == null ? null : $"{e.Name} - {e.Code}")"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="ReportGenerate">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="ExcelExportMethod">@Localizer("Excel")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Error" OnClick="PDFExportMethod">@Localizer("PDF")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>

@if (pdfData is not null)
{
    <ReportView pdfData="@pdfData" />
}
