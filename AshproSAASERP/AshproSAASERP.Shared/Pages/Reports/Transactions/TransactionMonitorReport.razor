@page "/transactionMonitorReport"
@using AshproSAASERP.Shared.Layout
@using static AshproSAASERP.Shared.Services.ArabicLocalization

@using AshproSAASERP.Shared.SubWindows
@inject IViewService api;
@inject Downloader downloader
@inject ModelService Dialog
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject TabService tabService

<PageTitle>@Localizer("Transaction Monitor Report")</PageTitle>

    <MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Transaction Monitor Report")</MudText>
                <MudSpacer />
                 <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => tabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Transaction Type Selection *@
            <MudItem xs="12">
                <MudRadioGroup @bind-Value="selectedTransactionType" T="string">
                    <MudStack Row="true" Spacing="2">
                        <MudRadio T="string" Value="@("Delivery Note")" Color="Color.Primary">@Localizer("Delivery Note")</MudRadio>
                        <MudRadio T="string" Value="@("Sales Invoice")" Color="Color.Primary">@Localizer("Sales Invoice")</MudRadio>
                        <MudRadio T="string" Value="@("Sales Quotation")" Color="Color.Primary">@Localizer("Sales Quotation")</MudRadio>
                        <MudRadio T="string" Value="@("Proforma Invoice")" Color="Color.Primary">@Localizer("Proforma Invoice")</MudRadio>
                    </MudStack>
                </MudRadioGroup>
            </MudItem>

            @* Date Range *@
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@Localizer("From Date")" @bind-Date="fromDate" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@Localizer("To Date")" @bind-Date="toDate" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* Branch *@
             <MudItem xs="12" sm="3">
                <MudSelect T="int" Label="@Localizer("Branch")" @bind-Value="branchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Party (Customer) *@
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="partyName" Label="@Localizer("Customer")" Variant="Variant.Outlined"
                              Class="w-100" Margin="Margin.Dense" Adornment="Adornment.End"
                              AdornmentIcon="@(partyId > 0 ? Icons.Material.Filled.Close : Icons.Material.Filled.Search)"
                              OnAdornmentClick="@(async () => { if (partyId > 0) { partyId = 0; partyName = ""; } else { await PartySearchMethod(); } })" 
                              ReadOnly="true" />
            </MudItem>



        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadData" StartIcon="@Icons.Material.Filled.Receipt">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportExcel" StartIcon="@Icons.Material.Filled.TableView">@Localizer("Excel")</MudButton>
             <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>

@if (result is not null)
{
    @* Summary *@
    <MudGrid Class="ma-2">
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Count"):</b> @result.TotalCount</MudText>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Amount"):</b> @PermanentSettingsData.FormatCurrency(result.TotalAmount)</MudText>
        </MudItem>
    </MudGrid>
}

    <MudTable Items="@(result?.Reports ?? new List<TransactionMonitorDtls>())" @ref="table" Dense="true" Hover="true" Bordered="true" Striped="true" T="TransactionMonitorDtls" Class="ma-2" Elevation="3" OnRowClick="RowClickEvent">
         <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("Search Results")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchString" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" OnDebounceIntervalElapsed="LoadData" DebounceInterval="500"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localizer("Voucher No")</MudTh>
            <MudTh>@Localizer("Date")</MudTh>
            <MudTh>@Localizer("Party Name")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Amount")</MudTh>
            <MudTh>@Localizer("Quot No")</MudTh>
            <MudTh>@Localizer("Proforma No")</MudTh>
            <MudTh>@Localizer("Sales No")</MudTh>
            <MudTh>@Localizer("Delivery No")</MudTh>
        <MudTh>@Localizer("Ref No")</MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Voucher No">@context.InvoiceNo</MudTd>
            <MudTd DataLabel="Date">@context.Date</MudTd>
            <MudTd DataLabel="Party Name">@context.PartyName</MudTd>
            <MudTd DataLabel="Amount" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Amount)</MudTd>
            <MudTd DataLabel="Quot No">@context.QuotNo</MudTd>
            <MudTd DataLabel="Proforma No">@context.ProformaNo</MudTd>
            <MudTd DataLabel="Sales No">@context.SalesNo</MudTd>
            <MudTd DataLabel="Delivery No">@context.DeliveryNo</MudTd>
        <MudTd DataLabel="Ref No">@context.RefNo</MudTd>


        </RowTemplate>

    </MudTable>

@if (IsLoading)
{
    <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
}
