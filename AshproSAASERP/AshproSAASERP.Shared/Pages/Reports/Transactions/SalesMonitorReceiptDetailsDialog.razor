@using AshproSAASERP.Models.DTO
@using AshproSAASERP.Shared.Services
@inject IViewService api
@inject TabService NavService
@inject IDialogService DialogService

    <MudDialog>
    <DialogContent>
        <MudTable Items="@receipts" Dense="true" Hover="true" Bordered="true" Striped="true" T="SalesMonitorReceiptItem">
            <HeaderContent>
                 <MudTh>@Localizer("Receipt No")</MudTh>
                 <MudTh>@Localizer("Date")</MudTh>
                 <MudTh Style="text-align:right">@Localizer("Amount")</MudTh>
                 <MudTh Style="text-align:right">@Localizer("Discount")</MudTh>
                 <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Receipt No">@context.ReceiptNo</MudTd>
                <MudTd DataLabel="Date">@context.Date</MudTd>
                <MudTd DataLabel="Amount" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Amount)</MudTd>
                <MudTd DataLabel="Discount" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Discount)</MudTd>
                 <MudTd><MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Info" Size="Size.Small" OnClick="@(() => NavigateToReceipt(context.ReceiptId))"/></MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int InvoiceId { get; set; }

    private List<SalesMonitorReceiptItem> receipts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            receipts = await api.GetReceiptsByInvoiceAsync(InvoiceId);
        }
        catch (Exception ex)
        {
             // Handle error
        }
    }

    private async Task NavigateToReceipt(int receiptId)
    {
        await CrudHelper.Navigation(NavService, receiptId, "CustomerReceipt");
        MudDialog.Close(DialogResult.Cancel());
    }
    void Cancel() => MudDialog.Cancel();
}
