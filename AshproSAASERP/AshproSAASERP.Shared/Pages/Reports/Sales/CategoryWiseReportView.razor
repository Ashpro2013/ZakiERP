@page "/categorywise"
@using AshproSAASERP.Shared.Pages.Component
@using AshproSAASERP.Shared.SubWindows
@inject IViewService api
@inject Downloader downloader
@inject ModelService Dialog
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TabService TabService

<PageTitle>@AppData.OEMAgency | @Localizer("Category Wise Report")</PageTitle>

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Category Wise Report")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Date Range *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("FromDate")</MudText>
                <MudDatePicker @bind-Date="req.FromDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("ToDate")</MudText>
                <MudDatePicker @bind-Date="req.ToDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* Branch *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Branch")</MudText>
                <MudSelect T="int" @bind-Value="req.BranchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Category *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Category")</MudText>
                <MudSelect T="int" @bind-Value="req.CategoryId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var cat in categoryList)
                    {
                        <MudSelectItem Value="@cat.Id">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Invoice Type *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Invoice Type")</MudText>
                <MudSelect T="string" @bind-Value="req.InvoiceType" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">@Localizer("All")</MudSelectItem>
                    <MudSelectItem Value="@("Sales")">@Localizer("Sales")</MudSelectItem>
                    <MudSelectItem Value="@("Sales Return")">@Localizer("Sales Return")</MudSelectItem>
                </MudSelect>
            </MudItem>

            @* Bill Type *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Bill Type")</MudText>
                <MudSelect T="string" @bind-Value="req.BillType" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">@Localizer("All")</MudSelectItem>
                    <MudSelectItem Value="@("Cash")">@Localizer("Cash")</MudSelectItem>
                    <MudSelectItem Value="@("Credit")">@Localizer("Credit")</MudSelectItem>
                    <MudSelectItem Value="@("Bank")">@Localizer("Bank")</MudSelectItem>
                </MudSelect>
            </MudItem>

        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudGrid Class="ma-2">
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Receipt" Color="Color.Success" OnClick="ReportGenerate">@Localizer("Generate")</MudButton>
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.TableView" Color="Color.Primary" OnClick="ExcelExportMethod">@Localizer("Excel")</MudButton>
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" OnClick="PDFExportMethod">@Localizer("PDF")</MudButton>
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudGrid>
    </MudCardActions>
</MudCard>

@if (pdfData is not null)
{
    <ReportView pdfData="@pdfData" />
}
@if (IsLoading)
{
    <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
}