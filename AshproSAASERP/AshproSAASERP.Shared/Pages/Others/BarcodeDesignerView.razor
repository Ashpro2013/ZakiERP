@page "/barcodedesigner"
@using AshproSAASERP.Models.Others
@inject IViewService api;
@inject IDialogService DialogService;
@inject ModelService Dialog;
@inject NavigationManager navManager
@inject Downloader downloader
@inject IJSRuntime JS
@inject TabService TabService
@inject IFormFactor formFactor
@inject ISnackbar snackbar

@* Title*@
<PageTitle>@AppData.OEMAgency | Barcode Designer</PageTitle>
@*End Title*@
<MudPaper Elevation="3" Class="pa-4 ma-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">Barcode Designer</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
           <MudPaper Elevation="1" Class="pa-4 ma-2">
            <MudStack Row="true" Spacing="2">
                <MudText Class="settings-label" Style="white-space:nowrap;">Field:</MudText>
                <MudSelect T="string" Value="selectedField" ValueChanged="OnFieldChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="flex-grow-1" >
                    @foreach (var item in Fields)
                    {
                        <MudSelectItem Value="@item">@item</MudSelectItem>
                    }
                </MudSelect>
                <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" OnClick="AddControl"  />
                <MudFab StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" OnClick="RemoveControl"  />
            </MudStack>
            <div class="d-flex justify-content-center">

                <div id="designContainer"
                     class="preview-box mb-3"
                     style="width:@(hdr.Width)px;
                height:@(hdr.Height)px;
                background-color:#fff8dc;
                position:relative;
                box-shadow:0 0 15px rgba(0,0,0,0.2);">

                    @foreach (var c in Controls)
                    {
                        @if (c.Type == "Barcode" || c.Name == "Barcode")
                        {
                            <div @onmousedown="(e) => StartDrag(e, c)"
                                 @onclick="() => SelectControl(c)"
                                 class="barcode-element"
                                 style="position:absolute;
                                    left:@($"{c.Position_x}px");
                                    top:@($"{c.Position_y}px");
                                    width:@($"{c.Width}px");
                                    height:@($"{c.Height}px");
                                    border:1px dashed #333;
                                    background-color: rgba(255,255,255,0.7);
                                    cursor:move;">

                                <img src="_content/AshproSAASERP.Shared/barcode-sample.jpg"
                                     onerror="if(this.src.indexOf('barcode-sample.jpg')!==-1 && !this.dataset.fallback){this.dataset.fallback='1';this.src='barcode-sample.jpg';}else{this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display='flex';}"
                                     style="width:100%; height:100%; pointer-events:none; object-fit:contain;" />
                                <div style="display:none; width:100%; height:100%; flex-direction:column; align-items:center; justify-content:center; background:#fff; overflow:hidden;">
                                    <svg width="100%" height="70%" viewBox="0 0 200 60" preserveAspectRatio="none">
                                        <rect x="0" y="0" width="200" height="60" fill="white" />
                                        <rect x="10" y="5" width="4" height="40" fill="black" />
                                        <rect x="16" y="5" width="2" height="40" fill="black" />
                                        <rect x="22" y="5" width="6" height="40" fill="black" />
                                        <rect x="32" y="5" width="2" height="40" fill="black" />
                                        <rect x="38" y="5" width="4" height="40" fill="black" />
                                        <rect x="46" y="5" width="8" height="40" fill="black" />
                                        <rect x="58" y="5" width="2" height="40" fill="black" />
                                        <rect x="64" y="5" width="4" height="40" fill="black" />
                                        <rect x="72" y="5" width="6" height="40" fill="black" />
                                        <rect x="82" y="5" width="2" height="40" fill="black" />
                                        <rect x="88" y="5" width="4" height="40" fill="black" />
                                        <rect x="96" y="5" width="6" height="40" fill="black" />
                                        <rect x="106" y="5" width="4" height="40" fill="black" />
                                        <rect x="114" y="5" width="2" height="40" fill="black" />
                                        <rect x="120" y="5" width="8" height="40" fill="black" />
                                        <rect x="132" y="5" width="4" height="40" fill="black" />
                                        <rect x="140" y="5" width="2" height="40" fill="black" />
                                        <rect x="146" y="5" width="6" height="40" fill="black" />
                                        <rect x="156" y="5" width="4" height="40" fill="black" />
                                        <rect x="164" y="5" width="2" height="40" fill="black" />
                                        <rect x="170" y="5" width="6" height="40" fill="black" />
                                        <rect x="180" y="5" width="2" height="40" fill="black" />
                                        <rect x="186" y="5" width="4" height="40" fill="black" />
                                    </svg>
                                    <span style="font-size:11px; font-family:monospace; color:#000;">@(c.Text ?? "123456789")</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div @onmousedown="(e) => StartDrag(e, c)"
                                 @onclick="() => SelectControl(c)"
                                 style="@GetStyle(c)">
                                @c.Text
                            </div>
                        }
                    }

                </div>

            </div>
            <MudGrid Spacing="1" Class="mb-3">
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" OnClick="GenerateBarcode" Class="custom-btn" Style="background-color:#00bcd4; color:white;">Generate</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" OnClick="PreviewBarcode" Class="custom-btn" Style="background-color:#00bcd4; color:white;">Preview</MudButton>
                </MudItem>
            </MudGrid>
            <MudPaper Class="pa-4 mt-4" Elevation="4">
                    <MudText Typo="Typo.h6">Barcode Preview</MudText>
                @if (!string.IsNullOrEmpty(barcodeImageBase64) && barcodeImageBase64.StartsWith("data:image/"))
                {
                    <div style="display:flex; justify-content:center; align-items:center; padding:10px; background:#fff; border:1px solid #e0e0e0; border-radius:4px; min-height:160px; overflow:auto;">
                        <img src="@barcodeImageBase64" alt="Barcode Preview" style="max-width:100%; height:auto; box-shadow:0 2px 8px rgba(0,0,0,0.12);" />
                    </div>
                }
                else
                {
                    <iframe src="@barcodeImageBase64"
                            width="100%"
                            height="200px"
                            style="border:none">
                    </iframe>
                }
                </MudPaper>
           </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
             <MudPaper Elevation="1" Class="pa-4 ma-2">
            <MudText Class="section-title"><b>Field Settings</b></MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Class="settings-label">Name:</MudText>
                    <MudTextField @bind-Value="dtls.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Text:</MudText>
                    <MudTextField @bind-Value="dtls.Text" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="6">
                    <MudText Class="settings-label">Width:</MudText>
                    <MudNumericField @bind-Value="dtls.Width" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Height:</MudText>
                    <MudNumericField @bind-Value="dtls.Height" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudText Class="settings-label">X:</MudText>
                    <MudNumericField @bind-Value="dtls.Position_x" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Y:</MudText>
                    <MudNumericField @bind-Value="dtls.Position_y" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>

                <!-- Added Font settings based on new model -->
                <MudItem xs="6">
                    <MudText Class="settings-label">Font Family:</MudText>
                    <MudItem xs="12" sm="12">
                        <MudSelect @bind-Value="dtls.fontFamily" T="string" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var item in FontFamilies)
                            {
                                <MudSelectItem Value=@item>@item</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Font Size:</MudText>
                    <MudNumericField @bind-Value="dtls.fontSize" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>

                <!-- Prefix was removed from model. Alignment remains -->
                <MudItem xs="6">
                    <MudText Class="settings-label">Font Family:</MudText>
                    <MudSelect @bind-Value="dtls.Alignment" T="string" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var item in AlignmentList)
                        {
                            <MudSelectItem Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Font Style:</MudText>
                    <MudSelect @bind-Value="dtls.fStyle" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var item in FontStyle)
                        {
                            <MudSelectItem Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="dtls.Prefix" Label="Prefix" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" Class="mt-2">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewClick" Class="custom-btn">New</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveOrUpdate" Class="custom-btn">Save</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Delete" Class="custom-btn">Delete</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
             <MudPaper Elevation="1" Class="pa-4 ma-2">
            <MudText Class="section-title"><b>Label Settings</b></MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Class="settings-label">Width:</MudText>
                    <MudNumericField @bind-Value="hdr.Width" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Height:</MudText>
                    <MudNumericField @bind-Value="hdr.Height" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudText Class="settings-label">First/Left Margin:</MudText>
                    <MudNumericField @bind-Value="hdr.FirstMargin" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Right Margin:</MudText>
                    <MudNumericField @bind-Value="hdr.RightMargin" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudText Class="settings-label">Top Margin:</MudText>
                    <MudNumericField @bind-Value="hdr.TopMargin" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Class="settings-label">Bottom Margin:</MudText>
                    <MudNumericField @bind-Value="hdr.BottomMargin" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-3" />
            <MudText Class="section-title"><b>Barcode Settings</b></MudText>
                <div class="d-flex gap-4 mb-2">
                    <MudCheckBox T="bool"
                                 @bind-Value="hdr.IsBorderIncluded"
                                 Label="Border"
                                 Size="Size.Small"
                                 Color="Color.Default" />

                    <MudCheckBox T="bool"
                                 @bind-Value="hdr.GenerateLabel"
                                 Label="Label"
                                 Size="Size.Small"
                                 Color="Color.Default" />

                    <MudCheckBox T="bool"
                                 @bind-Value="hdr.IsDefault"
                                 Label="Default"
                                 Size="Size.Small"
                                 Color="Color.Default" />
                </div>
            <MudText Class="settings-label">Name:</MudText>
            <MudTextField @bind-Value="hdr.DesignName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudItem Class="mt-5">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="SearchDesign" Class="custom-btn" Style="min-width:auto;">Search</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="DownloadJson" Class="custom-btn">Export</MudButton>
                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="UploadFiles"
                                       Accept=".json"
                                       Hidden="true">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="custom-btn">Import</MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudStack>
                </MudItem>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>
