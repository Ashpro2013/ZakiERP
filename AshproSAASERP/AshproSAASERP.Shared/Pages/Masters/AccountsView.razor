@page "/accounts"
@inject IViewService api
@inject ModelService Dialog
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject TabService TabService

<PageTitle>Accounts Details</PageTitle>

<MudPaper Class="pa-4 ma-2" Elevation="3">
    <MudStack Spacing="2">
        <MudStack Row="true">
            <MudText Typo="Typo.h5">@Localizer("AccountsTitle")</MudText>
            <MudSpacer />
            @if (!IsDialog)
            {
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            }
        </MudStack>

        <EditForm Model="accountMaster" OnValidSubmit="SaveOrUpdate">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudGrid Class="mb-2">
                <!-- Code -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("Code")</MudText>
                    <MudTextField AutoFocus="true" @ref="txtCode" @bind-Value="accountMaster.Code" OnKeyDown="@(e => KeyDown(e, 1))"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <ValidationMessage For="@(() => accountMaster.Code)" />
                </MudItem>
                <!-- Account Name -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("AccountName")</MudText>
                    <MudStack Row="true">
                        <MudTextField @bind-Value="accountMaster.Name" @ref="txtName" OnKeyDown="@(e => KeyDown(e, 2))"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudFab StartIcon="@Icons.Material.Rounded.Translate" Color="Color.Info" Size="Size.Small" OnClick="ToArabic" />
                    </MudStack>
                    <ValidationMessage For="@(() => accountMaster.Name)" />
                </MudItem>
                <!-- Arabic Name -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("ArabicName")</MudText>
                    <MudTextField @bind-Value="accountMaster.NameArabic" @ref="txtNameArabic" OnKeyDown="@(e => KeyDown(e, 3))"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <ValidationMessage For="@(() => accountMaster.NameArabic)" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-2">
                <!-- Opening -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("Opening")</MudText>
                    <MudTextField @bind-Value="accountMaster.Opening" Format="@PermanentSettingsData.CurrencyFormat"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <!-- Effect (Dr/Cr) -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("Effect")</MudText>
                    <MudSelect T="string" @ref="cmbDbCr" @bind-Value="accountMaster.DbCr"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var item in dbCrList)
                        {
                            <MudSelectItem Value="@item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <!-- Account Type (Asset/Liability) -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("AccountType")</MudText>
                    <MudSelect T="int?" Value="@accountMaster.FK_AcTypeId" ValueChanged="@((int? value) => OnTypeChanged(value))"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var item in accountTypeList)
                        {
                            <MudSelectItem Value="@((int?)item.AcTypeId)">@item.AcTypeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-2">
                <!-- Account Head -->
                <MudItem xs="12" sm="4">
                   <MudText>@Localizer("AccountHead")</MudText>
                    <MudSelect T="int?" Value="@(accountMaster.FK_AccountHeadId == 0 ? (int?)null : accountMaster.FK_AccountHeadId)" ValueChanged="@((int? value) => OnHeadChanged(value ?? 0))"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var item in filteredAccountHeadList)
                        {
                            <MudSelectItem Value="@((int?)item.AccountHeadId)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
               </MudItem>

                <!-- Group -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("Group")</MudText>
                    <MudSelect T="int?" Value="@(accountMaster.FK_AcGroupId == 0 ? (int?)null : accountMaster.FK_AcGroupId)" ValueChanged="@((int? value) => OnGroupChanged(value ?? 0))"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var item in filteredAccountGroupList)
                        {
                            <MudSelectItem Value="@((int?)item.AccountGroupId)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <!-- SubGroup -->
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("SubGroup")</MudText>
                    <MudSelect T="int?" Value="@(accountMaster.FK_AccountSubGroupId == 0 ? (int?)null : accountMaster.FK_AccountSubGroupId)" ValueChanged="@((int? value) => OnSubGroupChanged(value ?? 0))"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var item in filteredSubGroupList)
                        {
                            <MudSelectItem Value="@((int?)item.SubGroupId)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="3" Class="ma-2">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           StartIcon="@(accountMaster.AccountId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)"
                           Color="@(accountMaster.AccountId == 0 ? Color.Success : Color.Info)"
                           Disabled="@((accountMaster.AccountId != 0 && accountMaster.IsReserved) || _isSaving)">
                           @if (_isSaving)
                           {
                               <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                               <MudText Class="ms-2">@Localizer("Processing")</MudText>
                           }
                           else
                           {
                               @Localizer(accountMaster.AccountId == 0 ? "Save" : "Update")
                           }
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           OnClick="Delete"
                           Disabled="@accountMaster.IsReserved">@Localizer("Delete")</MudButton>
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info"
                           OnClick="NewClick">@Localizer("New")</MudButton>
            </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2" Elevation="3">
    <MudDataGrid T="AccountMaster"
                 @ref="grid"
                 ServerData="LoadServerData"
                 Bordered="true"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 RowClick="RowClicked"
                 Class="ma-2">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("AccountsList")</MudText>
            <MudSpacer />
            <MudTextField Value="searchText" ValueChanged="@(async (string s) => { searchText = s; if (grid is not null) await grid.ReloadServerData(); })" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Dense="true" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer("AccountName")" />
            <PropertyColumn Property="x => x.DbCr" Title="@Localizer("Effect")" />
            <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
            <PropertyColumn Property="x => x.IsReserved" Title="@Localizer("Type")" Sortable="true">
                <CellTemplate>
                    @if (context.Item.IsReserved)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@Localizer("Built-in")</MudChip>
                    }
                    else
                    {
                        <MudChip Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@Localizer("Custom")</MudChip>
                    }
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AccountMaster" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
