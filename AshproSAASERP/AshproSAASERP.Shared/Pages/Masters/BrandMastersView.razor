@page "/brand"
@inject IViewService api
@inject ModelService Dialog
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject TabService TabService

<PageTitle>Brand Master</PageTitle>

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Row="true">
        <MudText Class="pa-2 ma-2" Typo="Typo.h5">@Localizer("BrandMaster")</MudText>
        <MudSpacer />
        @if (!IsDialog)
        {
            <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        }
    </MudStack>

    <EditForm Model="brandMaster" OnValidSubmit="SaveOrUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText>@Localizer("Code")</MudText>
                <MudTextField @ref="txtCode" AutoFocus="true" OnKeyDown="@(e => KeyDown(e, 1))"
                              @bind-Value="brandMaster.Code"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <ValidationMessage For="@(() => brandMaster.Code)" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText>@Localizer("Name")</MudText>
                <MudStack Row>
                    <MudTextField @bind-Value="brandMaster.Name" @ref="txtName" OnKeyDown="@(e => KeyDown(e, 2))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudFab StartIcon="@Icons.Material.Rounded.Translate" Color="Color.Info" Size="Size.Small" OnClick="ToArabic" />
                    <ValidationMessage For="@(() => brandMaster.Name)" />
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText>@Localizer("ArabicName")</MudText>
                <MudTextField @bind-Value="brandMaster.NameArabic" @ref="txtNameArabic" OnKeyDown="@(e => KeyDown(e, 3))"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText>@Localizer("Remarks")</MudText>
                <MudTextField @bind-Value="brandMaster.Remarks" @ref="txtRemarks" OnKeyDown="@(e => KeyDown(e, 4))"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        <MudStack Row Spacing="3" Class="ma-2">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       StartIcon="@(brandMaster.BrandId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)"
                       Color="@(brandMaster.BrandId == 0 ? Color.Success : Color.Info)"
                       Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">@Localizer("Processing")</MudText>
                }
                else
                {
                    @Localizer(brandMaster.BrandId == 0 ? "Save" : "Update")
                }
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Color="Color.Error"
                       OnClick="Delete">
                @Localizer("Delete")
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Info"
                       OnClick="NewClick">
                @Localizer("New")
            </MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

<MudDataGrid Class="ma-2" Elevation="3"
             T="BrandMaster"
             @ref="grid"
             ServerData="LoadServerData"
             Bordered="true"
             Dense="true"
             SortMode="SortMode.Multiple"
             Filterable="true"
             RowClick="@RowClicked">

    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer("BrandList")</MudText>
        <MudSpacer />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
        <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
        <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
        <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="BrandMaster" PageSizeOptions="new int[] { 5, 10 }" />
    </PagerContent>
</MudDataGrid>
