@page "/productimport"
@using AshproSAASERP.Interface.Settings
@using AshproSAASERP.Models.DTO
@using AshproSAASERP.Shared.Helpers
@using AshproSAASERP.Shared.Services
@inject IViewService api
@inject IProductImportRepo productImportRepo
@inject Downloader downloader
@inject ISnackbar snackbar
@inject IDialogService dialogService
@inject TabService TabService

<PageTitle>@Localizer("ProductImport")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <MudPaper Elevation="3" Class="pa-4" Style="position: relative; border-radius: 12px;">
        @if (isLoading)
        {
            <MudOverlay Visible="true" DarkBackground="true" Absolute="true" Style="border-radius: 12px; z-index: 10;">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.subtitle1" Color="Color.Surface">@loadingText</MudText>
                </MudStack>
            </MudOverlay>
        }

        <!-- Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.FileUpload" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 600;">@Localizer("ProductImportTitle")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(AppData.IsArabic
                        ? "قم باستيراد المنتجات من ملف CSV، وسيتم إنشاء الفئات والوحدات والعلامات تلقائياً إذا لم تكن موجودة."
                        : "Import products from CSV. Categories, SubCategories, Brands, Units, and VAT Categories will be auto-created if missing.")
                </MudText>
            </div>
            <MudSpacer />
            <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>

        <MudDivider Class="mb-4" />

        <!-- Actions Toolbar -->
        <MudPaper Elevation="1" Class="pa-3 mb-4" Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
            <MudGrid AlignItems="Center">
                <MudItem xs="12" sm="12" md="6">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <!-- Download Sample CSV -->
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadSampleCsvAsync"
                                   Disabled="@isLoading"
                                   Size="Size.Medium">
                            @Localizer("DownloadSampleCsv")
                        </MudButton>

                        <!-- Upload CSV File Button -->
                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="OnCsvFileSelected"
                                       Accept=".csv"
                                       Hidden="true">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.UploadFile"
                                           Disabled="@isLoading"
                                           Size="Size.Medium">
                                    @Localizer("SelectCsvFile")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (parsedRows.Count > 0)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Clear"
                                       OnClick="ClearRows"
                                       Disabled="@isLoading"
                                       Size="Size.Medium">
                                @Localizer("ClearList")
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

                <MudItem xs="12" sm="12" md="6" Class="d-flex justify-md-end">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        @if (!string.IsNullOrEmpty(selectedFileName))
                        {
                            <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile" Color="Color.Default" Variant="Variant.Text">
                                @selectedFileName
                            </MudChip>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="ImportProductsAsync"
                                   Disabled="@(parsedRows.Count == 0 || isLoading)"
                                   Size="Size.Large"
                                   Style="font-weight: 600; min-width: 170px;">
                            @Localizer("ImportProducts")
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- KPI / Summary Cards -->
        @if (parsedRows.Count > 0 || importResult != null)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-3 text-center" Style="border-left: 4px solid var(--mud-palette-info); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer("TotalRows")</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight: 700;">@parsedRows.Count</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-3 text-center" Style="border-left: 4px solid var(--mud-palette-success); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(importResult != null ? Localizer("Imported") : "Ready to Import")</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">
                            @(importResult != null ? importResult.ImportedCount : parsedRows.Count(r => r.IsValid))
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-3 text-center" Style="border-left: 4px solid var(--mud-palette-warning); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer("Skipped")</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight: 700;">
                            @(importResult != null ? importResult.SkippedCount : 0)
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-3 text-center" Style="border-left: 4px solid var(--mud-palette-error); border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer("Errors")</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight: 700;">
                            @(importResult != null ? importResult.ErrorCount : parsedRows.Count(r => !r.IsValid))
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

        <!-- Import Result Alert / Messages -->
        @if (importResult != null)
        {
            <MudAlert Severity="@(importResult.IsSuccess ? Severity.Success : Severity.Warning)"
                      Variant="Variant.Filled"
                      Elevation="2"
                      Class="mb-4"
                      ShowCloseIcon="true"
                      CloseIconClicked="() => importResult = null">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@importResult.Message</MudText>
            </MudAlert>

            @if (importResult.Messages.Any())
            {
                <MudExpansionPanels Class="mb-4" Elevation="1">
                    <MudExpansionPanel Text="@(AppData.IsArabic ? "تفاصيل سجل العمليات (" + importResult.Messages.Count + ")" : "Detailed Operation Log (" + importResult.Messages.Count + ")")">
                        <MudList T="string" Dense="true" Style="max-height: 250px; overflow-y: auto;">
                            @foreach (var msg in importResult.Messages)
                            {
                                var isErr = msg.Contains("Error", StringComparison.OrdinalIgnoreCase) || msg.Contains("Skipped", StringComparison.OrdinalIgnoreCase);
                                <MudListItem Icon="@(isErr ? Icons.Material.Filled.Info : Icons.Material.Filled.CheckCircle)"
                                             IconColor="@(isErr ? Color.Warning : Color.Success)">
                                    <MudText Typo="Typo.body2">@msg</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }

        <!-- Data Preview Grid -->
        @if (parsedRows.Count > 0)
        {
            <MudPaper Elevation="2" Class="pa-3" Style="border-radius: 8px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@Localizer("ParsedProductsPreview")</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString"
                                  Placeholder="@(AppData.IsArabic ? "بحث في القائمة..." : "Search preview...")"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Small"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Clearable="true"
                                  Style="max-width: 250px;" />
                </MudStack>

                <MudDataGrid T="ProductImportRowDTO"
                             Items="@FilteredRows"
                             Bordered="true"
                             Dense="true"
                             Striped="true"
                             Hover="true"
                             Elevation="0"
                             Height="450px"
                             FixedHeader="true">
                    <Columns>
                        <PropertyColumn Property="x => x.RowNumber" Title="#" HeaderStyle="width: 50px;" />
                        <PropertyColumn Property="x => x.ProductName" Title="@Localizer("Name")">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Item.ProductName</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.ArabicName" Title="@Localizer("ArabicName")">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="direction: rtl;">@(context.Item.ArabicName ?? "-")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Barcode" Title="@Localizer("Barcode")">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @(string.IsNullOrWhiteSpace(context.Item.Barcode) ? "Auto" : context.Item.Barcode)
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Category" Title="@Localizer("Category")" />
                        <PropertyColumn Property="x => x.SubCategory" Title="@Localizer("SubCategory")" />
                        <PropertyColumn Property="x => x.Brand" Title="@Localizer("Brand")" />
                        <PropertyColumn Property="x => x.Unit" Title="@Localizer("Unit")" />
                        <PropertyColumn Property="x => x.VatCategory" Title="@Localizer("VatCategory")" />
                        <PropertyColumn Property="x => x.SalesRate" Title="@Localizer("SalesRate")">
                            <CellTemplate>
                                @(context.Item.SalesRate.HasValue ? PermanentSettingsData.FormatCurrency(context.Item.SalesRate) : "-")
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.SalesInclusiveRate" Title="@Localizer("SalesInclusiveRate")">
                            <CellTemplate>
                                @(context.Item.SalesInclusiveRate.HasValue ? PermanentSettingsData.FormatCurrency(context.Item.SalesInclusiveRate) : "-")
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.PurchaseRate" Title="@Localizer("PurchaseRate")">
                            <CellTemplate>
                                @(context.Item.PurchaseRate.HasValue ? PermanentSettingsData.FormatCurrency(context.Item.PurchaseRate) : "-")
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Status" Title="@Localizer("Status")">
                            <CellTemplate>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(context.Item.IsValid ? Color.Success : Color.Error)"
                                         Variant="Variant.Filled">
                                    @context.Item.Status
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ProductImportRowDTO" PageSizeOptions="new int[] { 25, 50, 100, 500 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        }
        else
        {
            <!-- Empty state dropzone -->
            <MudPaper Outlined="true" Class="pa-12 text-center" Style="border: 2px dashed var(--mud-palette-lines-default); border-radius: 12px; background: var(--mud-palette-background);">
                <MudFileUpload T="IBrowserFile"
                               FilesChanged="OnCsvFileSelected"
                               Accept=".csv"
                               Hidden="true"
                               Class="d-flex flex-column align-center">
                    <ActivatorContent>
                        <MudStack AlignItems="AlignItems.Center" Spacing="3" Style="cursor: pointer;">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Style="width: 72px; height: 72px;">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.h6" Style="font-weight: 600;">
                                    @(AppData.IsArabic ? "انقر هنا لاختيار ملف CSV لتحميله" : "Click here to select a CSV file to upload")
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                    @(AppData.IsArabic
                                        ? "أو حمّل النموذج المفرغ أولاً، املأ بيانات المنتجات، ثم ارفعه هنا."
                                        : "Or download the sample template first, fill in your product details, then upload it here.")
                                </MudText>
                            </div>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.FolderOpen"
                                       Size="Size.Large"
                                       Class="mt-2">
                                @Localizer("SelectCsvFile")
                            </MudButton>
                        </MudStack>
                    </ActivatorContent>
                </MudFileUpload>
            </MudPaper>
        }
    </MudPaper>
</MudContainer>
