@page "/zatcapending"
@using AshproSAASERP.Models.Zatca
@inject IViewService api
@inject ModelService Dialog
@inject IDialogService DialogService
@inject TabService TabService

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Row="true">
        <MudText Class="pa-2 ma-2" Typo="Typo.h5">@Localizer("Zatca Pending Invoices")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>
    <MudDataGrid Class="ma-2" Elevation="3" T="ZatcaInvoices" ServerData="LoadServerData" Bordered="true" Dense="true" SortMode="SortMode.Multiple">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("ZatcaPendingList")</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="UploadAll">@Localizer("UploadAll")</MudButton>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.InvoiceDate" Title=@Localizer("Invoice Date") />
            <PropertyColumn Property="x => x.InvNo" Title=@Localizer("Invoice Number") />
            <PropertyColumn Property="x => x.InvoiceIcv" Title=@Localizer("ICV No") />
            <PropertyColumn Property="x => x.InvoiceType" Title=@Localizer("Invoice Type") />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ZatcaInvoices" PageSizeOptions="new int[] { 10, 25 }" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
