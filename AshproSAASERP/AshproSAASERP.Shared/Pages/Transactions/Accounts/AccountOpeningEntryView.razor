@page "/AccountOpeningEntry"
@using AshproSAASERP.Models.Masters
@using AshproSAASERP.Models.DTO
@namespace AshproSAASERP.Shared.Pages.Transactions.Accounts

<PageTitle>@Localizer("AccountOpeningEntry")</PageTitle>
@inject TabService TabService

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Spacing="2">
        <MudStack Row="true">
            <MudText Typo="Typo.h5">@Localizer("AccountOpeningEntry")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>
        <MudOverlay Visible="_isLoading" DarkBackground="true" Absolute="true" ZIndex="9999">
            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
        </MudOverlay>

        <EditForm Model="entryDto">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudGrid Class="align-center">
                    <MudItem xs="12" md="2">
                        <MudTextField @bind-Value="entryDto.Header.VoucherNo" Label="@Localizer("VoucherNo")" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"/>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudDatePicker @bind-Date="entryDate" Label="@(Localizer("Date") + " *")" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Required="true"/>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="entryDto.Header.Remarks" Label="@Localizer("Remarks")" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500"/>
                    </MudItem>
                    
                    <!-- Quick Entry Section Integrated -->
                    @if (entryDto.Header.AccountOpeningEntryId == 0)
                    {
                        <MudItem xs="12" md="4">
                            <MudGrid Class="align-center" Spacing="1">
                                 <MudItem xs="5">
                                    <MudTextField Value="@(quickAddAccount?.Name)" Label="@Localizer("SelectAccount")" 
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="OpenQuickAddAccountDialog" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="decimal?" Value="quickAddDebit" ValueChanged="@((decimal? v) => OnQuickDebitChanged(v ?? 0))" Label="@Localizer("Debit")" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" Format="@PermanentSettingsData.CurrencyFormat" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="decimal?" Value="quickAddCredit" ValueChanged="@((decimal? v) => OnQuickCreditChanged(v ?? 0))" Label="@Localizer("Credit")" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Min="0" Format="@PermanentSettingsData.CurrencyFormat" />
                                </MudItem>
                                 <MudItem xs="1">
                                     <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="QuickAddEntry" StartIcon="@Icons.Material.Filled.Add" IconSize="Size.Small" Size="Size.Small" Style="min-width: 36px; padding: 6px;"></MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <!-- Grid: Enabled Virtualization for Performance with many accounts -->
            <!-- Grid: Virtualization disabled to ensure stable focus navigation -->
            <!-- Grid: Enabled Virtualization for Performance with many accounts -->
            <MudDataGrid T="AccountOpeningEntryDtls" Items="@entryDto.Details" 
                         Dense="true" Bordered="true" Striped="true" Elevation="0" 
                         Height="450px" FixedHeader="true" 
                         Filterable="true" 
                         EditMode="DataGridEditMode.Cell">
                <Columns>
                    <TemplateColumn Title="#" Sortable="true" Filterable="false" SortBy="@(x => entryDto.Details.IndexOf(x))">
                        <CellTemplate Context="det">
                            @(entryDto.Details.IndexOf(det.Item) + 1)
                        </CellTemplate>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="@(Localizer("Account"))" Sortable="true" Filterable="true" SortBy="@(x => x.Account.Name)">
                        <CellTemplate Context="det">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudTextField Value="@det.Item.Account.Name" 
                                              Variant="Variant.Text" 
                                              Margin="Margin.Dense" 
                                              ReadOnly="true" />
                                @if (det.Item.IsChanged)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" Title="@Localizer("Modified")" />
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="@(Localizer("Debit"))" Sortable="true" Filterable="false" CellStyle="text-align: right" SortBy="@(x => x.Debit)">
                        <HeaderTemplate Context="headerContext">
                            <div style="text-align: right; width: 100%;">@Localizer("Debit")</div>
                        </HeaderTemplate>
                        <CellTemplate Context="det">
                            <MudNumericField T="decimal" 
                                             id="@($"debit-{entryDto.Details.IndexOf(det.Item)}")" 
                                             Value="det.Item.Debit ?? 0" 
                                             ValueChanged="@((decimal v) => OnDebitChanged(det.Item, v))" 
                                             @onkeydown="@((e) => HandleKeyPress(e, det.Item, "debit"))" 
                                             Variant="Variant.Text" 
                                             Margin="Margin.Dense" 
                                             Format="@PermanentSettingsData.CurrencyFormat" 
                                             HideSpinButtons="true" 
                                             Min="0" 
                                             ReadOnly="@(entryDto.Header.AccountOpeningEntryId > 0)"
                                             Style="text-align: right" />
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="@(Localizer("Credit"))" Sortable="true" Filterable="false" CellStyle="text-align: right" SortBy="@(x => x.Credit)">
                        <HeaderTemplate Context="headerContext">
                             <div style="text-align: right; width: 100%;">@Localizer("Credit")</div>
                        </HeaderTemplate>
                        <CellTemplate Context="det">
                            <MudNumericField T="decimal" 
                                             id="@($"credit-{entryDto.Details.IndexOf(det.Item)}")" 
                                             Value="det.Item.Credit ?? 0" 
                                             ValueChanged="@((decimal v) => OnCreditChanged(det.Item, v))" 
                                             @onkeydown="@((e) => HandleKeyPress(e, det.Item, "credit"))" 
                                             Variant="Variant.Text" 
                                             Margin="Margin.Dense" 
                                             Format="@PermanentSettingsData.CurrencyFormat" 
                                             HideSpinButtons="true" 
                                             Min="0" 
                                             ReadOnly="@(entryDto.Header.AccountOpeningEntryId > 0)"
                                             Style="text-align: right" />
                        </CellTemplate>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="@Localizer("Narration")" Sortable="false" Filterable="true">
                        <CellTemplate Context="det">
                            <MudTextField id="@($"narr-{entryDto.Details.IndexOf(det.Item)}")" 
                                          @bind-Value="det.Item.Narration" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense" 
                                          ReadOnly="@(entryDto.Header.AccountOpeningEntryId > 0)"
                                          MaxLength="500" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>


            <MudPaper Class="pa-2 mb-2 mt-2" Outlined="true">
                <MudGrid Class="align-center">
                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal" Value="@(entryDto.Header.DebitTotal ?? 0)" Label="@Localizer("TotalDebit")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" ReadOnly="true" Style="font-weight: bold;" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal" Value="@(entryDto.Header.CreditTotal ?? 0)" Label="@Localizer("TotalCredit")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" ReadOnly="true" Style="font-weight: bold;" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal" Value="@((entryDto.Header.DebitTotal ?? 0) - (entryDto.Header.CreditTotal ?? 0))" Label="@Localizer("Difference")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" ReadOnly="true" Style="font-weight: bold;" />
                    </MudItem>
                    
                   @if (entryDto.Header.AccountOpeningEntryId == 0)
                   {
                       <!-- Capital Account Logic Moved Here -->
                       <MudItem xs="12" md="4">
                            <MudGrid Spacing="1" Class="align-center">
                                 <MudItem xs="8">
                                    <MudTextField Value="@(selectedCapitalAccount?.Name)" Label="@Localizer("CapitalAccount")" 
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="OpenCapitalAccountDialog" />
                                </MudItem>
                                <MudItem xs="4">
                                     <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AdjustCapitalDifference" StartIcon="@Icons.Material.Filled.AddCircle" Disabled="@(selectedCapitalAccount == null)" Size="Size.Small">
                                        @Localizer("Balance")
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                   }
                </MudGrid>
            </MudPaper>

            <MudStack Row="true" Spacing="3" Class="d-flex justify-start mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => Clear(false))" StartIcon="@Icons.Material.Filled.Add">@Localizer("New")</MudButton>
                
                @if (entryDto.Header.AccountOpeningEntryId == 0)
                {
                    <!-- Save only available for New/Master Editor Mode -->
                    <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @Localizer("Save")
                        }
                    </MudButton>
                }
            </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2 mt-0" Elevation="3">
    <MudDataGrid T="AccountOpeningEntryHdr"
                 @ref="grid"
                 ServerData="LoadServerData"
                 RowClick="@RowClicked"
                 Dense="true"
                 Bordered="true"
                 Striped="true"
                 Hover="true"
                 SortMode="SortMode.Multiple" Filterable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("AccountOpeningEntryList")</MudText>
            <MudSpacer />
            <MudTextField T="string" Value="@searchText" ValueChanged="OnSearch" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Dense="true" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.VoucherNo" Title="@Localizer("VoucherNo")" />
            <PropertyColumn Property="x => x.EntryDate" Title="@Localizer("Date")" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.DebitTotal" Title="@Localizer("TotalDebit")" Format="@PermanentSettingsData.CurrencyFormat" />
            <PropertyColumn Property="x => x.CreditTotal" Title="@Localizer("TotalCredit")" Format="@PermanentSettingsData.CurrencyFormat" />
            <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AccountOpeningEntryHdr" PageSizeOptions="new int[] { 5, 10, 20 }" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

<script>
    window.focusElement = function (id) {
        setTimeout(() => {
            const element = document.getElementById(id);
            if (element) {
                element.scrollIntoView({ behavior: "smooth", block: "center" });
                element.focus();
                if (element.select) element.select();
            }
        }, 50);
    };

    window.getElementValue = function (id) {
        const element = document.getElementById(id);
        if (!element) return "0";
        // Check if the element handles value directly or query inner input
        if (element.value !== undefined && element.tagName === 'INPUT') {
            return element.value;
        }
        const input = element.querySelector('input');
        return input ? input.value : "0";
    };
</script>
