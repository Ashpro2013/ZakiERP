@page "/materialtransferapproval"
@using AshproSAASERP.Models.Transactions.Inventory
@using AshproSAASERP.Models.Masters
@inject IViewService api
@inject NavigationManager nav
@inject ISnackbar snackbar

<PageTitle>@ArabicLocalization.Localizer("MaterialTransferApproval")</PageTitle>
@inject TabService TabService

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
   

    @* Filter Section *@
    <MudPaper Class="pa-4 mb-4" Elevation="3">
        <MudStack Row="true" Class="mb-4">
            <MudText Typo="Typo.h5" GutterBottom="true">@ArabicLocalization.Localizer("MaterialTransferApproval")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="int?" Value="@filter.BranchId" ValueChanged="OnBranchChanged" 
                           Label="@ArabicLocalization.Localizer("FilterByFromBranch")" Clearable="true" 
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    @foreach (var branch in branches)
                    {
                        <MudSelectItem Value="@((int?)branch.BranchId)">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8" Class="d-flex align-center gap-2">
                <MudTextField T="string" Value="@filter.SearchTerm" ValueChanged="OnSearchChanged" 
                              Label="@ArabicLocalization.Localizer("Search")" 
                              Placeholder="Voucher No, Reference, Amount..."
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <MudIconButton OnClick="LoadRequests" Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" Title="@ArabicLocalization.Localizer("Refresh")" />
            </MudItem>
        </MudGrid>
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="@ArabicLocalization.Localizer("Pending")" ID="@("Pending")" />
            <MudTabPanel Text="@ArabicLocalization.Localizer("Approved")" ID="@("Approved")" />
            <MudTabPanel Text="@ArabicLocalization.Localizer("Rejected")" ID="@("Rejected")" />
            <MudTabPanel Text="@ArabicLocalization.Localizer("All")" ID="@("All")" />
        </MudTabs>

        @* Data Table *@
        <MudTable Items="@requests" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isLoading" Elevation="0">
            <HeaderContent>
                <MudTh>@ArabicLocalization.Localizer("VoucherNo")</MudTh>
                <MudTh>@ArabicLocalization.Localizer("Date")</MudTh>
                <MudTh>@ArabicLocalization.Localizer("FromBrach")</MudTh>
                <MudTh>@ArabicLocalization.Localizer("ToBranch")</MudTh>
                <MudTh>@ArabicLocalization.Localizer("Status")</MudTh>
                <MudTh>@ArabicLocalization.Localizer("TotalQty")</MudTh>
                <MudTh>@ArabicLocalization.Localizer("Action")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="VoucherNo">@context.VoucherNo</MudTd>
                <MudTd DataLabel="Date">@context.VoucherDate?.ToString("dd-MM-yyyy")</MudTd>
                <MudTd DataLabel="FromBranch">@context.FromBranch?.Name</MudTd>
                <MudTd DataLabel="ToBranch">@context.ToBranch?.Name</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip Size="Size.Small" Color="@(context.Status == "Approved" ? Color.Success : context.Status == "Rejected" ? Color.Error : Color.Warning)" Value="@context.Status">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="TotalQty">@context.TotalQty</MudTd>
                <MudTd DataLabel="Action">
                    <MudButton Frozen="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OpenDetailsDialog(context.MatTransReqId))">
                        @(context.Status == "Opened" ? ArabicLocalization.Localizer("Action") : ArabicLocalization.Localizer("View"))
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>

    </MudPaper>

    @* Tabbed List *@
   
</MudContainer>
