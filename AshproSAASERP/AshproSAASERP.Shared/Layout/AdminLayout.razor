@inherits LayoutComponentBase
@inject NavigationManager navManager
@implements IDisposable

<PageTitle>@AppData.OEMAgency</PageTitle>
@if (AppData.IsLogin)
{
    <MudRTLProvider RightToLeft="@AppData.IsArabic">
        <MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
        <MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.ExtraSmall" />
        <MudPopoverProvider />
        <MudSnackbarProvider />
        <MudAppBar Elevation="25" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            <MudSpacer />
            <MudText Typo="Typo.h6">Admin Panel</MudText>
            <MudSpacer />
            <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
                <MudText Align="Align.Center" Color="@Color.Inherit">@time</MudText>
                <MudSpacer />
                <MudTooltip Text=@Localizer("Theme")>
                    <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Inherit" OnClick="DarkMode" />
                </MudTooltip>
                <MudTooltip Text=@Localizer("Full Screen")>
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Inherit" OnClick="@((e) => FullScreen())" />
                </MudTooltip>

                <MudTooltip Text=@Localizer("Close App")>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="@((e) => CloseTab())" />
                </MudTooltip>

                <MudTooltip Text="@AppData.UserName">
                    <MudIconButton Icon="@Icons.Material.Outlined.PeopleAlt" Color="Color.Inherit" OnClick="@((e) => Logout())" />
                </MudTooltip>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                <MudMenu Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Dense="true">
                    <div class="px-2">
                        <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" Color="Color.Inherit" OnClick="@((e) => RightToLeft())" />
                        <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Inherit" OnClick="DarkMode" />
                        <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Inherit" OnClick="@((e) => FullScreen())" />
                        <MudIconButton Icon="@Icons.Material.Outlined.PeopleAlt" Color="Color.Inherit" OnClick="@((e) => Logout())" />
                    </div>
                </MudMenu>
            </MudHidden>
        </MudAppBar>
        <MudDrawer @bind-Open=_drawerOpen Variant="@DrawerVariant.Responsive" Elevation="25" Class="mudblazor-appbar-band ">
            <AdminNavMenu OnNavSelection="(args) => LoadComponent(args.Item1, args.Item2, args.Item3)" />
        </MudDrawer>
        <MudMainContent>
            @* @Body *@
            <MudDynamicTabs AddTabIcon="false" KeepPanelsAlive="true" @ref="@DynamicTabs" @bind-ActivePanelIndex="@UserIndex" CloseTab="@CloseTabCallback" CloseIconToolTip="Close tab. All data will be lost" PanelClass="px-4 py-6" Elevation="4" Rounded ApplyEffectsToContainer>
                <ChildContent>
                    <MudTabPanel ID="0" Text=@Localizer("Dashboard") ShowCloseIcon="false">
                        <AshproSAASERP.Shared.Pages.Admin.AdminHomeView />
                    </MudTabPanel>
                    @foreach (var tab in UserTabs)
                    {
                        <MudTabPanel ID="@tab.Id" Text="@tab.Name" ShowCloseIcon="true">
                            <DynamicComponent Type="Type.GetType(tab.View)" />
                        </MudTabPanel>
                    }
                </ChildContent>
            </MudDynamicTabs>
            <MudScrollToTop TopOffset="400">
                <MudFab StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Color="Color.Primary" />
            </MudScrollToTop>
        </MudMainContent>
    </MudRTLProvider>
}
else
{
    <LoginView />
}

