@using MudBlazor
@using AshproSAASERP.Models.User
@inject IViewService api
@inject ISnackbar Snackbar

<MudDialog Class="change-password-dialog-root" DefaultFocus="DefaultFocus.FirstChild">
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <div class="cp-dialog-icon-badge">
                <MudIcon Icon="@Icons.Material.Rounded.LockReset" Size="Size.Medium" Style="color: #7c3aed;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.3px;">
                    @Localizer("ChangePassword")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @($"{Localizer("User")}: {AppData.UserName}")
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="cp-dialog-content-body py-2">
            @* Error Alert *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Filled"
                          Dense="true"
                          Class="mb-3"
                          CloseIconClicked="@(() => errorMessage = null)">
                    @errorMessage
                </MudAlert>
            }

            @* Success Alert *@
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Filled"
                          Dense="true"
                          Class="mb-3">
                    @successMessage
                </MudAlert>
            }

            @* Old Password Field *@
            <div class="mb-3">
                <MudTextField @bind-Value="oldPassword"
                              Label="@Localizer("OldPassword")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(showOldPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showOldPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => showOldPassword = !showOldPassword)"
                              AdornmentAriaLabel="Toggle old password visibility"
                              Disabled="@isProcessing"
                              OnKeyDown="HandleKeyDown"
                              AutoFocus="true"
                              autocomplete="current-password" />
            </div>

            @* New Password Field *@
            <div class="mb-3">
                <MudTextField @bind-Value="newPassword"
                              Label="@Localizer("NewPassword")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(showNewPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => showNewPassword = !showNewPassword)"
                              AdornmentAriaLabel="Toggle new password visibility"
                              HelperText="Minimum 6 characters"
                              Disabled="@isProcessing"
                              OnKeyDown="HandleKeyDown"
                              autocomplete="new-password" />
            </div>

            @* Confirm Password Field *@
            <div class="mb-2">
                <MudTextField @bind-Value="confirmPassword"
                              Label="@Localizer("ConfirmPassword")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(showConfirmPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => showConfirmPassword = !showConfirmPassword)"
                              AdornmentAriaLabel="Toggle confirm password visibility"
                              Disabled="@isProcessing"
                              OnKeyDown="HandleKeyDown"
                              autocomplete="new-password" />
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-end gap-2 w-100 pa-2">
            <MudButton Variant="Variant.Text"
                       OnClick="Cancel"
                       Disabled="@isProcessing"
                       Style="text-transform: none;">
                @Localizer("Cancel")
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SubmitChangePassword"
                       Disabled="@isProcessing"
                       Class="cp-save-btn"
                       StartIcon="@(isProcessing ? null : Icons.Material.Rounded.CheckCircle)">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>@Localizer("Save")</span>
                }
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    .change-password-dialog-root {
        max-width: 440px !important;
        border-radius: 16px !important;
    }

    .cp-dialog-icon-badge {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.15) 0%, rgba(6, 182, 212, 0.15) 100%);
        border: 1px solid rgba(124, 58, 237, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cp-save-btn {
        border-radius: 8px !important;
        font-weight: 600 !important;
        text-transform: none !important;
        padding: 6px 18px !important;
    }
</style>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = default!;

    private string oldPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    private bool showOldPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;

    private void Cancel()
    {
        if (!isProcessing)
        {
            MudDialog.Cancel();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitChangePassword();
        }
    }

    private async Task SubmitChangePassword()
    {
        errorMessage = null;
        successMessage = null;

        var trimmedOld = oldPassword?.Trim() ?? string.Empty;
        var trimmedNew = newPassword?.Trim() ?? string.Empty;
        var trimmedConfirm = confirmPassword?.Trim() ?? string.Empty;

        if (string.IsNullOrEmpty(trimmedOld))
        {
            errorMessage = "Please enter your current password.";
            return;
        }

        if (string.IsNullOrEmpty(trimmedNew))
        {
            errorMessage = "Please enter a new password.";
            return;
        }

        if (trimmedNew.Length < 6)
        {
            errorMessage = "New password must be at least 6 characters long.";
            return;
        }

        if (trimmedNew != trimmedConfirm)
        {
            errorMessage = "New password and confirm password do not match.";
            return;
        }

        if (trimmedOld == trimmedNew)
        {
            errorMessage = "New password cannot be the same as your current password.";
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            UserDetails? user = null;

            if (AppData.UserId.HasValue && AppData.UserId.Value > 0)
            {
                user = await api.GetUserById(AppData.UserId.Value);
            }

            if (user == null && !string.IsNullOrWhiteSpace(AppData.UserName))
            {
                var allUsers = await api.GetAllUsers();
                user = allUsers?.FirstOrDefault(u => string.Equals(u.UserName, AppData.UserName, StringComparison.OrdinalIgnoreCase));
            }

            if (user == null)
            {
                errorMessage = "Unable to find user details for the active session.";
                isProcessing = false;
                return;
            }

            if (user.PassWord != trimmedOld)
            {
                errorMessage = "The current password you entered is incorrect.";
                isProcessing = false;
                return;
            }

            user.PassWord = trimmedNew;
            var response = await api.UpdateUser(user);

            if (response == null || !string.IsNullOrEmpty(response.Message))
            {
                errorMessage = response?.Message ?? "Failed to update password. Please try again.";
                isProcessing = false;
                return;
            }

            successMessage = "Password changed successfully!";
            Snackbar.Add(Localizer("UpdateMessage") ?? "Password changed successfully!", Severity.Success);
            StateHasChanged();

            await Task.Delay(400);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            errorMessage = "Error changing password: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}
