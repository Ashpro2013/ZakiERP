@namespace AshproSAASERP.Shared.SubWindows
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<MudDialog Class="discount-dialog">
    <DialogContent>
        <div @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true" class="py-2">
            <MudNumericField @ref="_numericField"
                             T="decimal"
                             Value="@_discount"
                             ValueChanged="@OnDiscountChanged"
                             Label="Discount Amount"
                             Variant="Variant.Outlined"
                             Format="@PermanentSettingsData.CurrencyFormat"
                             HideSpinButtons="true"
                             Immediate="true"
                             Class="mt-2"
                             Min="0"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.LocalOffer" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .discount-dialog {
        min-width: 320px;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public decimal CurrentDiscount { get; set; }

    private decimal _discount;
    private MudNumericField<decimal>? _numericField;

    protected override void OnInitialized()
    {
        _discount = CurrentDiscount;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _numericField is not null)
        {
            await Task.Delay(100);
            await _numericField.FocusAsync();
            await _numericField.SelectAsync();
        }
    }

    private void OnDiscountChanged(decimal val)
    {
        _discount = val;
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(_discount));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Submit();
        }
        else if (e.Key == "Escape")
        {
            Cancel();
        }
    }
}
