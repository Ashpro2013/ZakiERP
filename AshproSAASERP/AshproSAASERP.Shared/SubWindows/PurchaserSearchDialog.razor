@using AshproSAASERP.Shared.Helpers
@using MudBlazor
@inject IViewService api

<MudDialog>
    <DialogContent>
        <MudDataGrid T="PurchaserMaster" Items="@filteredList" @ref="grid" Hover="true" Dense="true" Striped="true" Bordered="true" RowClick="RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("PurchaserList")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchText" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Dense="true" Class="mx-3" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
                <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
                <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
                <PropertyColumn Property="x => x.CreditLimit" Title="@Localizer("CreditLimit")" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="PurchaserMaster" />
            </PagerContent>
        </MudDataGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer("Cancel")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public List<PurchaserMaster> PurchaserList { get; set; } = new();

    private MudDataGrid<PurchaserMaster> grid;
    private string searchText = "";

    private IEnumerable<PurchaserMaster> filteredList =>
        string.IsNullOrWhiteSpace(searchText)
            ? PurchaserList
            : PurchaserList.Where(x => 
                (x.Code?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.NameArabic?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            );

    void RowClicked(DataGridRowClickEventArgs<PurchaserMaster> args) => Submit(args.Item);

    void Submit(PurchaserMaster item) => MudDialog.Close(DialogResult.Ok(item));
    void Cancel() => MudDialog.Cancel();
}
