@using AshproSAASERP.Models.Masters
@inject IViewService api

<MudDialog @onkeydown="OnDialogKeyDown">
    <DialogContent>

        <MudDataGrid T="BrandMaster"
                     Items="@elements"
                     @ref="grid"
                     RowClick="RowClickEvent"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     RowStyleFunc="@RowStyleFunc"
                     Striped="true">

            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("BrandList")</MudText>
                <MudSpacer />
                <MudTextField T="string" @ref="_searchRef"
                              Value="@strSearch"
                              ValueChanged="@((string s) => OnSearch(s))"
                              Immediate="true"
                              AutoFocus="true"
                              Placeholder="@Localizer("SearchBrand")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
                <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="BrandMaster" />
            </PagerContent>

        </MudDataGrid>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Secondary">@Localizer("Close")</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">@Localizer("Ok")</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter] public List<BrandMaster> brandList { get; set; }
    
    private string strSearch = "";
    private List<BrandMaster> elements = new();
    private List<BrandMaster> filteredElements = new(); // Keep track of visible items
    private MudDataGrid<BrandMaster> grid;
    private BrandMaster selectedBrand = new();
    
    private int selectedIndex = 0;
    private bool _isSubmitted = false;
    private MudTextField<string> _searchRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            if (_searchRef != null)
            {
                await _searchRef.FocusAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync() 
    { 
        if (brandList == null || !brandList.Any())
        {
            try
            {
                brandList = await api.GetAllBrand() ?? new();
            }
            catch
            {
                brandList = new();
            }
        }
        elements = brandList;
        filteredElements = elements; // Initially all
    }

    private void OnSearch(string text) 
    {
        strSearch = text;
        if (string.IsNullOrWhiteSpace(text)) 
        {
            elements = brandList ?? new();
        }
        else 
        {
            elements = (brandList ?? new()).Where(x => (x.Name?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false) || (x.Code?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
        filteredElements = elements; // Update visible list
        selectedIndex = 0; // Reset
    }

    private string RowStyleFunc(BrandMaster item, int index)
    {
        if (index == selectedIndex)
        {
            return "background-color: rgba(var(--mud-palette-primary-rgb), 0.25); cursor: pointer; font-weight: bold;";
        }
        return "cursor: pointer;";
    }

    void RowClickEvent(DataGridRowClickEventArgs<BrandMaster> args)
    {
        selectedBrand = args.Item;
        selectedIndex = filteredElements.IndexOf(args.Item);
        Submit();
    }
    void CloseDialog() { MudDialog.Cancel(); }
    void Submit() 
    {
        if (_isSubmitted) return;

        if (selectedBrand is null || selectedBrand.BrandId == 0)
        {
            if (filteredElements.Count > 0 && selectedIndex >= 0 && selectedIndex < filteredElements.Count)
            {
                selectedBrand = filteredElements[selectedIndex];
            }
        }

        if (selectedBrand is not null && selectedBrand.BrandId != 0)
        {
            _isSubmitted = true;
            MudDialog.Close(DialogResult.Ok(selectedBrand));
        }
        else 
        {
            MudDialog.Cancel();
        }
    }

    private void OnDialogKeyDown(KeyboardEventArgs e) => HandleKey(e);

    private void HandleKey(KeyboardEventArgs e) {
        if (e.Key == "ArrowDown" || e.Key == "Down")
        {
            if (selectedIndex < filteredElements.Count - 1)
            {
                selectedIndex++;
                StateHasChanged();
            }
        }
        else if (e.Key == "ArrowUp" || e.Key == "Up")
        {
            if (selectedIndex > 0)
            {
                selectedIndex--;
                StateHasChanged();
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter") 
        {
            if (filteredElements.Count > 0 && selectedIndex >= 0 && selectedIndex < filteredElements.Count)
            {
                selectedBrand = filteredElements[selectedIndex];
                Submit();
            }
        }
        else if (e.Key == "Escape")
        {
            CloseDialog();
        }
    }
}
