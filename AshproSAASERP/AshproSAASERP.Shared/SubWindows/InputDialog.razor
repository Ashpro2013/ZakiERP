@using Microsoft.AspNetCore.Components.Web

<MudDialog>
    <DialogContent>
        <div @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
            <MudTextField @ref="_textField" Margin="Margin.Dense" @bind-Value="inputtext" Label="@FormTitle" Variant="Variant.Outlined" InputType="@(IsPassword? InputType.Password: InputType.Text)" Class="mt-2" Immediate="true" />
        </div>
    </DialogContent>
    <DialogActions>
        @if (ShowCancel)
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
        }
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public bool ShowCancel { get; set; } = false;
    [Parameter] public bool IsPassword { get; set; } = false;
    [Parameter] public string FormTitle { get; set; }
    [Parameter] public string InputText { get; set; }
    string inputtext;
    MudTextField<string> _textField;
    override protected void OnInitialized()
    {
        inputtext = InputText;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _textField is not null)
        {
            await Task.Delay(100);
            await _textField.FocusAsync();
        }
    }

    void Submit() => MudDialog.Close(DialogResult.Ok(inputtext));
    void Cancel() => MudDialog.Cancel();

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Submit();
        }
    }
}
