@namespace AshproSAASERP.Shared.SubWindows
@using AshproSAASERP.Models.Others
@using AshproSAASERP.Shared.Services
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<MudDialog Class="barcode-qty-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" />
            </MudAvatar>
            <MudText Typo="Typo.h6">
                @(AppData.IsArabic ? "تحديد كمية طباعة الباركود" : "Enter Print Quantity")
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
            <!-- Item Details Card -->
            <MudCard Elevation="0" Outlined="true" Class="pa-3 mb-3" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px;">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">
                        @(AppData.IsArabic && !string.IsNullOrWhiteSpace(Item.ItemNameArabic) ? Item.ItemNameArabic : Item.ItemName)
                    </MudText>
                    @if (AppData.IsArabic && !string.IsNullOrWhiteSpace(Item.ItemNameArabic) && !string.IsNullOrWhiteSpace(Item.ItemName))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Item.ItemName
                        </MudText>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.ViewColumn" Style="font-family: monospace; font-weight: 600;">
                            @Item.Barcode
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                            @(Item.UnitName ?? "Base")
                        </MudChip>
                        @if (Item.Label == "MultiBarcode")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Style="font-size: 10px; height: 20px;">
                                MultiBarcode
                            </MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(Item.CategoryName))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                @Item.CategoryName
                            </MudChip>
                        }
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="Color.Success" Style="font-weight: 600;">
                            @(PermanentSettingsData.FormatCurrency(Item.SalesRate ?? Item.InclusiveRate ?? 0))
                        </MudText>
                    </MudStack>
                    @if (IsAlreadyInQueue)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2 py-1" Style="font-size: 12px;">
                            @(AppData.IsArabic 
                                ? $"هذا الصنف مضاف بالفعل لقائمة الطباعة بالكمية الحالية ({CurrentQuantity}). يمكنك تعديل الكمية أدناه."
                                : $"This item is already in the print queue (Current Qty: {CurrentQuantity}). You can update it below.")
                        </MudAlert>
                    }
                </MudStack>
            </MudCard>

            <!-- Quantity Input -->
            <MudNumericField @ref="_numericField"
                             T="int"
                             Value="@_quantity"
                             ValueChanged="@OnQuantityChanged"
                             Label="@(AppData.IsArabic ? "عدد الملصقات للطباعة" : "Number of Labels to Print")"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="9999"
                             Step="1"
                             Immediate="true"
                             Margin="Margin.Normal"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Print"
                             Class="mb-2" />

            <!-- Quick Preset Buttons -->
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                @(AppData.IsArabic ? "اختصارات سريعة للكمية:" : "Quick Quantity Presets:")
            </MudText>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(1))">1</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(2))">2</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(5))">5</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(10))">10</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(25))">25</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(50))">50</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => SetQuantity(100))">100</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddQuantity(1))">+1</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddQuantity(5))">+5</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddQuantity(10))">+10</MudButton>
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">
            @(AppData.IsArabic ? "إلغاء" : "Cancel")
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="Submit">
            @(AppData.IsArabic ? "إضافة للقائمة" : "Add to Queue")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .barcode-qty-dialog {
        min-width: 380px;
        max-width: 480px;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BarcodeData Item { get; set; } = default!;
    [Parameter] public int CurrentQuantity { get; set; } = 1;
    [Parameter] public bool IsAlreadyInQueue { get; set; } = false;

    private int _quantity = 1;
    private MudNumericField<int>? _numericField;

    protected override void OnInitialized()
    {
        _quantity = CurrentQuantity > 0 ? CurrentQuantity : 1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _numericField is not null)
        {
            await Task.Delay(100);
            await _numericField.FocusAsync();
            await _numericField.SelectAsync();
        }
    }

    private void OnQuantityChanged(int val)
    {
        _quantity = val > 0 ? val : 1;
    }

    private void SetQuantity(int qty)
    {
        _quantity = qty > 0 ? qty : 1;
    }

    private void AddQuantity(int delta)
    {
        _quantity = Math.Max(1, _quantity + delta);
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(_quantity > 0 ? _quantity : 1));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Submit();
        }
        else if (e.Key == "Escape")
        {
            Cancel();
        }
    }
}
