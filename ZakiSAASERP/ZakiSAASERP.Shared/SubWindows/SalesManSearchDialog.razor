@using ZakiSAASERP.Models.Masters
@inject IViewService api

<MudDialog>
    <DialogContent>

        <MudDataGrid T="SalesManMaster" @ref="grid" Items="@filteredList" RowClick="@RowClickEvent" Dense="true" Bordered="true" Hover="true" Striped="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("SalesManList")</MudText>
                <MudSpacer />
                <MudTextField Value="@strSearch" ValueChanged="@(async (string s) => { strSearch = s; await grid.ReloadServerData(); })" Placeholder="@Localizer("SearchSalesMan")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mx-3" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
                <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
                <PropertyColumn Property="x => x.Designation" Title="@Localizer("Designation")" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="SalesManMaster" PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudDataGrid>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Secondary">@Localizer("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    
    [Parameter] public List<SalesManMaster> salesManList { get; set; }

    private string strSearch = "";
    private MudDataGrid<SalesManMaster> grid;

    private IEnumerable<SalesManMaster> filteredList =>
        string.IsNullOrWhiteSpace(strSearch)
            ? salesManList
            : salesManList.Where(x => 
                (x.Code?.Contains(strSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Name?.Contains(strSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.NameArabic?.Contains(strSearch, StringComparison.OrdinalIgnoreCase) ?? false)
            );

    void RowClickEvent(DataGridRowClickEventArgs<SalesManMaster> args)
    {
        MudDialog.Close(DialogResult.Ok(args.Item));
    }

    void CloseDialog()
    {
        MudDialog.Cancel();
    }
}
