@using ZakiSAASERP.Models.Transactions.Sales
@using ZakiSAASERP.Interface.Transaction.Sales
@using MudBlazor
@inject IViewService Api

<MudDialog MaxWidth="MaxWidth.False" Style="width: 90vw; height: 80vh; overflow-y: scroll;">
    <DialogContent>
        <MudTable Items="@enquiries" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<RFQHdr,bool>(FilterFunc)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("SearchEnquiry")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@Localizer("RefNo")</MudTh>
                <MudTh>@Localizer("EntryDate")</MudTh>
                <MudTh>@Localizer("Customer")</MudTh>
                <MudTh>@Localizer("Action")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="RefNo">@context.RFQNo</MudTd>
                <MudTd DataLabel="EntryDate">@context.EntryDate?.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                <MudTd DataLabel="Action">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Submit(context))">@Localizer("Select")</MudButton>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer("Cancel")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    
    private List<RFQHdr> enquiries = new();
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
       await LoadData();
    }

    private async Task LoadData()
    {
       try {
           enquiries = await Api.GetAllEnquiries();
       }
       catch(Exception) {}
    }

    private bool FilterFunc(RFQHdr element) => FilterFunc(element, searchString);

    private bool FilterFunc(RFQHdr element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.RFQNo.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.CustomerName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    }

    private void Submit(RFQHdr item)
    {
        MudDialog.Close(DialogResult.Ok(item));
    }

    private void Cancel() => MudDialog.Cancel();
}
