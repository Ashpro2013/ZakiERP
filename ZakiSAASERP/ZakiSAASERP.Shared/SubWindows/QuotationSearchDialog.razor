@using ZakiSAASERP.Models.Services
@using MudBlazor
@inject IViewService api

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @ref="searchField"
                             Value="@searchText"
                             ValueChanged="@(async (string s) => await OnSearch(s))"
                             Label=@Localizer("Search") 
                             Placeholder=@Localizer("SearchQuotation")
                             Immediate="true"
                             Adornment="Adornment.End"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             @onkeydown="OnKeyDown"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudDataGrid T="ExMasters" 
                            ServerData="LoadServerData"
                            @ref="grid"
                            Filterable="false"
                            SortMode="SortMode.Single"
                            Hover="true"
                            Dense="true"
                            Height="400px"
                            RowStyleFunc="@RowStyleFunc"
                            RowClick="@RowClick">
                    <Columns>
                        <PropertyColumn Property="x => x.Code" Title=@Localizer("QuotationNo") />
                        <PropertyColumn Property="x => x.ExtraField" Title=@Localizer("CustomerCode") />
                        <PropertyColumn Property="x => x.Name" Title=@Localizer("CustomerName") />
                        <PropertyColumn Property="x => x.Description" Title=@Localizer("QuotationDate") />
                        <PropertyColumn Property="x => x.Amount" Title=@Localizer("Amount") Format="@PermanentSettingsData.CurrencyFormat" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ExMasters" />
                    </PagerContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Select" Disabled="@(selectedQuotation == null)">@Localizer("Select")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter] public string? InitialSearch { get; set; }

    private string searchText = "";
    private MudTextField<string> searchField;
    private MudDataGrid<ExMasters> grid;
    private List<ExMasters> quotations = new(); // Local list for keyboard nav
    private int selectedIndex = 0;
    private ExMasters? selectedQuotation;

    protected override async Task OnParametersSetAsync()
    {
        if(!string.IsNullOrEmpty(InitialSearch))
        {
             searchText = InitialSearch;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && searchField is not null)
        {
            await Task.Delay(200);
            await searchField.FocusAsync();
            await searchField.SelectAsync();
        }
    }
    
    private async Task<GridData<ExMasters>> LoadServerData(GridState<ExMasters> state)
    {
        var pagination = new PaginationModel(
            page: state.Page + 1,
            pageSize: state.PageSize,
            sortColumn: state.SortDefinitions?.FirstOrDefault()?.SortBy,
            sortDirection: state.SortDefinitions?.FirstOrDefault()?.Descending == true ? "desc" : "asc",
            search: searchText,
            BranchId: AppData.BranchId
        );
        var result = await api.GetSalesQuotationPDetails(pagination);
        quotations = result.PTransactions ?? new List<ExMasters>();
        selectedIndex = 0;
        return new GridData<ExMasters>
        {
            Items = quotations,
            TotalItems = result.TotalCount
        };
    }

    private async Task OnSearch(string text)
    {
        searchText = text;
        if(grid is not null)
            await grid.ReloadServerData();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown" || e.Key == "Down")
        {
            if (selectedIndex < quotations.Count - 1)
            {
                selectedIndex++;
                StateHasChanged();
            }
        }
        else if (e.Key == "ArrowUp" || e.Key == "Up")
        {
            if (selectedIndex > 0)
            {
                selectedIndex--;
                StateHasChanged();
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
             if (quotations.Count > 0 && selectedIndex >= 0 && selectedIndex < quotations.Count)
            {
                selectedQuotation = quotations[selectedIndex];
                Select();
            }
        }
    }
    
    private string RowStyleFunc(ExMasters item, int index)
    {
        if (index == selectedIndex)
        {
            return "background-color: rgba(var(--mud-palette-primary-rgb), 0.25); cursor: pointer; font-weight: bold;";
        }
        return "cursor: pointer;";
    }

    private void RowClick(DataGridRowClickEventArgs<ExMasters> args)
    {
        selectedQuotation = args.Item;
        Select();
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Select()
    {
        if (selectedQuotation is not null)
        {
            MudDialog.Close(DialogResult.Ok(selectedQuotation));
        }
    }
}
