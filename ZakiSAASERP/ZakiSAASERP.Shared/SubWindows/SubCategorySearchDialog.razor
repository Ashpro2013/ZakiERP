@using ZakiSAASERP.Models.Masters
@inject IViewService api

<MudDialog @onkeydown="OnDialogKeyDown">
    <DialogContent>

        <MudDataGrid T="SubCategoryMaster"
                  ServerData="LoadServerData"
                  @ref="grid"
                  RowClick="RowClickEvent"
                  Hover="true"
                  Dense="true"
                  Bordered="true"
                  RowStyleFunc="@RowStyleFunc"
                  Striped="true">

            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("SubCategoryList")</MudText>
                <MudSpacer />

                <MudTextField @ref="_searchRef"
                              Value="@strSearch"
                              ValueChanged="@(async (string s) => await OnSearch(s))"
                              Immediate="true"
                              AutoFocus="true"
                              Placeholder="@Localizer("SearchSubCategory")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
                <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
                <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="SubCategoryMaster" />
            </PagerContent>

        </MudDataGrid>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Secondary">@Localizer("Close")</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">@Localizer("Ok")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    
    [Parameter] public List<SubCategoryMaster> subCategoryList { get; set; } 
    [Parameter] public int? CategoryId { get; set; } 

    private string strSearch = "";
    private MudDataGrid<SubCategoryMaster> grid;

    private SubCategoryMaster selectedSubCategory = new();
    private List<SubCategoryMaster> pSubCategories = new();
    private int selectedIndex = 0;
    private bool _isSubmitted = false;
    private MudTextField<string> _searchRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            if (_searchRef != null)
            {
                await _searchRef.FocusAsync();
            }
        }
    }

    private async Task<GridData<SubCategoryMaster>> LoadServerData(GridState<SubCategoryMaster> state)
    {
        var pagination = new PaginationModel(
            page: state.Page + 1,
            pageSize: state.PageSize,
            sortColumn: state.SortDefinitions?.FirstOrDefault()?.SortBy,
            sortDirection: state.SortDefinitions?.FirstOrDefault()?.Descending == true ? "desc" : "asc",
            search: strSearch,
            FilterId: CategoryId
        );
        var result = await api.GetSubCategoryPDetails(pagination);
        pSubCategories = result.PSubCategories ?? new List<SubCategoryMaster>();
        selectedIndex = 0; // Reset index on load
        return new GridData<SubCategoryMaster>
        {
            Items = pSubCategories,
            TotalItems = result.TotalCount
        };
    }
    
    private string RowStyleFunc(SubCategoryMaster item, int index)
    {
        if (index == selectedIndex)
        {
            return "background-color: rgba(var(--mud-palette-primary-rgb), 0.25); cursor: pointer; font-weight: bold;";
        }
        return "cursor: pointer;";
    }

    void RowClickEvent(DataGridRowClickEventArgs<SubCategoryMaster> args)
    {
        selectedSubCategory = args.Item;
        selectedIndex = pSubCategories.IndexOf(args.Item);
        Submit();
    }

    void CloseDialog()
    {
        MudDialog.Cancel();
    }

    void Submit()
    {
        if (_isSubmitted) return;

        if (selectedSubCategory is null || selectedSubCategory.SubCategoryId == 0)
        {
            if (pSubCategories.Count > 0 && selectedIndex >= 0 && selectedIndex < pSubCategories.Count)
            {
                selectedSubCategory = pSubCategories[selectedIndex];
            }
        }

        if (selectedSubCategory is not null && selectedSubCategory.SubCategoryId != 0)
        {
            _isSubmitted = true;
            MudDialog.Close(DialogResult.Ok(selectedSubCategory));
        }
        else
        {
            MudDialog.Cancel();
        }
    }
    
    private async Task OnSearch(string text)
    {
        strSearch = text;
        if(grid is not null)
             await grid.ReloadServerData();
    }

    private void OnDialogKeyDown(KeyboardEventArgs e) => HandleKey(e);

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown" || e.Key == "Down")
        {
            if (selectedIndex < pSubCategories.Count - 1)
            {
                selectedIndex++;
                StateHasChanged();
            }
        }
        else if (e.Key == "ArrowUp" || e.Key == "Up")
        {
            if (selectedIndex > 0)
            {
                selectedIndex--;
                StateHasChanged();
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (pSubCategories.Count > 0 && selectedIndex >= 0 && selectedIndex < pSubCategories.Count)
            {
                selectedSubCategory = pSubCategories[selectedIndex];
                Submit();
            }
        }
        else if (e.Key == "Escape")
        {
            CloseDialog();
        }
    }
}
