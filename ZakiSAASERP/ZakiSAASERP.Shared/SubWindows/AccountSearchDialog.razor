@using ZakiSAASERP.Models.Masters
@using ZakiSAASERP.Shared.Services

@inject IViewService ViewService 
@inject ISnackbar Snackbar 

<MudDialog>
    <DialogContent>
        <MudTable ServerData="@(new Func<TableState, CancellationToken, Task<TableData<AccountMaster>>>(ServerReload))"
                  Dense="true" Hover="true" Bordered="true" Striped="true" @ref="table" OnRowClick="RowClickEvent" T="AccountMaster" Height="400px" FixedHeader="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("AccountList")</MudText>
                <MudSpacer />
                <MudTextField AutoFocus="true" @bind-Value="strSearch" Immediate="true" Placeholder="@Localizer("SearchAccount")"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                              Class="mt-0" OnDebounceIntervalElapsed="OnSearch" DebounceInterval="300" 
                              OnKeyDown="OnTextKeyDown" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="Code" T="AccountMaster">@Localizer("Code")</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Name" T="AccountMaster">@Localizer("Name")</MudTableSortLabel></MudTh>
                <MudTh>@Localizer("ArabicName")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Arabic Name">@context.NameArabic</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Secondary">@Localizer("Close")</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">@Localizer("Ok")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    
    // Removed [Parameter] public List<AccountMaster> accountMasters { get; set; } as it's no longer needed

    string strSearch = string.Empty;
    MudTable<AccountMaster> table;
    AccountMaster accountMaster = new();

    [Parameter] public int? FilterId { get; set; }
    
    private async Task<TableData<AccountMaster>> ServerReload(TableState state, CancellationToken token)
    {
        try
        {
            var pagination = new PaginationModel(
                state.Page + 1, 
                state.PageSize, 
                state.SortLabel, 
                state.SortDirection == SortDirection.Descending ? "desc" : "asc", 
                strSearch, 
                FilterId ?? 0, 
                AppData.BranchId
            );
            var result = await ViewService.GetAccountPDetails(pagination);
            return new TableData<AccountMaster>() { TotalItems = result.TotalCount, Items = result.PAccounts };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading accounts: {ex.Message}", Severity.Error);
            return new TableData<AccountMaster>() { TotalItems = 0, Items = new List<AccountMaster>() };
        }
    }

    private void OnSearch(string text)
    {
        strSearch = text;
        table.ReloadServerData();
    }

    void RowClickEvent(TableRowClickEventArgs<AccountMaster> args)
    {
        accountMaster = args.Item;
        Submit();
    }

    void CloseDialog()
    {
        MudDialog.Cancel();
    }

    void Submit()
    {
        MudDialog.Close(DialogResult.Ok(accountMaster));
    }

    private async Task OnTextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
           // For server-side, we typically reload data. 
           // If user wants to auto-select the first result on Enter:
           await table.ReloadServerData();
           // Logic to auto-select needs valid items from table, but table.Items might be empty until reload completes.
           // For simplicity, Enter triggers search. If user sees 1 result, they click it.
           // If we want auto-select, we'd need to inspect the loaded data.
           // However, standard pattern is Enter -> Search.
        }
    }
}
