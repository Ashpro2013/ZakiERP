<MudDialog>
    <DialogContent>
        <MudCheckBox @bind-Value="@privilegeDtl.Visible">Visible</MudCheckBox>
        <MudCheckBox @bind-Value="@privilegeDtl.SaveData">Save</MudCheckBox>
        <MudCheckBox @bind-Value="@privilegeDtl.EditData">Edit</MudCheckBox>
        <MudCheckBox @bind-Value="@privilegeDtl.DeleteData">Delete</MudCheckBox>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public ExUserPrivilege privilegeDtl { get; set; }
    void Submit() => MudDialog.Close(DialogResult.Ok(true));
}