<MudDialog>
    <DialogContent>
        <MudSwitch @bind-Value="@privilegeDtl.Visible" Label="Visible" Color="Color.Primary" />
        <MudSwitch @bind-Value="@privilegeDtl.SaveData" Label="Save" Color="Color.Success" />
        <MudSwitch @bind-Value="@privilegeDtl.EditData" Label="Edit" Color="Color.Info" />
        <MudSwitch @bind-Value="@privilegeDtl.DeleteData" Label="Delete" Color="Color.Error" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public ExUserPrivilege privilegeDtl { get; set; }
    void Submit() => MudDialog.Close(DialogResult.Ok(true));
}