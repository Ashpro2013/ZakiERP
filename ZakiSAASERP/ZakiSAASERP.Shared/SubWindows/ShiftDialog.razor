@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Terminal { get; set; } = "Terminal 1";
    [Parameter] public string UserName { get; set; } = "";

    private ShiftDetails _shift = new();
    private decimal _actualCash;
    private decimal _newOpeningBalance = 0m;
    private string _remarks = "";
    private bool _isBusy = false;

    private decimal ExpectedCash => _shift.OpeningBalance + _shift.TotalCashSales + _shift.TotalCashReceipt - _shift.TotalPayment;
    private decimal Difference => _actualCash - ExpectedCash;
    private decimal NetSales => _shift.TotalSale - _shift.TotalSalesReturn;

    private string DifferenceStatus
    {
        get
        {
            if (Difference == 0) return "Balanced";
            if (Difference > 0) return $"Overage (+{Difference:N2} SAR)";
            return $"Shortage ({Difference:N2} SAR)";
        }
    }

    private string VarianceClass
    {
        get
        {
            if (Difference == 0) return "variance-balanced";
            if (Difference > 0) return "variance-overage";
            return "variance-shortage";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isBusy = true;
        try
        {
            var user = !string.IsNullOrWhiteSpace(UserName)
                ? UserName
                : (!string.IsNullOrWhiteSpace(AppData.UserName) ? AppData.UserName : "User");

            var term = !string.IsNullOrWhiteSpace(Terminal) ? Terminal : "Terminal 1";

            _shift = await ShiftService.GetShiftDetailsAsync(term, user);
            _actualCash = ExpectedCash; // Pre-populate with expected cash
            _newOpeningBalance = 0m;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load shift details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task PrintReportAsync()
    {
        try
        {
            await ShiftService.PrintShiftDetailsAsync(_shift, AppData.CompanyDetails);
            Snackbar.Add("Shift report sent to printer.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Printing failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CloseAndChangeShiftAsync()
    {
        _isBusy = true;
        try
        {
            var user = !string.IsNullOrWhiteSpace(UserName)
                ? UserName
                : (!string.IsNullOrWhiteSpace(AppData.UserName) ? AppData.UserName : "User");
            var term = !string.IsNullOrWhiteSpace(Terminal) ? Terminal : "Terminal 1";

            // Print report first
            await ShiftService.PrintShiftDetailsAsync(_shift, AppData.CompanyDetails);

            // Save shift closing record to database
            try
            {
                var closingRecord = new ShiftClosingRecord
                {
                    ShiftCode = "SC-" + DateTime.Now.ToString("yyyyMMdd-HHmmss"),
                    UserName = user,
                    Terminal = term,
                    FK_BranchId = AppData.BranchId > 0 ? AppData.BranchId : null,
                    DateFrom = _shift.DateFrom ?? DateTime.Now,
                    DateTo = DateTime.Now,
                    OpeningBalance = _shift.OpeningBalance,
                    TotalSale = _shift.TotalSale,
                    TotalSalesReturn = _shift.TotalSalesReturn,
                    NetSales = NetSales,
                    TotalCashSales = _shift.TotalCashSales,
                    TotalCardSales = _shift.TotalCardSales,
                    TotalCreditSales = _shift.TotalCreditSales,
                    TotalPayment = _shift.TotalPayment,
                    TotalCashReceipt = _shift.TotalCashReceipt,
                    TotalCardReceipt = _shift.TotalCardReceipt,
                    ExpectedCash = ExpectedCash,
                    ActualCash = _actualCash,
                    Difference = Difference,
                    NewOpeningBalance = _newOpeningBalance,
                    Status = Difference == 0 ? "Balanced" : Difference > 0 ? "Overage" : "Shortage",
                    Remarks = _remarks,
                    CreatedAt = DateTime.Now
                };

                var saveRes = await api.SaveShiftClosingAsync(closingRecord);
                if (saveRes != null && !saveRes.IsSuccess)
                {
                    Console.WriteLine($"[ShiftDialog] SaveShiftClosingAsync: {saveRes.Message}");
                }
            }
            catch (Exception dbEx)
            {
                Console.WriteLine($"[ShiftDialog] Error saving shift closing details: {dbEx.Message}");
            }

            // Reset shift with new opening balance
            await ShiftService.ResetShiftDetailsAsync(term, user, _newOpeningBalance);

            Snackbar.Add("Shift closed and handover completed successfully.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Shift closing error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

