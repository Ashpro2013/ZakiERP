@namespace ZakiSAASERP.Shared.SubWindows
@using MudBlazor
@using ZakiSAASERP.Models.Settings
@using ZakiSAASERP.Shared.Services
@inject ShiftService ShiftService
@inject IViewService api
@inject ISnackbar Snackbar

<MudDialog Class="shift-dialog-root" DefaultFocus="DefaultFocus.None">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pa-1">
            <div class="d-flex align-center gap-3">
                <div class="shift-badge">
                    <MudIcon Icon="@Icons.Material.Filled.PunchClock" Size="Size.Medium" Style="color: #16a34a;" />
                </div>
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: #0f172a; letter-spacing: -0.3px; line-height: 1.2;">
                        Shift Reconciliation &amp; Handover
                    </MudText>
                    <div class="shift-meta-line mt-1">
                        <span class="meta-label">Cashier: </span>
                        <span class="meta-val highlight">@(string.IsNullOrWhiteSpace(_shift.UserName) ? "Cashier" : _shift.UserName)</span>
                        <span class="meta-sep"> | </span>
                        <span class="meta-label">Terminal: </span>
                        <span class="meta-val highlight">@(string.IsNullOrWhiteSpace(_shift.Terminal) ? "Terminal 1" : _shift.Terminal)</span>
                        <span class="meta-sep"> | </span>
                        <span class="meta-label">Started: </span>
                        <span class="meta-val">@(_shift.DateFrom?.ToString("dd-MM-yyyy hh:mm tt") ?? DateTime.Now.ToString("dd-MM-yyyy hh:mm tt"))</span>
                    </div>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Cancel" Style="color: #64748b;" />
        </div>
    </TitleContent>

    <DialogContent>
        <div class="shift-content-container">
            @* SECTION 1: SHIFT TRANSACTION TOTALS (3 COLUMNS) *@
            <div class="shift-section-title mb-2" style="font-size: 15px !important; font-weight: 700 !important; color: #0F172A !important; display: flex; align-items: center;">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Small" Class="mr-2" Style="color: #2563eb;" />
                Shift Transaction Totals
            </div>
            <div class="metrics-grid">
                @* Opening Cash *@
                <div class="metric-card">
                    <div class="metric-label">Opening Cash</div>
                    <div class="metric-value dark">@_shift.OpeningBalance.ToString("N2") SAR</div>
                </div>

                @* Cash Sales *@
                <div class="metric-card">
                    <div class="metric-label">Cash Sales</div>
                    <div class="metric-value text-green">@_shift.TotalCashSales.ToString("N2") SAR</div>
                </div>

                @* Card / Bank Sales *@
                <div class="metric-card">
                    <div class="metric-label">Card / Bank Sales</div>
                    <div class="metric-value text-blue">@_shift.TotalCardSales.ToString("N2") SAR</div>
                </div>

                @* Credit Sales *@
                <div class="metric-card">
                    <div class="metric-label">Credit Sales</div>
                    <div class="metric-value text-purple">@_shift.TotalCreditSales.ToString("N2") SAR</div>
                </div>

                @* Sales Returns *@
                <div class="metric-card">
                    <div class="metric-label">Sales Returns</div>
                    <div class="metric-value text-red">@_shift.TotalSalesReturn.ToString("N2") SAR</div>
                </div>

                @* Net Total Sales *@
                <div class="metric-card">
                    <div class="metric-label">Net Total Sales</div>
                    <div class="metric-value text-bold-dark">@NetSales.ToString("N2") SAR</div>
                </div>
            </div>

            @* SECTION 2: DRAWER RECONCILIATION *@
            <div class="recon-card mt-3">
                <div class="shift-section-title mb-3" style="font-size: 15px !important; font-weight: 700 !important; color: #0F172A !important; display: flex; align-items: center;">
                    <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Size="Size.Small" Class="mr-2" Style="color: #16a34a;" />
                    Cash Drawer Reconciliation
                </div>

                <div class="recon-grid">
                    @* Expected Cash in Drawer *@
                    <div class="recon-box expected">
                        <div class="recon-box-label">Expected Cash in Drawer:</div>
                        <div class="recon-box-val">@ExpectedCash.ToString("N2") SAR</div>
                        <div class="recon-box-sub">(Opening Cash + Cash Sales + Receipts - Payments)</div>
                    </div>

                    @* Counted Cash in Drawer *@
                    <div class="recon-box counted">
                        <div class="recon-box-label counted-label">Counted Cash in Drawer (SAR):</div>
                        <input type="number" step="0.01" class="counted-input"
                               @bind="_actualCash" @bind:event="oninput" />
                    </div>
                </div>

                @* Variance Status Banner *@
                <div class="variance-banner mt-3">
                    <span class="variance-title">Drawer Discrepancy / Variance:</span>
                    <span class="variance-val @VarianceClass">@DifferenceStatus</span>
                </div>

                @* Next Shift Opening Float *@
                <div class="float-row mt-3">
                    <div class="float-info">
                        <div class="float-title">Next Shift Opening Float (SAR)</div>
                        <div class="float-desc">Initial cash balance left in drawer for incoming cashier</div>
                    </div>
                    <div class="float-input-col">
                        <input type="number" step="0.01" class="float-input"
                               @bind="_newOpeningBalance" />
                    </div>
                </div>

                @* Remarks / Notes *@
                <div class="float-row mt-3">
                    <div class="float-info">
                        <div class="float-title">Remarks / Notes</div>
                        <div class="float-desc">Optional handover notes or comments</div>
                    </div>
                    <div class="float-input-col" style="flex: 1; max-width: 320px;">
                        <input type="text" class="float-input" style="width: 100% !important; font-weight: normal; font-size: 13px;"
                               placeholder="e.g. Handed over to Shift 2"
                               @bind="_remarks" />
                    </div>
                </div>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-space-between align-center w-100 pa-2">
            <button class="shift-btn shift-btn-secondary" @onclick="PrintReportAsync" disabled="@_isBusy">
                <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="mr-1" />
                Print Shift Report
            </button>

            <div class="d-flex gap-2">
                <button class="shift-btn shift-btn-cancel" @onclick="Cancel" disabled="@_isBusy">
                    Cancel
                </button>
                <button class="shift-btn shift-btn-primary" @onclick="CloseAndChangeShiftAsync" disabled="@_isBusy">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="mr-1" />
                    Close &amp; Change Shift
                </button>
            </div>
        </div>
    </DialogActions>
</MudDialog>

