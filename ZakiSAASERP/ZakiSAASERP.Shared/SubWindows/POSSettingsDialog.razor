@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public POSSettings Settings { get; set; } = new();

    private POSSettings Model { get; set; } = new();

    protected override void OnInitialized()
    {
        Model = Settings.Clone();
    }

    private void SelectAllColumns()
    {
        Model.ShowItemCode = true;
        Model.ShowBarcode = true;
        Model.ShowItemName = true;
        Model.ShowArabicName = true;
        Model.ShowUnit = true;
        Model.ShowExRate = true;
        Model.ShowIncRate = true;
        Model.ShowGross = true;
        Model.ShowDiscPercentage = true;
        Model.ShowDiscAmount = true;
        Model.ShowTaxableAmount = true;
        Model.ShowTaxPercentage = true;
        Model.ShowTaxAmount = true;
        Model.ShowAmount = true;
    }

    private void ResetDefaultColumns()
    {
        var def = new POSSettings();
        Model.ShowItemCode = def.ShowItemCode;
        Model.ShowBarcode = def.ShowBarcode;
        Model.ShowItemName = def.ShowItemName;
        Model.ShowArabicName = def.ShowArabicName;
        Model.ShowUnit = def.ShowUnit;
        Model.ShowExRate = def.ShowExRate;
        Model.ShowIncRate = def.ShowIncRate;
        Model.ShowGross = def.ShowGross;
        Model.ShowDiscPercentage = def.ShowDiscPercentage;
        Model.ShowDiscAmount = def.ShowDiscAmount;
        Model.ShowTaxableAmount = def.ShowTaxableAmount;
        Model.ShowTaxPercentage = def.ShowTaxPercentage;
        Model.ShowTaxAmount = def.ShowTaxAmount;
        Model.ShowAmount = def.ShowAmount;
    }

    private void ResetToDefaults()
    {
        Model = new POSSettings();
        Snackbar.Add("Settings reset to defaults. Click 'Save & Apply' to commit.", Severity.Info);
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
