@using ZakiSAASERP.Models.Masters
@using ZakiSAASERP.Models.Transactions
@inject IViewService api

<MudDialog>
    <DialogContent>

        <MudDataGrid T="ExMasters"
                  ServerData="LoadServerData"
                  @ref="grid"
                  MultiSelection="true"
                  @bind-SelectedItems="selectedItems"
                  Hover="true"
                  Dense="true"
                  Bordered="true"
                  Striped="true">

            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("GoodsReceiptList")</MudText>
                <MudSpacer />

                <MudTextField @ref="searchField"
                              AutoFocus="true"
                              Value="@strSearch"
                              ValueChanged="@(async (string s) => await OnSearch(s))"
                              Immediate="true"
                              Placeholder="@Localizer("SearchGoodsReceipt")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" 
                              OnKeyDown="OnTextKeyDown" />
            </ToolBarContent>

            <Columns>
                <SelectColumn T="ExMasters" />
                <PropertyColumn Property="x => x.Code" Title="@Localizer("GRNo")" />
                <PropertyColumn Property="x => x.Description" Title="@Localizer("Date")" />
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Supplier")" />
                 <PropertyColumn Property="x => x.ExtraField" Title="@Localizer("RefNo")" />
                <PropertyColumn Property="x => x.Amount" Title="@Localizer("Amount")" Format="@PermanentSettingsData.CurrencyFormat" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="ExMasters" />
            </PagerContent>

        </MudDataGrid>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Secondary">@Localizer("Close")</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">@Localizer("Ok")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    
    [Parameter] public string InitialSearch { get; set; } = "";

    private string strSearch = "";
    private MudTextField<string> searchField;
    private MudDataGrid<ExMasters> grid;
    private HashSet<ExMasters> selectedItems = new();

    protected override async Task OnParametersSetAsync()
    {
        if(!string.IsNullOrEmpty(InitialSearch))
        {
             strSearch = InitialSearch;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && searchField is not null)
        {
            await Task.Delay(200);
            await searchField.FocusAsync();
            await searchField.SelectAsync();
        }
    }

    private async Task<GridData<ExMasters>> LoadServerData(GridState<ExMasters> state)
    {
        var pagination = new PaginationModel(
            page: state.Page + 1,
            pageSize: state.PageSize,
            sortColumn: state.SortDefinitions?.FirstOrDefault()?.SortBy,
            sortDirection: state.SortDefinitions?.FirstOrDefault()?.Descending == true ? "desc" : "asc",
            search: strSearch,
            BranchId: AppData.BranchId
        );
        var result = await api.GetGoodsReceiptPDetails(pagination);
        return new GridData<ExMasters>
        {
            Items = result.PTransactions,
            TotalItems = result.TotalCount
        };
    }

    void CloseDialog()
    {
        MudDialog.Cancel();
    }

    void Submit()
    {
        if (selectedItems is not null && selectedItems.Any())
             MudDialog.Close(DialogResult.Ok(selectedItems.ToList()));
        else
             MudDialog.Close(DialogResult.Ok(new List<ExMasters>()));
    }
    
    private async Task OnSearch(string text)
    {
        strSearch = text;
        if(grid is not null)
            await grid.ReloadServerData();
    }
    
    private void OnTextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
             if(grid is not null)
                grid.ReloadServerData();
        }
    }
}
