<MudDialog>
    <DialogContent>
        <MudText>@funcDtl.EventName</MudText>
        <MudText>@funcDtl.MenuCaption</MudText>
        <MudSwitch @bind-Value="@funcDtl.Enable" Label="Enable" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public ExFuncDetails funcDtl { get; set; }
    void Submit() => MudDialog.Close(DialogResult.Ok(true));
}
