<MudDialog>
    <DialogContent>
        <MudText>@funcDtl.EventName</MudText>
        <MudText>@funcDtl.MenuCaption</MudText>
        <MudCheckBox @bind-value="@funcDtl.Enable" @bind-Checked="@funcDtl.Enable">Enable</MudCheckBox>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public ExFuncDetails funcDtl { get; set; }
    void Submit() => MudDialog.Close(DialogResult.Ok(true));
}
