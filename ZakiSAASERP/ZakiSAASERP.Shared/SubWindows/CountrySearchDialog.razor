@using ZakiSAASERP.Models.Masters
@inject IViewService api

<MudDialog>
    <DialogContent>

        <MudDataGrid T="CountryMaster"
                  ServerData="LoadServerData"
                  @ref="grid"
                  RowClick="RowClickEvent"
                  Hover="true"
                  Dense="true"
                  Bordered="true"
                  Striped="true">

            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("CountryList")</MudText>
                <MudSpacer />

                <MudTextField AutoFocus="true"
                              Value="@strSearch"
                              ValueChanged="@(async (string s) => await OnSearch(s))"
                              Immediate="true"
                              Placeholder="@Localizer("SearchCountry")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              OnKeyDown="OnTextKeyDown" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
                <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="CountryMaster" />
            </PagerContent>

        </MudDataGrid>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Color="Color.Secondary">@Localizer("Close")</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">@Localizer("Ok")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    
    [Parameter] public List<CountryMaster> countryList { get; set; }

    private string strSearch = "";
    private MudDataGrid<CountryMaster> grid;

    private CountryMaster selectedCountry = new();

    private async Task<GridData<CountryMaster>> LoadServerData(GridState<CountryMaster> state)
    {
        var pagination = new PaginationModel(
            page: state.Page + 1,
            pageSize: state.PageSize,
            sortColumn: state.SortDefinitions?.FirstOrDefault()?.SortBy,
            sortDirection: state.SortDefinitions?.FirstOrDefault()?.Descending == true ? "desc" : "asc",
            search: strSearch
        );
        var result = await api.GetCountryPDetails(pagination);
        return new GridData<CountryMaster>
        {
            Items = result.PCountries,
            TotalItems = result.TotalCount
        };
    }

    void RowClickEvent(DataGridRowClickEventArgs<CountryMaster> args)
    {
        selectedCountry = args.Item;
        Submit();
    }

    void CloseDialog()
    {
        MudDialog.Cancel();
    }

    void Submit()
    {
        if (selectedCountry is not null && selectedCountry.CountryId != 0)
             MudDialog.Close(DialogResult.Ok(selectedCountry));
        else
             MudDialog.Cancel();
    }
    
    private async Task OnSearch(string text)
    {
        strSearch = text;
        await grid.ReloadServerData();
    }

    private void OnTextKeyDown(KeyboardEventArgs e)
    {
        // Optional: Handle Enter key specific logic if needed
    }
}
