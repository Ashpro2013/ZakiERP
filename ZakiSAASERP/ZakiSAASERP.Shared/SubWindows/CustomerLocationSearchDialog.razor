@using ZakiSAASERP.Models.Masters
@using ZakiSAASERP.Shared.Helpers
@using MudBlazor
@inject IViewService api

<MudDialog>
    <DialogContent>
        <MudDataGrid T="CustomerLocationMaster" ServerData="LoadServerData" @ref="grid" Hover="true" Dense="true" Striped="true" Bordered="true" RowClick="RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("CustomerLocationSearch")</MudText>
                <MudSpacer />
                <MudTextField Value="@searchText" ValueChanged="@(async (string s) => { searchText = s; await grid.ReloadServerData(); })" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" Class="mx-3" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
                <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="CustomerLocationMaster" />
            </PagerContent>
        </MudDataGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer("Cancel")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private MudDataGrid<CustomerLocationMaster> grid;
    private string searchText = "";

    private async Task<GridData<CustomerLocationMaster>> LoadServerData(GridState<CustomerLocationMaster> state)
    {
         var pagination = new PaginationModel(
                page: state.Page + 1,
                pageSize: state.PageSize,
                sortColumn: state.SortDefinitions?.FirstOrDefault()?.SortBy,
                sortDirection: state.SortDefinitions?.FirstOrDefault()?.Descending == true ? "desc" : "asc",
                search: searchText
            );

        var result = await api.GetCustomerLocationPDetails(pagination);
        return new GridData<CustomerLocationMaster> { Items = result.PCustomerLocations, TotalItems = result.TotalCount };
    }

    void RowClicked(DataGridRowClickEventArgs<CustomerLocationMaster> args) => Submit(args.Item);

    void Submit(CustomerLocationMaster item) => MudDialog.Close(DialogResult.Ok(item));
    void Cancel() => MudDialog.Cancel();
}
