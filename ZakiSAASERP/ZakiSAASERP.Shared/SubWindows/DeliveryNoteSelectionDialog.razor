@using ZakiSAASERP.Models.DTO
@inject IViewService api

<MudDialog>
    <DialogContent>
        <MudTable T="PendingDeliveryNoteDTO" Items="@DeliveryNotes" MultiSelection="true" @bind-SelectedItems="selectedItems" Hover="true" Dense="true" FixedHeader="true" Height="400px" Filter="new Func<PendingDeliveryNoteDTO,bool>(FilterFunc1)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("Pending Delivery Notes")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Immediate="true" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@Localizer("DeliveryNoteNo")</MudTh>
                <MudTh>@Localizer("Date")</MudTh>
                <MudTh>@Localizer("Items")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="DeliveryNoteNo">@context.DeliveryNoteNo</MudTd>
                <MudTd DataLabel="Date">@context.DeliveryNoteDate?.ToString("dd-MM-yyyy")</MudTd>
                <MudTd DataLabel="Items">@context.Items.Count</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer("Cancel")</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">@Localizer("Select")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int CustomerId { get; set; }
    [Parameter] public HashSet<int> PreSelectedIds { get; set; }

    private List<PendingDeliveryNoteDTO> DeliveryNotes = new();
    private HashSet<PendingDeliveryNoteDTO> selectedItems = new();
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        DeliveryNotes = await api.GetPendingDeliveryNotes(CustomerId);
        if (PreSelectedIds is not null && PreSelectedIds.Any())
        {
            foreach (var item in DeliveryNotes.Where(x => PreSelectedIds.Contains(x.DeliveryNoteId)))
            {
                selectedItems.Add(item);
            }
        }
    }

    private bool FilterFunc1(PendingDeliveryNoteDTO element) => FilterFunc(element, searchString);

    private bool FilterFunc(PendingDeliveryNoteDTO element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.DeliveryNoteNo.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    void Submit() => MudDialog.Close(DialogResult.Ok(selectedItems));
    void Cancel() => MudDialog.Cancel();
}
