@page "/salesinvoice"
@using ZakiSAASERP.Models.Enums
@inject IViewService api
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject ModelService Dialog
@inject Downloader Downloader
@inject AppBarState appBar;
@inject IJSRuntime js
@inject TabService TabService
@inject IndexDBHelper indexdbHelper
@inject IFormFactor FormFactor
@inject ZakiSAASERP.Shared.Services.ShiftService ShiftService

<PageTitle>Zaki ERP | @Localizer("SalesInvoiceTitle")</PageTitle>


<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Row="true">
        <MudText Class="pa-2 ma-2" Typo="Typo.h5">@Localizer("SalesInvoiceTitle")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>
    <EditForm Model="@salesInvoice" OnValidSubmit="SaveOrUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Class="ma-2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1">
            <MudTabPanel Text=@Localizer("Header")>
                <MudGrid>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("InvoiceNo")</MudText>
                        <MudTextField @ref="txtInvoiceNo"
                                      OnKeyDown="@(e => Keydown(e, 1))"
                                      @bind-Value="salesInvoice.SalesInvoiceNo"
                                      Variant="Variant.Outlined"
                                      Class="w-100" Margin="Margin.Dense"
                                      ReadOnly="IsAutoCode && salesInvoice.SalesInvoiceId == 0"
                                      Adornment="IsAutoCode? Adornment.End: Adornment.None"
                                      AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                                      AdornmentColor="Color.Secondary" />
                        <ValidationMessage For="@(() => salesInvoice.SalesInvoiceNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("InvoiceDate")</MudText>
                        <MudDatePicker @ref="txtInvoiceDate" @bind-Date="salesInvoice.SalesInvoiceDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                        <ValidationMessage For="@(() => salesInvoice.SalesInvoiceDate)" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("Customer")</MudText>
                        <MudStack Row>
                            <MudTextField @ref="txtCustomer" OnKeyDown="@(e => Keydown(e, 2))" @bind-Value="salesInvoice.CustomerName" Variant="Variant.Outlined"
                                          Class="w-100" Margin="Margin.Dense" Clearable="true" Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="PartySearchMethod" />
                            <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="CreatePartyMethod" />
                        </MudStack>
                        <ValidationMessage For="@(() => salesInvoice.CustomerName)" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("QuotationNo")</MudText>
                        <MudTextField @bind-Value="sQuotationNo"
                                      Placeholder="@Localizer("Search Sales Quotation")"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick="SearchSalesQuotationAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("DeliveryNote")</MudText>
                        <MudTextField @bind-Value="sDeliveryNoteNo"
                                      Placeholder="@Localizer("Search Delivery Note")"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick="SearchDeliveryNotesAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("ReferenceNo")</MudText>
                        <MudTextField @ref="txtRefNo" OnKeyDown="@(e => Keydown(e, 3))" @bind-Value="salesInvoice.RefNo" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("SalesMan")</MudText>
                        <MudStack Row>
                            <MudSelect T="int" @ref="cmbSalesMan" @bind-Value="salesInvoice.FK_SalesManId" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var sman in salesmanList)
                                {
                                    <MudSelectItem T="int" Value="@sman.Id">@sman.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="CreateSManMethod" />
                        </MudStack>
                        <ValidationMessage For="@(() => salesInvoice.FK_SalesManId)" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("Remarks")</MudText>
                        <MudTextField @ref="txtRemarks" OnKeyDown="@(e => Keydown(e, 4))" @bind-Value="salesInvoice.Remarks" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudRadioGroup @bind-Value="salesInvoice.BillType">
                            <MudRadio Value="@("Cash")" Color="Color.Primary">Cash</MudRadio>
                            <MudRadio Value="@("Bank")" Color="Color.Tertiary">Bank</MudRadio>
                            <MudRadio Value="@("Credit")" Color="Color.Secondary">Credit</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                </MudGrid>

                <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText>@Localizer("AdditionalDiscPer")</MudText>
                            <MudNumericField @ref="txtAdditional" @bind-Value="salesInvoice.AdditionalDiscPertge" Format="N2" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(e => DiscountMethod(e, 1))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("AdditionalDiscount")</MudText>
                            <MudNumericField @ref="txtAdditionalDisc" @bind-Value="salesInvoice.AdditionalDiscAmnt" Format="@strCurencyFormat" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(e => DiscountMethod(e, 2))" />
                        </MudItem>
                    </MudGrid>
                </MudHidden>
            </MudTabPanel>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudTabPanel Text=@Localizer("Details")>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText>@Localizer("Barcode")</MudText>
                            <MudTextField AutoFocus=true @ref="txtBarcode" Immediate="true" @bind-Value="transaction.Barcode" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged(""))" />
                                           
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("ProductName") </MudText>
                            <MudTextField Immediate="true" @bind-Value="transaction.ItemName" Variant="Variant.Outlined" Margin="Margin.Dense"  />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Quantity")</MudText>
                            <MudNumericField @bind-Value="transaction.Quantity" HideSpinButtons="true" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Unit")</MudText>
                            <MudSelect Value="transaction.FK_UnitId" ValueChanged="OnChangeUnit" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var item in itemUnitlist)
                                {
                                    <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (gridSettings.ShowExRate)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("Rate") (Ex)</MudText>
                                <MudNumericField @bind-Value="transaction.ExRate" ReadOnly="@(!gridSettings.AllowEditExcRate)" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(() => OnRowRateChanged(transaction))" />
                            </MudItem>
                        }
                        @if (gridSettings.ShowIncRate)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("IncRate")</MudText>
                                <MudNumericField @bind-Value="transaction.InRate" ReadOnly="@(!gridSettings.AllowEditIncRate)" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(() => OnRowIncRateChanged(transaction))" />
                            </MudItem>
                        }
                        <div class="d-flex justify-end">
                            <MudItem Class="fixed">
                                <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Large" OnClick="AddLineItem" Label="Add" />
                            </MudItem>
                        </div>
                        @if (gridSettings.ShowGross)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("GrossAmount")</MudText>
                                <MudNumericField @bind-Value="transaction.GrossAmount" ReadOnly="true" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        }
                        @if (gridSettings.ShowDiscPercentage)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("Discount") %</MudText>
                                <MudNumericField @bind-Value="transaction.DiscountPerc" ReadOnly="@(!gridSettings.AllowEditDiscPer)" HideSpinButtons="true" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(() => OnRowDiscountPercChanged(transaction))" />
                            </MudItem>
                        }
                        @if (gridSettings.ShowDiscAmount)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("DiscAmount")</MudText>
                                <MudNumericField @bind-Value="transaction.DiscountAmnt" ReadOnly="@(!gridSettings.AllowEditDiscAmount)" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(() => OnRowDiscountAmountChanged(transaction))" />
                            </MudItem>
                        }
                        @if (gridSettings.ShowTaxableAmount)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("TaxableAmount")</MudText>
                                <MudNumericField @bind-Value="transaction.TaxableAmnt" ReadOnly="true" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        }
                        @if (gridSettings.ShowTaxAmount)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("Tax") </MudText>
                                <MudNumericField @bind-Value="transaction.TaxAmount" Format="@strCurencyFormat" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                            </MudItem>
                        }
                        @if (gridSettings.ShowAmount)
                        {
                            <MudItem xs="12">
                                <MudText>@Localizer("Total") </MudText>
                                <MudNumericField @bind-Value="transaction.LineTotal" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudTabPanel Text=@Localizer("Additional")>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("AdditionalDiscPer")</MudText>
                            <MudNumericField @ref="txtAdditional" onBlur="@(e => DiscountMethod(e, 1))" Format="N2" OnKeyDown="@(e => Keydown(e, 5))" @bind-Value="salesInvoice.AdditionalDiscPertge" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("AdditionalDiscount") </MudText>
                            <MudNumericField @ref="txtAdditionalDisc" onBlur="@(e => DiscountMethod(e, 2))" Format="@strCurencyFormat" OnKeyDown="@(e => Keydown(e, 6))" @bind-Value="salesInvoice.AdditionalDiscAmnt" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("Project")</MudText>
                            <MudSelect T="int?" @ref="cmbProject" @bind-Value="salesInvoice.FK_ProjectId" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var project in projectList)
                                {
                                    <MudSelectItem T="int?" Value="@project.Id">@project.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem>
                            <MudRadioGroup @bind-Value="salesInvoice.AdditionalDiscountType">
                                <MudRadio Value="1" Color="Color.Primary">On Ex Amount</MudRadio>
                                <MudRadio Value="2" Color="Color.Tertiary">On Inc Amount</MudRadio>
                                <MudRadio Value="3" Color="Color.Secondary">Round</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudHidden>
        </MudTabs>

        @* Action*@

        <MudGrid>
            <MudItem xs="6" sm="2">
                <MudText>@Localizer("GrossAmount")</MudText>
                <MudText>@salesInvoice.GrossAmount.ToString(strCurencyFormat)</MudText>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudText>@Localizer("DiscountAmount") </MudText>
                <MudText>@salesInvoice.LineDsicount.ToString(strCurencyFormat)</MudText>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudText>@Localizer("TaxAmount") </MudText>
                <MudText>@salesInvoice.TaxTotal.ToString(strCurencyFormat) </MudText>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudText>@Localizer("NetAmount") </MudText>
                <MudText>@salesInvoice.NetAmount.ToString(strCurencyFormat) </MudText>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudText>@Localizer("GrandTotal") </MudText>
                <MudText>@salesInvoice.GrandTotal.ToString(strCurencyFormat) </MudText>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudCheckBox @bind-Value="IsSymplified" Color="Color.Secondary">@Localizer("Simplified Tax")</MudCheckBox>
            </MudItem>
        </MudGrid>
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@(_isSaving || (salesInvoice.SalesInvoiceId != 0 && !gridSettings.EnableUpdate))">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@Localizer("Processing")</MudText>
                    }
                    else
                    {
                        @Localizer(salesInvoice.SalesInvoiceId != 0 ? "Update" : "Save")
                    }
                </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Cancel" Disabled="@(!gridSettings.EnableCancel || salesInvoice.SalesInvoiceId == 0)">@Localizer("Cancel") </MudButton>
                <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pause" Color="Color.Warning" OnClick="HoldBillClick">
    @Localizer("Hold")
    <span class="ms-1 px-1 rounded-pill" style="background-color: @(heldInvoicesCount > 0 ? "#dc2626" : "rgba(0,0,0,0.25)"); color: #ffffff; font-weight: bold; font-size: 0.8rem; min-width: 18px; text-align: center; display: inline-block;">@heldInvoicesCount</span>
</MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Secondary" OnClick="RetrieveBillClick">@Localizer("Retrieve") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" Disabled="@DisablePrintButton" OnClick="PrintMethod">@Localizer("Print") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Warning" Disabled="@DisablePrintButton" OnClick="PDFMethod">@Localizer("PDF") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DocumentScanner" Color="Color.Tertiary" Disabled="@DisablePrintButton" OnClick="PrintPrviewMethod">@Localizer("Preview") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchMethod">@Localizer("Search") </MudButton>
            </MudStack>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudStack Row="true" Spacing="1" Class=" ma-2">
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@(_isSaving || (salesInvoice.SalesInvoiceId != 0 && !gridSettings.EnableUpdate))">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@Localizer("Processing")</MudText>
                    }
                    else
                    {
                        @Localizer(salesInvoice.SalesInvoiceId != 0 ? "Update" : "Save")
                    }
                </MudButton>
                <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pause" Color="Color.Warning" OnClick="HoldBillClick">
    @Localizer("Hold")
    <span class="ms-1 px-1 rounded-pill" style="background-color: @(heldInvoicesCount > 0 ? "#dc2626" : "rgba(0,0,0,0.25)"); color: #ffffff; font-weight: bold; font-size: 0.8rem; min-width: 18px; text-align: center; display: inline-block;">@heldInvoicesCount</span>
</MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Secondary" OnClick="RetrieveBillClick">@Localizer("Retrieve") </MudButton>
            </MudStack>
            <MudStack Row="true" Spacing="1" Class=" ma-2">
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" Disabled="@DisablePrintButton" OnClick="PrintMethod">@Localizer("Print") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DocumentScanner" Color="Color.Warning" Disabled="@DisablePrintButton" OnClick="PrintPrviewMethod">@Localizer("Preview") </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchMethod">@Localizer("Search") </MudButton>
            </MudStack>
        </MudHidden>

        @* End Action*@
    </EditForm>
    @* Desktop Table*@
    <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
        <MudTable Class="ma-2" Elevation="3" Items="@entTransactions" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="400PX" OnRowClick="RowClickEvent" T="TransactionDtls">
            <HeaderContent>
                <MudTh Style="width: 45px;">@Localizer("SL")</MudTh>
                @if (gridSettings.ShowItemCode)
                {
                    <MudTh>@Localizer("ItemCode")</MudTh>
                }
                @if (gridSettings.ShowBarcode)
                {
                    <MudTh>@Localizer("Barcode")</MudTh>
                }
                @if (gridSettings.ShowItemName)
                {
                    <MudTh>@Localizer("ProductName")</MudTh>
                }
                @if (gridSettings.ShowArabicName)
                {
                    <MudTh>@Localizer("ArabicName")</MudTh>
                }
                <MudTh>@Localizer("Store")</MudTh>
                <MudTh>@Localizer("Quantity")</MudTh>
                @if (gridSettings.ShowUnit)
                {
                    <MudTh>@Localizer("Unit")</MudTh>
                }
                @if (gridSettings.ShowExRate)
                {
                    <MudTh>@Localizer("ExRate")</MudTh>
                }
                @if (gridSettings.ShowIncRate)
                {
                    <MudTh>@Localizer("IncRate")</MudTh>
                }
                @if (gridSettings.ShowGross)
                {
                    <MudTh>@Localizer("GrossAmount")</MudTh>
                }
                @if (gridSettings.ShowDiscPercentage)
                {
                    <MudTh>@Localizer("Discount") %</MudTh>
                }
                @if (gridSettings.ShowDiscAmount)
                {
                    <MudTh>@Localizer("DiscAmount")</MudTh>
                }
                @if (gridSettings.ShowTaxableAmount)
                {
                    <MudTh>@Localizer("TaxableAmount")</MudTh>
                }
                @if (gridSettings.ShowTaxPercentage)
                {
                    <MudTh>@Localizer("Tax") %</MudTh>
                }
                @if (gridSettings.ShowTaxAmount)
                {
                    <MudTh>@Localizer("TaxAmount")</MudTh>
                }
                @if (gridSettings.ShowAmount)
                {
                    <MudTh>@Localizer("Total")</MudTh>
                }
                <MudTh Style="width: 50px;">@Localizer("Action")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="SL"><MudTextField @bind-Value="@context.SL" Disabled="true" Margin="Margin.Dense" /></MudTd>
                @if (gridSettings.ShowItemCode)
                {
                    <MudTd DataLabel="Item Code"><MudTextField @bind-Value="@context.ItemCode" ReadOnly="true" Margin="Margin.Dense" /></MudTd>
                }
                @if (gridSettings.ShowBarcode)
                {
                    <MudTd DataLabel="Barcode">
                        <MudTextField AutoFocus=true @ref="textField" Immediate="true" @bind-Value="@context.Barcode" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged(context.Barcode))"
                                      OnBlur="OnBarcodBlurEvent" OnKeyDown="OnEnterMethod" />
                    </MudTd>
                }
                @if (gridSettings.ShowItemName)
                {
                    <MudTd DataLabel="Product Name"><MudTextField Immediate="true" @bind-Value="@context.ItemName" Margin="Margin.Dense" /></MudTd>
                }
                @if (gridSettings.ShowArabicName)
                {
                    <MudTd DataLabel="Arabic Name"><MudTextField Immediate="true" @bind-Value="@context.ItemArabicName" Margin="Margin.Dense" /></MudTd>
                }
                <MudTd DataLabel="Store">
                    <MudSelect T="int" Value="@context.FK_StoreId" ValueChanged="@((int s) => context.FK_StoreId = s)" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var store in storeList.Where(x => x.FK_BranchId == AppData.BranchId || x.FK_BranchId == null))
                        {
                            <MudSelectItem Value="@store.StoreId">@store.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="Quantity">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @ref="txtQuantity" @bind-Value="@context.Quantity"
                                     Margin="Margin.Dense" OnBlur="@(() => OnRowQuantityChanged(context))" OnKeyDown="@(e => TaskOnEnterMethod(e, 2))" />
                </MudTd>
                @if (gridSettings.ShowUnit)
                {
                    <MudTd DataLabel="Unit">
                        <MudSelect Value="@context.FK_UnitId" ValueChanged="OnChangeUnit" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Margin="Margin.Dense">
                            @foreach (var item in itemUnitlist)
                            {
                                <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                }
                @if (gridSettings.ShowExRate)
                {
                    <MudTd DataLabel="Rate">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtRate" @bind-Value="@context.ExRate"
                                         ReadOnly="@(!gridSettings.AllowEditExcRate)"
                                         Margin="Margin.Dense" OnBlur="@(() => OnRowRateChanged(context))" OnKeyDown="@(e => TaskOnEnterMethod(e, 4))" />
                    </MudTd>
                }
                @if (gridSettings.ShowIncRate)
                {
                    <MudTd DataLabel="Inc. Rate">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.InRate"
                                         ReadOnly="@(!gridSettings.AllowEditIncRate)"
                                         Margin="Margin.Dense" OnBlur="@(() => OnRowIncRateChanged(context))" />
                    </MudTd>
                }
                @if (gridSettings.ShowGross)
                {
                    <MudTd DataLabel="Gross">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.GrossAmount" Margin="Margin.Dense" Style="text-align:right" />
                    </MudTd>
                }
                @if (gridSettings.ShowDiscPercentage)
                {
                    <MudTd DataLabel="Discount">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtDiscount" @bind-Value="@context.DiscountPerc"
                                         ReadOnly="@(!gridSettings.AllowEditDiscPer)"
                                         Margin="Margin.Dense" OnBlur="@(() => OnRowDiscountPercChanged(context))" OnKeyDown="@(e => TaskOnEnterMethod(e, 5))" />
                    </MudTd>
                }
                @if (gridSettings.ShowDiscAmount)
                {
                    <MudTd DataLabel="DiscAmount">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.DiscountAmnt"
                                         ReadOnly="@(!gridSettings.AllowEditDiscAmount)"
                                         Margin="Margin.Dense" OnBlur="@(() => OnRowDiscountAmountChanged(context))" OnKeyDown="@(e => TaskOnEnterMethod(e, 6))" />
                    </MudTd>
                }
                @if (gridSettings.ShowTaxableAmount)
                {
                    <MudTd DataLabel="Taxable Amount">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.TaxableAmnt" Margin="Margin.Dense" Style="text-align:right" />
                    </MudTd>
                }
                @if (gridSettings.ShowTaxPercentage)
                {
                    <MudTd DataLabel="Tax">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtTax" @bind-Value="@context.TaxPerc" Margin="Margin.Dense" OnBlur="OnBlurEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 7))" />
                    </MudTd>
                }
                @if (gridSettings.ShowTaxAmount)
                {
                    <MudTd DataLabel="TaxAmount">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.TaxAmount" ReadOnly="true" Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 8))" />
                    </MudTd>
                }
                @if (gridSettings.ShowAmount)
                {
                    <MudTd DataLabel="Net Amount">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" @ref="txtNet" @bind-Value="@context.LineTotal" Format="@strCurencyFormat" Margin="Margin.Dense" Style="text-align:right" OnKeyDown="@(e => TaskOnEnterMethod(e, 9))" />
                    </MudTd>
                }
                <MudTd DataLabel="Action"> <MudIconButton OnClick="@(() => DltTransaction(@context))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" /></MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddNewRow" Size="Size.Small" Style="white-space: nowrap;">
                        @Localizer("AddRow")
                    </MudButton>
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudHidden>
    @* End Desktop*@

    @*Mobile Datagrid*@
    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
        <MudDataGrid Class="ma-2" Elevation="3" T="TransactionDtls" Items="@entTransactions" Bordered="true" Dense="true" RowClick="@RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("ProductList")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.SL" Title=@Localizer("SL") Sortable="false" />
                @if (gridSettings.ShowItemCode)
                {
                    <PropertyColumn Property="x => x.ItemCode" Title=@Localizer("ItemCode") Sortable="false" />
                }
                @if (gridSettings.ShowBarcode)
                {
                    <PropertyColumn Property="x => x.Barcode" Title=@Localizer("Barcode") Sortable="false" />
                }
                @if (gridSettings.ShowItemName)
                {
                    <PropertyColumn Property="x => x.ItemName" Title=@Localizer("Product") />
                }
                @if (gridSettings.ShowArabicName)
                {
                    <PropertyColumn Property="x => x.ItemArabicName" Title=@Localizer("ArabicName") />
                }
                <PropertyColumn Property="x => x.Quantity.ToString(strQuantityFormat)" Title=@Localizer("Quantity") Sortable="false" />
                @if (gridSettings.ShowUnit)
                {
                    <PropertyColumn Property="x => x.UnitName" Title=@Localizer("Unit") Sortable="false" />
                }
                @if (gridSettings.ShowExRate)
                {
                    <PropertyColumn Property="x => x.ExRate.ToString(strCurencyFormat)" Title=@Localizer("ExRate") Sortable="false" />
                }
                @if (gridSettings.ShowIncRate)
                {
                    <PropertyColumn Property="x => x.InRate.ToString(strCurencyFormat)" Title=@Localizer("IncRate") Sortable="false" />
                }
                @if (gridSettings.ShowGross)
                {
                    <PropertyColumn Property="x => x.GrossAmount.ToString(strCurencyFormat)" Title=@Localizer("GrossAmount") Sortable="false" />
                }
                @if (gridSettings.ShowDiscPercentage)
                {
                    <PropertyColumn Property="x => x.DiscountPerc.ToString(strCurencyFormat)" Title=@Localizer("Discount") Sortable="false" />
                }
                @if (gridSettings.ShowDiscAmount)
                {
                    <PropertyColumn Property="x => x.DiscountAmnt.ToString(strCurencyFormat)" Title=@Localizer("DiscountAmount") Sortable="false" />
                }
                @if (gridSettings.ShowTaxableAmount)
                {
                    <PropertyColumn Property="x => x.TaxableAmnt.ToString(strCurencyFormat)" Title=@Localizer("TaxableAmount") Sortable="false" />
                }
                @if (gridSettings.ShowTaxPercentage)
                {
                    <PropertyColumn Property="x => x.TaxPerc.ToString(strCurencyFormat)" Title=@Localizer("Tax") Sortable="false" />
                }
                @if (gridSettings.ShowTaxAmount)
                {
                    <PropertyColumn Property="x => x.TaxAmount.ToString(strCurencyFormat)" Title=@Localizer("TaxAmount") Sortable="false" />
                }
                @if (gridSettings.ShowAmount)
                {
                    <PropertyColumn Property="x => x.LineTotal.ToString(strCurencyFormat)" Title=@Localizer("Total") Sortable="false" />
                }
                <TemplateColumn Title=@Localizer("Action") CellClass="d-flex justify-end" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton OnClick="@(() => DltTransaction(@context.Item))" Color="@Color.Default" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="TransactionDtls" PageSizeOptions="new int[] { 25, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudHidden>
    @* End Mobile*@
</MudPaper>

