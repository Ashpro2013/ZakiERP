@page "/pos"
@using ZakiSAASERP.Models.Enums
@using ZakiSAASERP.Models.ViewModel
@using ZakiSAASERP.Models.Transactions.Sales
@using ZakiSAASERP.Models.DTO
@using ZakiSAASERP.Models.Settings
@using ZakiSAASERP.Shared.SubWindows
@inject IViewService api
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject ModelService Dialog
@inject TabService tabService
@inject IndexDBHelper indexdbHelper
@inject IJSRuntime js
@inject AppBarState appBar
@inject ICustomerDisplayService CustomerDisplay
@inject Downloader Downloader
@inject IFormFactor formFactor
@inject POSSettingsService PosSettingsService
@inject ShiftService ShiftService
<PageTitle>Zaki ERP | POS View</PageTitle>

<div class="pos-container">
    @* --- DESKTOP POS LAYOUT --- *@
    <div class="pos-desktop-layout">
        @* --- HEADER BAR --- *@
        <div class="pos-header">
            <div class="pos-logo">
                <MudIcon Icon="@Icons.Material.Filled.Store" Class="mr-2" Color="Color.Primary" />
                <span class="logo-text">ZAKI ERP</span>
            </div>

            <div class="pos-invoice-area">
                <MudTextField T="string" @ref="txtInvoiceNo"
                              @bind-Value="salesInvoice.SalesInvoiceNo"
                              Label="@Localizer("InvoiceNo")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="posSettings.ReadonlyInvoiceNumber"
                              Adornment="IsAutoCode ? Adornment.End : Adornment.None"
                              AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                              AdornmentColor="Color.Secondary"
                              OnKeyDown="OnInvoiceNoKeyDown"
                              Class="pos-invoice-field" />
            </div>

            <div class="pos-search-area">
                <MudTextField T="string" @ref="txtBarcode" Immediate="true"
                placeholder="Barcode Search..."
                @bind-Value="_barcodeSearchQuery"
                @onclick='() => SetActiveField("BarcodeSearch")'
                OnKeyDown="OnBarcodeSearchKeyDown" />

                <button class="header-btn look-up-btn" @onclick="SearchProductLookUp">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" />
                    Look Up
                </button>
            </div>

            <div class="pos-header-actions">
                <button class="icon-circle-btn" title="Add Customer" @onclick="CreateCustomerClick">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                </button>
                <button class="icon-circle-btn" title="Add Product" @onclick="CreateProductClick">
                    <MudIcon Icon="@Icons.Material.Filled.PostAdd" Size="Size.Small" />
                </button>
                <button class="icon-circle-btn" title="Sales Report" @onclick="SalesReportClick">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" />
                </button>
                <button class="icon-circle-btn" title="Settings" @onclick="OpenSettings">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                </button>
                <button class="icon-circle-btn" title="Customer Display" @onclick="OpenCustomerDisplay">
                    <MudIcon Icon="@Icons.Material.Filled.DisplaySettings" Size="Size.Small" />
                </button>
                <button class="icon-circle-btn @(_showNumPad ? "numpad-active" : "")" title="Toggle Number Pad" @onclick="ToggleNumPad">
                    <MudIcon Icon="@(_showNumPad ? Icons.Material.Filled.Keyboard : Icons.Material.Filled.KeyboardHide)" Size="Size.Small" />
                </button>
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => tabService.CloseTab(TabId)" Size="Size.Small" />
            </div>
        </div>

        @* --- MAIN CONTENT AREA --- *@
        <div class="pos-main-body">

            @* --- LEFT SIDE: TABS, GRID, PRODUCTS --- *@
            <div class="pos-left-panel">

                @* Grid and Category Tabs Split *@
                <div class="pos-grid-section" style="@($"height: {100 - posSettings.ProductAreaHeight}%;")">

                    @* Category Vertical Tabs *@
                    @if (posSettings.ShowCategoryPanel)
                    {
                        <div class="pos-category-tabs" style="@($"width: {posSettings.CategoryPanelWidth}px; min-width: {posSettings.CategoryPanelWidth}px;")">
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                var catImg = GetCategoryImage(cat);
                                var catName = AppData.IsArabic && !string.IsNullOrEmpty(cat.NameArabic) ? cat.NameArabic : cat.Name;
                                <button class="cat-tab @(selectedCategory?.CategoryId == cat.CategoryId ? "active" : "")"
                                        style="@($"min-height: {posSettings.CategoryButtonHeight}px;")"
                                        @onclick="() => SelectCategory(cat)"
                                        title="@catName">
                                    @if (posSettings.ShowCategoryImages)
                                    {
                                        <div class="cat-tab-icon-wrap" style="@($"width: {posSettings.CategoryIconSize}px; height: {posSettings.CategoryIconSize}px;")">
                                            @if (!string.IsNullOrEmpty(catImg))
                                            {
                                                <img src="@catImg" class="cat-tab-img" alt="@cat.Name" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Category" Class="cat-icon-placeholder" Style="@($"font-size: {(int)(posSettings.CategoryIconSize * 0.65)}px !important;")" />
                                            }
                                        </div>
                                    }
                                    <span class="cat-tab-text" style="@($"font-size: {posSettings.CategoryFontSize}px;")">@catName</span>
                                </button>
                            }
                        }
                    </div>
                    }

                @* The Datagrid (MudTable) *@
                <div class="pos-table-wrapper">
                    <MudTable Items="@entTransactions"
                    Hover="true"
                    Dense="@(posSettings.GridRowDensity == "Dense")"
                    FixedHeader="true"
                    Height="100%"
                    Elevation="0"
                    Class="pos-table"
                    T="TransactionDtls"
                    OnRowClick="RowClickEvent"
                    RowClassFunc="@((x, idx) => x.SL == _selectedRow?.SL ? "selected-row-highlight" : "")">
                    <HeaderContent>
                        <MudTh Class="tbl-hdr-cell">#</MudTh>
                        @if (posSettings.ShowItemCode)
                        {
                            <MudTh Class="tbl-hdr-cell">Code</MudTh>
                        }
                        @if (posSettings.ShowBarcode)
                        {
                            <MudTh Class="tbl-hdr-cell">Barcode</MudTh>
                        }
                        @if (posSettings.ShowItemName)
                        {
                            <MudTh Class="tbl-hdr-cell">Name</MudTh>
                        }
                        @if (posSettings.ShowArabicName)
                        {
                            <MudTh Class="tbl-hdr-cell">Arabic Name</MudTh>
                        }
                        <MudTh Class="tbl-hdr-cell">Qty</MudTh>
                        @if (posSettings.ShowUnit)
                        {
                            <MudTh Class="tbl-hdr-cell">Unit</MudTh>
                        }
                        @if (posSettings.ShowExRate)
                        {
                            <MudTh Class="tbl-hdr-cell">Rate</MudTh>
                        }
                        @if (posSettings.ShowIncRate)
                        {
                            <MudTh Class="tbl-hdr-cell">Inc. Rate</MudTh>
                        }
                        @if (posSettings.ShowGross)
                        {
                            <MudTh Class="tbl-hdr-cell">Gross</MudTh>
                        }
                        @if (posSettings.ShowDiscPercentage)
                        {
                            <MudTh Class="tbl-hdr-cell">Disc (%)</MudTh>
                        }
                        @if (posSettings.ShowDiscAmount)
                        {
                            <MudTh Class="tbl-hdr-cell">Disc</MudTh>
                        }
                        @if (posSettings.ShowTaxableAmount)
                        {
                            <MudTh Class="tbl-hdr-cell">Taxable Amt</MudTh>
                        }
                        @if (posSettings.ShowTaxPercentage)
                        {
                            <MudTh Class="tbl-hdr-cell">Tax (%)</MudTh>
                        }
                        @if (posSettings.ShowTaxAmount)
                        {
                            <MudTh Class="tbl-hdr-cell">Tax</MudTh>
                        }
                        @if (posSettings.ShowAmount)
                        {
                            <MudTh Class="tbl-hdr-cell">Amount</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#" Class="tbl-cell text-center">@context.SL</MudTd>
                        @if (posSettings.ShowItemCode)
                        {
                            <MudTd DataLabel="Code" Class="tbl-cell">@context.FK_ItemId.ToString("D5")</MudTd>
                        }
                        @if (posSettings.ShowBarcode)
                        {
                            <MudTd DataLabel="Barcode" Class="tbl-cell">@context.Barcode</MudTd>
                        }
                        @if (posSettings.ShowItemName)
                        {
                            <MudTd DataLabel="Name" Class="tbl-cell font-weight-bold">@context.ItemName</MudTd>
                        }
                        @if (posSettings.ShowArabicName)
                        {
                            <MudTd DataLabel="Arabic Name" Class="tbl-cell">@context.ItemArabicName</MudTd>
                        }
                        <MudTd DataLabel="Qty"
                        Class="@($"tbl-cell text-right pos-cell-editable {(IsCellActive(context, "Qty") ? "pos-cell-active" : "")}")"
                        @onclick='() => SetActiveCell(context, "Qty")'>
                        @context.Quantity.ToString(strQuantityFormat)
                    </MudTd>
                    @if (posSettings.ShowUnit)
                    {
                        <MudTd DataLabel="Unit" Class="tbl-cell">@context.UnitName</MudTd>
                    }
                    @if (posSettings.ShowExRate)
                    {
                        <MudTd DataLabel="Rate" Class="tbl-cell text-right" @onclick='() => SetActiveCell(context, "Rate")'>
                            @if (posSettings.AllowEditExcRate)
                            {
                                <input id="@($"rate-input-{context.SL}")"
                                       type="number"
                                       step="any"
                                       class="pos-grid-input @(IsCellActive(context, "Rate") ? "pos-cell-active" : "")"
                                       @bind="context.ExRate"
                                       @bind:after="() => OnRowRateChanged(context)"
                                       title="@($"Inc. Rate: {context.InRate.ToString("F2")}")"
                                       @onfocus='() => SetActiveCell(context, "Rate")'
                                       @onkeydown="OnNumericFieldKeyDown" />
                            }
                            else
                            {
                                @context.ExRate.ToString(strCurencyFormat)
                            }
                        </MudTd>
                    }
                    @if (posSettings.ShowIncRate)
                    {
                        <MudTd DataLabel="Inc. Rate" Class="tbl-cell text-right" @onclick='() => SetActiveCell(context, "IncRate")'>
                            @if (posSettings.AllowEditIncRate)
                            {
                                <input id="@($"incrate-input-{context.SL}")"
                                       type="number"
                                       step="any"
                                       class="pos-grid-input @(IsCellActive(context, "IncRate") ? "pos-cell-active" : "")"
                                       @bind="context.InRate"
                                       @bind:after="() => OnRowIncRateChanged(context)"
                                       title="@($"Ex. Rate: {context.ExRate.ToString("F2")}")"
                                       @onfocus='() => SetActiveCell(context, "IncRate")'
                                       @onkeydown="OnNumericFieldKeyDown" />
                            }
                            else
                            {
                                @context.InRate.ToString(strCurencyFormat)
                            }
                        </MudTd>
                    }
                    @if (posSettings.ShowGross)
                    {
                        <MudTd DataLabel="Gross" Class="tbl-cell text-right">@context.GrossAmount.ToString(strCurencyFormat)</MudTd>
                    }
                    @if (posSettings.ShowDiscPercentage)
                    {
                        <MudTd DataLabel="Disc (%)" Class="tbl-cell text-right" @onclick='() => SetActiveCell(context, "Disc%")'>
                            @if (posSettings.AllowEditDiscPer)
                            {
                                <input id="@($"disc-input-{context.SL}")"
                                       type="number"
                                       step="any"
                                       class="pos-grid-input @(IsCellActive(context, "Disc%") ? "pos-cell-active" : "")"
                                       @bind="context.DiscountPerc"
                                       @bind:after="() => OnRowDiscountPercChanged(context)"
                                       @onfocus='() => SetActiveCell(context, "Disc%")'
                                       @onkeydown="OnNumericFieldKeyDown" />
                            }
                            else
                            {
                                @context.DiscountPerc.ToString("F2")
                            }
                        </MudTd>
                    }
                    @if (posSettings.ShowDiscAmount)
                    {
                        <MudTd DataLabel="Disc" Class="tbl-cell text-right" @onclick='() => SetActiveCell(context, "DiscAmt")'>
                            @if (posSettings.AllowEditDiscAmount)
                            {
                                <input id="@($"discamt-input-{context.SL}")"
                                       type="number"
                                       step="any"
                                       class="pos-grid-input @(IsCellActive(context, "DiscAmt") ? "pos-cell-active" : "")"
                                       @bind="context.DiscountAmnt"
                                       @bind:after="() => OnRowDiscountAmountChanged(context)"
                                       @onfocus='() => SetActiveCell(context, "DiscAmt")'
                                       @onkeydown="OnNumericFieldKeyDown" />
                            }
                            else
                            {
                                @context.DiscountAmnt.ToString(strCurencyFormat)
                            }
                        </MudTd>
                    }
                    @if (posSettings.ShowTaxableAmount)
                    {
                        <MudTd DataLabel="Taxable Amt" Class="tbl-cell text-right">@((context.GrossAmount - context.DiscountAmnt).ToString(strCurencyFormat))</MudTd>
                    }
                    @if (posSettings.ShowTaxPercentage)
                    {
                        <MudTd DataLabel="Tax (%)" Class="tbl-cell text-right">@context.TaxPerc.ToString(strQuantityFormat)</MudTd>
                    }
                    @if (posSettings.ShowTaxAmount)
                    {
                        <MudTd DataLabel="Tax" Class="tbl-cell text-right">@context.TaxAmount.ToString(strCurencyFormat)</MudTd>
                    }
                    @if (posSettings.ShowAmount)
                    {
                        <MudTd DataLabel="Amount" Class="tbl-cell text-right font-weight-bold total-amt-cell">@context.LineTotal.ToString(strCurencyFormat)</MudTd>
                    }
                </RowTemplate>
            </MudTable>
        </div>

        @* Vertical Action Buttons on Right side of Grid *@
        <div class="pos-grid-actions">
            <button class="grid-act-btn plus" title="Increment Qty" @onclick="IncrementSelectedQty">
                <MudIcon Icon="@Icons.Material.Filled.Add" />
            </button>
            <button class="grid-act-btn minus" title="Decrement Qty" @onclick="DecrementSelectedQty">
                <MudIcon Icon="@Icons.Material.Filled.Remove" />
            </button>
            <button class="grid-act-btn delete" title="Delete Item" @onclick="DeleteSelectedLine">
                <MudIcon Icon="@Icons.Material.Filled.Delete" />
            </button>
            <button class="grid-act-btn return" title="Return Line" @onclick="ReturnSelectedLine">
                <MudIcon Icon="@Icons.Material.Filled.Undo" />
            </button>
            <button class="grid-act-btn calc" title="Calculator" @onclick="OpenCalculatorDialog">
                <MudIcon Icon="@Icons.Material.Filled.Calculate" />
            </button>
            <button class="grid-act-btn drawer" title="Open Cash Drawer" @onclick="OpenCashDrawerClick">
                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" />
            </button>
            <button class="grid-act-btn grid-layout" title="Layout & Settings" @onclick="OpenSettings">
                <MudIcon Icon="@Icons.Material.Filled.GridView" />
            </button>
        </div>

    </div>

    @* Bottom Products Card Grid *@
    <div class="pos-products-section" style="@($"height: {posSettings.ProductAreaHeight}%; flex-grow: unset;")">
        @{
            var filteredProducts = selectedCategory == null
                ? products
                : products.Where(p => p.CategoryId == selectedCategory.CategoryId).ToList();

            var totalCount = filteredProducts?.Count ?? 0;
            var pageSize = posSettings.ProductPageSize > 0 ? posSettings.ProductPageSize : 12;
            var isPaged = posSettings.EnableProductPagination;
            var totalPages = isPaged && pageSize > 0 
                ? (int)Math.Max(1, Math.Ceiling((double)totalCount / pageSize)) 
                : 1;

            if (_productPage > totalPages) { _productPage = totalPages; }
            if (_productPage < 1) { _productPage = 1; }

            var displayProducts = (isPaged && filteredProducts != null)
                ? filteredProducts.Skip((_productPage - 1) * pageSize).Take(pageSize).ToList()
                : (filteredProducts ?? new List<ExMasters>());
        }
        @if (filteredProducts == null || !filteredProducts.Any())
        {
            <div class="no-products">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory" Style="font-size: 32px; color: #94a3b8; margin-bottom: 6px;" />
                <span>No products loaded or found.</span>
            </div>
        }
        else
        {
            <div class="pos-products-scroll-area">
                <div class="products-grid" style="@($"grid-template-columns: repeat(auto-fill, minmax({posSettings.ProductButtonWidth}px, 1fr));")">
                    @foreach (var prod in displayProducts)
                    {
                        var prodImg = GetProductImage(prod);
                        <button class="product-card @(posSettings.ShowProductImages && !string.IsNullOrEmpty(prodImg) ? "has-img" : "no-img")" 
                                style="@($"min-height: {posSettings.ProductButtonHeight}px;")"
                                @onclick="() => AddProductToBill(prod)"
                                title="@prod.Name">
                            @if (posSettings.ShowProductImages)
                            {
                                <div class="prod-card-media">
                                    @if (!string.IsNullOrEmpty(prodImg))
                                    {
                                        <img src="@prodImg" class="prod-card-img" alt="@prod.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="prod-placeholder-wrap">
                                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="prod-placeholder-icon" />
                                        </div>
                                    }
                                </div>
                            }
                            <div class="prod-card-body">
                                <span class="prod-card-name" style="@($"font-size: {posSettings.ProductFontSize}px;")">@prod.Name</span>
                                <div class="prod-card-footer">
                                    <span class="prod-card-price" style="@($"font-size: {posSettings.ProductPriceFontSize}px;")">@((prod.Amount > 0 ? prod.Amount : 0).ToString(strCurencyFormat))</span>
                                    <div class="prod-card-add" title="Add to bill">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                    </div>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </div>

            @if (isPaged && totalCount > 0)
            {
                <div class="pos-products-pagination">
                    <div class="pos-pagination-meta">
                        <span class="pos-page-info">
                            Showing @(((_productPage - 1) * pageSize) + 1) - @Math.Min(_productPage * pageSize, totalCount) of @totalCount products
                        </span>
                        @if (selectedCategory != null)
                        {
                            var catDisplayName = AppData.IsArabic && !string.IsNullOrEmpty(selectedCategory.NameArabic) ? selectedCategory.NameArabic : selectedCategory.Name;
                            <span class="pos-page-cat">(@catDisplayName)</span>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="pos-pagination-actions">
                            <MudPagination Count="@totalPages"
                                           Selected="@_productPage"
                                           SelectedChanged="OnProductPageChanged"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           ShowFirstButton="true"
                                           ShowLastButton="true"
                                           MiddleCount="3"
                                           BoundaryCount="1" />
                        </div>
                    }
                </div>
            }
        }
    </div>

    </div>

    @* --- RIGHT SIDE: BILL ACTIONS, SUMMARY, NUMPAD --- *@
    <div class="pos-right-panel">
        <div class="pos-right-panel-body">

        @* 2x5 Control Grid *@
        <div class="pos-bill-actions">
            <button class="act-btn" @onclick="NewClick" title="New Bill (F1)">
                <span class="btn-kbd">F1</span>
                <span>New Bill</span>
            </button>
            <button class="act-btn" @onclick="HoldBillClick" title="Hold Bill (F2) - @heldInvoicesCount held">
                <span class="btn-kbd">F2</span>
                <span>Hold</span>
                <span class="hold-count-badge @(heldInvoicesCount > 0 ? "has-held" : "no-held")">@heldInvoicesCount</span>
            </button>

            <button class="act-btn" @onclick="RetrieveBillClick" title="Retrieve Held Bill (F3)">
                <span class="btn-kbd">F3</span>
                <span>Retrieve</span>
            </button>
            <button class="act-btn" @onclick="ReturnBillClick" title="Return Bill (F4)">
                <span class="btn-kbd">F4</span>
                <span>Return</span>
            </button>

            <button class="act-btn" @onclick="OpenDiscountDialog" title="Discount (F5)">
                <span class="btn-kbd">F5</span>
                <span>Discount</span>
            </button>
            <button class="act-btn" @onclick="SearchCustomerClick" title="Search Customer (F6)">
                <span class="btn-kbd">F6</span>
                <span>Search Customer</span>
            </button>

            <button class="act-btn" @onclick="SearchBillClick" title="Search Bill (F7)">
                <span class="btn-kbd">F7</span>
                <span>Search Bill</span>
            </button>
            <button class="act-btn" @onclick="PrintBillClick" title="Print Bill (F8)">
                <span class="btn-kbd">F8</span>
                <span>Print</span>
            </button>

            <button class="act-btn" @onclick="PdfBillClick" title="PDF (F9)">
                <span class="btn-kbd">F9</span>
                <span>PDF</span>
            </button>
            <button class="act-btn" @onclick="OpenPaymentDialog" title="Payment (F10)">
                <span class="btn-kbd">F10</span>
                <span>Payment</span>
            </button>
        </div>

        @* Totals Summary *@
        <div class="pos-totals-summary">
            <div class="summary-row">
                <span class="summary-label">Total Qty:</span>
                <span class="summary-val">@_totalQty.ToString(strQuantityFormat)</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Sub Total:</span>
                <span class="summary-val">@salesInvoice.GrossAmount.ToString(strCurencyFormat)</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Discount:</span>
                <span class="summary-val">@(((salesInvoice.AdditionalDiscAmnt ?? 0) > 0 ? (salesInvoice.AdditionalDiscAmnt ?? 0) : salesInvoice.LineDsicount).ToString(strCurencyFormat))</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Tax:</span>
                <span class="summary-val">@salesInvoice.TaxTotal.ToString(strCurencyFormat)</span>
            </div>
            <div class="summary-row total-highlight">
                <span class="summary-label total-lbl">Total :</span>
                <span class="summary-val total-val">@salesInvoice.GrandTotal.ToString(strCurencyFormat)</span>
            </div>
        </div>

        @* Separated Number Pad Component *@
        <div class="pos-numpad-wrapper @(!_showNumPad ? "numpad-hidden" : (_forceShowNumPad ? "numpad-force-show" : ""))">
            <POSNumPad OnKeyClick="HandleNumPadKey" ButtonHeight="posSettings.NumPadButtonHeight" FontSize="posSettings.NumPadFontSize" />
        </div>

        </div>

        @* Payment Footer Buttons (Pinned at Bottom) *@
        <div class="pos-payment-actions">
            <button class="pay-btn pay-cash" @onclick="OpenPaymentDialog" title="Pay Cash (F11)">
                <span class="pay-kbd">F11</span>
                <span>Pay Cash</span>
            </button>
            <button class="pay-btn pay-card" @onclick='() => SaveInvoiceClick("Bank")' title="Pay Card (F12)">
                <span class="pay-kbd">F12</span>
                <span>Pay Card</span>
            </button>
        </div>

    </div>

    </div>

    @* --- FOOTER INFORMATIONAL BAR --- *@
    <div class="pos-footer">
        <div class="footer-info-item">Party Account : <span class="foot-highlight">@salesInvoice.CustomerName</span></div>
        <div class="footer-info-item">Sales Account : <span class="foot-highlight">SALES ACCOUNT</span></div>
        <div class="footer-info-item">Invoice No : <span class="foot-highlight">@salesInvoice.SalesInvoiceNo</span></div>
        <div class="footer-info-item">Shift No : <span class="foot-highlight">1</span></div>
        <div class="footer-spacer"></div>
        <div class="footer-time">@_currentDateTimeString</div>
    </div>
    </div>

    @* --- MOBILE RESPONSIVE POS LAYOUT --- *@
    <div class="pos-mobile-layout">
        @if (_mobileStep == 1)
        {
            @* --- MOBILE PAGE 1: CATEGORIES & PRODUCTS --- *@
            <div class="mob-header">
                <div class="mob-header-left">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Primary" Class="mr-1" />
                    <span class="mob-logo-text">ASHPRO</span>
                    <span class="mob-inv-badge" title="@Localizer("InvoiceNo")">#@salesInvoice.SalesInvoiceNo</span>
                </div>
                <div class="mob-search-box">
                    <input type="text"
                           id="mob-barcode-input"
                           class="mob-barcode-input"
                           placeholder="Scan / Search barcode..."
                           value="@_barcodeSearchQuery"
                           @oninput="OnBarcodeSearchInput"
                           @onkeydown="OnBarcodeSearchKeyDown" />
                    <button class="mob-icon-btn" @onclick="SearchProductLookUp">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                    </button>
                </div>
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => tabService.CloseTab(TabId)" Size="Size.Small" />
            </div>

            @* Small group / category buttons at the top *@
            @if (posSettings.ShowCategoryPanel)
            {
                <div class="mob-categories-scroll">
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        var catImg = GetCategoryImage(cat);
                        var catName = AppData.IsArabic && !string.IsNullOrEmpty(cat.NameArabic) ? cat.NameArabic : cat.Name;
                        <button class="mob-cat-btn @(selectedCategory?.CategoryId == cat.CategoryId ? "active" : "")"
                                @onclick="() => SelectCategory(cat)">
                            <div class="mob-cat-icon-wrap">
                                @if (!string.IsNullOrEmpty(catImg))
                                {
                                    <img src="@catImg" class="mob-cat-img" alt="@cat.Name" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="mob-cat-placeholder" />
                                }
                            </div>
                            <span>@catName</span>
                        </button>
                    }
                }
            </div>
            }

            @* Products grid with rates *@
            <div class="mob-products-container">
                @{
                    var filteredProductsMob = selectedCategory == null
                        ? products
                        : products.Where(p => p.CategoryId == selectedCategory.CategoryId).ToList();

                    var totalCountMob = filteredProductsMob?.Count ?? 0;
                    var pageSizeMob = posSettings.ProductPageSize > 0 ? posSettings.ProductPageSize : 12;
                    var isPagedMob = posSettings.EnableProductPagination;
                    var totalPagesMob = isPagedMob && pageSizeMob > 0 
                        ? (int)Math.Max(1, Math.Ceiling((double)totalCountMob / pageSizeMob)) 
                        : 1;

                    if (_productPage > totalPagesMob) { _productPage = totalPagesMob; }
                    if (_productPage < 1) { _productPage = 1; }

                    var displayProductsMob = (isPagedMob && filteredProductsMob != null)
                        ? filteredProductsMob.Skip((_productPage - 1) * pageSizeMob).Take(pageSizeMob).ToList()
                        : (filteredProductsMob ?? new List<ExMasters>());
                }
                @if (filteredProductsMob == null || !filteredProductsMob.Any())
                {
                    <div class="mob-no-products">
                        <MudIcon Icon="@Icons.Material.Outlined.Inventory" Style="font-size: 28px; color: #94a3b8; margin-bottom: 4px;" />
                        <span>No products found</span>
                    </div>
                }
                else
                {
                    <div class="mob-products-grid">
                        @foreach (var prod in displayProductsMob)
                        {
                            var prodImg = GetProductImage(prod);
                            <button class="mob-product-card" @onclick="() => AddProductToBill(prod)">
                                <div class="mob-prod-media">
                                    @if (!string.IsNullOrEmpty(prodImg))
                                    {
                                        <img src="@prodImg" class="mob-prod-img" alt="@prod.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mob-prod-placeholder" />
                                    }
                                </div>
                                <div class="mob-prod-info">
                                    <span class="mob-prod-name">@prod.Name</span>
                                    @if (!string.IsNullOrEmpty(prod.Code))
                                    {
                                        <span class="mob-prod-code">@prod.Code</span>
                                    }
                                </div>
                                <div class="mob-prod-end">
                                    <span class="mob-prod-rate">@((prod.Amount > 0 ? prod.Amount : 0).ToString(strCurencyFormat))</span>
                                    <div class="mob-prod-add">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                    </div>
                                </div>
                            </button>
                        }
                    </div>

                    @if (isPagedMob && totalCountMob > 0)
                    {
                        <div class="mob-products-pagination">
                            <span class="mob-page-info">
                                @(((_productPage - 1) * pageSizeMob) + 1)-@Math.Min(_productPage * pageSizeMob, totalCountMob) of @totalCountMob
                            </span>
                            @if (totalPagesMob > 1)
                            {
                                <div class="mob-page-btns">
                                    <button class="mob-page-nav-btn" disabled="@(_productPage <= 1)" @onclick="() => OnProductPageChanged(_productPage - 1)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                                    </button>
                                    <span class="mob-page-num">@_productPage / @totalPagesMob</span>
                                    <button class="mob-page-nav-btn" disabled="@(_productPage >= totalPagesMob)" @onclick="() => OnProductPageChanged(_productPage + 1)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @* Bottom Cart & Next button bar *@
            <div class="mob-bottom-bar">
                <div class="mob-cart-summary-btn" @onclick="() => SetMobileStep(2)">
                    <div class="mob-cart-icon-wrapper">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Medium" />
                        @if (entTransactions.Any())
                        {
                            <span class="mob-cart-badge">@((int)entTransactions.Sum(x => x.Quantity))</span>
                        }
                    </div>
                    <div class="mob-cart-text-group">
                        <span class="mob-cart-count">@entTransactions.Count Items</span>
                        <span class="mob-cart-total">@salesInvoice.GrandTotal.ToString(strCurencyFormat)</span>
                    </div>
                </div>
                <button class="mob-next-btn" disabled="@(!entTransactions.Any())" @onclick="() => SetMobileStep(2)">
                    <span>Next</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="ml-1" />
                </button>
            </div>
        }
        else
        {
            @* --- MOBILE PAGE 2: CART DETAILS & PAYMENT --- *@
            <div class="mob-header">
                <button class="mob-back-btn" @onclick="() => SetMobileStep(1)">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    <span>Back</span>
                </button>
                <div class="mob-header-title">Cart (@entTransactions.Sum(x => x.Quantity).ToString("N0") items)</div>
                <button class="mob-clear-btn" @onclick="NewClick" title="Clear Bill">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" />
                </button>
            </div>

            @* Added Products List with Rate *@
            <div class="mob-cart-list-container">
                @if (!entTransactions.Any())
                {
                    <div class="mob-empty-cart">
                        <MudIcon Icon="@Icons.Material.Filled.RemoveShoppingCart" Size="Size.Large" Color="Color.Secondary" />
                        <p>Your cart is empty</p>
                        <button class="mob-add-prod-btn" @onclick="() => SetMobileStep(1)">Add Products</button>
                    </div>
                }
                else
                {
                    <div class="mob-cart-items">
                        @foreach (var item in entTransactions)
                        {
                            <div class="mob-cart-item-card">
                                <div class="mob-cart-item-info">
                                    <div class="mob-item-name">@item.ItemName</div>
                                    <div class="mob-item-rate-unit">
                                        Rate: <span class="mob-highlight-rate">@item.ExRate.ToString(strCurencyFormat)</span> / @item.UnitName
                                    </div>
                                </div>
                                <div class="mob-cart-item-controls">
                                    <div class="mob-qty-control">
                                        <button class="mob-qty-btn" @onclick="() => DecrementQty(item)">-</button>
                                        <span class="mob-qty-val">@item.Quantity.ToString("G29")</span>
                                        <button class="mob-qty-btn" @onclick="() => IncrementQty(item)">+</button>
                                    </div>
                                    <div class="mob-item-total">
                                        @item.LineTotal.ToString(strCurencyFormat)
                                    </div>
                                    <button class="mob-item-delete" @onclick="() => RemoveItem(item)">
                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Total Amount & Financial Summary *@
            <div class="mob-summary-section">
                <div class="mob-summary-row">
                    <span>Sub Total:</span>
                    <span>@salesInvoice.GrossAmount.ToString(strCurencyFormat)</span>
                </div>
                @if ((salesInvoice.AdditionalDiscAmnt ?? 0) > 0 || salesInvoice.LineDsicount > 0)
                {
                    <div class="mob-summary-row">
                        <span>Discount:</span>
                        <span>@(((salesInvoice.AdditionalDiscAmnt ?? 0) > 0 ? (salesInvoice.AdditionalDiscAmnt ?? 0) : salesInvoice.LineDsicount).ToString(strCurencyFormat))</span>
                    </div>
                }
                <div class="mob-summary-row">
                    <span>Tax:</span>
                    <span>@salesInvoice.TaxTotal.ToString(strCurencyFormat)</span>
                </div>
                <div class="mob-summary-total-card">
                    <span class="mob-total-label">Total Amount:</span>
                    <span class="mob-total-amount">@salesInvoice.GrandTotal.ToString(strCurencyFormat)</span>
                </div>
            </div>

            @* Bottom Payment Buttons *@
            <div class="mob-payment-footer">
                <button class="mob-pay-btn mob-pay-cash" disabled="@(!entTransactions.Any() || _isSaving)" @onclick="OpenPaymentDialog">
                    Pay Cash
                </button>
                <button class="mob-pay-btn mob-pay-card" disabled="@(!entTransactions.Any() || _isSaving)" @onclick='() => SaveInvoiceClick("Bank")'>
                    Pay Card
                </button>
            </div>
        }
    </div>
</div>

