@page "/expenseentry"
@page "/expenseentry/{Id:int}"
@using ZakiSAASERP.Models.Transactions.Accounts
@using ZakiSAASERP.Models.Masters
@namespace ZakiSAASERP.Shared.Pages.Transactions.Accounts
@inject ISnackbar snackbar

<PageTitle>@Localizer("ExpenseEntry")</PageTitle>
@inject TabService TabService

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Spacing="2">
        <MudStack Row="true">
            <MudText Typo="Typo.h5">@Localizer("ExpenseEntry")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>
        <MudOverlay Visible="_isLoading" DarkBackground="true" Absolute="true" ZIndex="9999">
            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
        </MudOverlay>

        <EditForm Model="expenseDto">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudGrid>
                    @* First row: Expense info *@
                    <MudItem xs="12" md="2">
                        <MudTextField @bind-value="expenseDto.ExpenseNo" Label="@Localizer("ExpenseNo")" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"/>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudDatePicker @bind-Date="entryDate" Label="@(Localizer("EntryDate") + " *")" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Required="true" RequiredError="@Localizer("DateRequired")"/>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField id="payment-account" @bind-value="expenseDto.PaymentAccountName" Label="@(Localizer("PaymentAccount") + " *")" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@OpenPaymentAccountDialog" Immediate="true" Placeholder="@Localizer("SelectAccount")" Required="true" ReadOnly="true" RequiredError="@Localizer("PaymentAccountRequired")" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField @bind-value="expenseDto.ReferenceNo" Label="@Localizer("RefNo")" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" Placeholder="@Localizer("Optional")"/>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Value="@expenseDto.SupplierName" ValueChanged="@OnHeaderSupplierChanged" Label="@(Localizer("Supplier"))" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(async (e) => await OpenSupplierDialog())" Immediate="true" Placeholder="@Localizer("SelectSupplier")" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-value="expenseDto.VatNo" Label="@Localizer("VatNo")" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500"/>
                    </MudItem>
                    
                    @* Second row: Project + Salesman + Cheque Info *@
                    <MudItem xs="12" md="2">
                        <MudSelect T="int?" @bind-Value="expenseDto.FK_ProjectId" Label="@Localizer("Project")" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            @if (projects is not null)
                            {
                                @foreach (var project in projects)
                                {
                                    <MudSelectItem T="int?" Value="@project.ProjectId">@project.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="int?" @bind-Value="expenseDto.FK_SalesmanId" Label="@Localizer("Salesman")" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            @if (salesmen is not null)
                            {
                                @foreach (var salesman in salesmen)
                                {
                                    <MudSelectItem T="int?" Value="@salesman.SalesmanId">@salesman.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect @bind-Value="expenseDto.BillType" Label="@Localizer("BillType")" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("Cash")">@Localizer("Cash")</MudSelectItem>
                            <MudSelectItem Value="@("Credit")">@Localizer("Credit")</MudSelectItem>
                            <MudSelectItem Value="@("Card")">@Localizer("Card")</MudSelectItem>
                            <MudSelectItem Value="@("Bank")">@Localizer("Transfer")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    
                    @* Third row: Narration with full width *@
                    <MudItem xs="12">
                        <MudTextField @bind-value="expenseDto.Narration" Label="@Localizer("Narration")" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="2000" Lines="2"/>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudToolBar Dense="true" Class="pa-0 mb-2">
                    <MudText Typo="Typo.h6">@Localizer("ExpenseDetails") *</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewRow" Size="Size.Small">@Localizer("AddRow")</MudButton>
                </MudToolBar>

                <MudDataGrid T="ExpenseEntryDtls" Items="@expenseDto.ExpenseEntryDtls" Dense="true" Bordered="true" Striped="true" Elevation="0" Style="max-height: 400px; overflow-y: auto;" FixedHeader="true" EditMode="DataGridEditMode.Cell">
                    <Columns>
                        <TemplateColumn Title="#" Sortable="false">
                            <CellTemplate Context="det">
                                @(expenseDto.ExpenseEntryDtls.IndexOf(det.Item) + 1)
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="@(Localizer("ExpenseAccount") + " *")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudTextField id="@($"exp_acc-{expenseDto.ExpenseEntryDtls.IndexOf(det.Item)}")" @bind-value="det.Item.AccountName" Variant="Variant.Text" Margin="Margin.Dense" Immediate="true" Placeholder="@Localizer("SelectAccount")" OnKeyDown="@((e) => HandleKeyPress(e, det.Item, "exp_acc"))" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => OpenAccountDialog(det.Item))" Required="true" RequiredError="@Localizer("AccountRequired")" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        
                         <TemplateColumn Title="@Localizer("VAT %")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudSelect T="int?" Value="det.Item.VatId" ValueChanged="@((int? v) => { det.Item.VatId = v; CalculateVat(det.Item); })" Margin="Margin.Dense" Variant="Variant.Text" Underline="false">
                                    <MudSelectItem T="int?" Value="@(null)">@Localizer("None")</MudSelectItem>
                                    @if(vats is not null)
                                    {
                                        foreach(var v in vats)
                                        {
                                            <MudSelectItem T="int?" Value="@v.VatId">@v.Code</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="@(Localizer("Amount") + " *")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudNumericField id="@($"amount-{expenseDto.ExpenseEntryDtls.IndexOf(det.Item)}")" T="decimal" Value="det.Item.Amount" ValueChanged="@((decimal v) => { det.Item.Amount = v; CalculateVat(det.Item); })" Variant="Variant.Text" Margin="Margin.Dense" Format="N3" HideSpinButtons="true" Min="0" Disabled="@(det.Item.FK_AccountId == 0)" OnKeyDown="@((e) => HandleKeyPress(e, det.Item, "amount"))" Required="true" RequiredError="@Localizer("AmountRequired")" />
                            </CellTemplate>
                        </TemplateColumn>
                        
                        <TemplateColumn Title="@Localizer("VATAmount")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudNumericField T="decimal" Value="det.Item.VatAmt" Variant="Variant.Text" Margin="Margin.Dense" Format="N3" HideSpinButtons="true" ReadOnly="true" />
                            </CellTemplate>
                        </TemplateColumn>
                        
                         <TemplateColumn Title="@Localizer("IncAmount")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudNumericField T="decimal" Value="det.Item.IncAmt" Variant="Variant.Text" Margin="Margin.Dense" Format="N3" HideSpinButtons="true" ReadOnly="true" />
                            </CellTemplate>
                        </TemplateColumn>
                        
                        <TemplateColumn Title="@Localizer("InvoiceNo")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudTextField id="@($"invno-{expenseDto.ExpenseEntryDtls.IndexOf(det.Item)}")" @bind-Value="det.Item.InvoiceNo" Variant="Variant.Text" Margin="Margin.Dense" MaxLength="500" OnKeyDown="@((e) => HandleKeyPress(e, det.Item, "invno"))" />
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="@Localizer("Supplier")" Sortable="false">
                             <CellTemplate Context="det">
                                <MudTextField T="string" Value="@det.Item.SupplierName" ValueChanged="@(s => OnGridSupplierChanged(s, det.Item))" Variant="Variant.Text" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(async (e) => await OpenSupplierRowDialog(det.Item))" Placeholder="@Localizer("SelectSupplier")" Clearable="true" />
                            </CellTemplate>
                        </TemplateColumn>
                        
                        <TemplateColumn Title="@Localizer("Narration")" Sortable="false">
                            <CellTemplate Context="det">
                                <MudTextField id="@($"narr-{expenseDto.ExpenseEntryDtls.IndexOf(det.Item)}")" @bind-value="det.Item.Narration" Variant="Variant.Text" Margin="Margin.Dense" MaxLength="2000" OnKeyDown="@((e) => HandleKeyPress(e, det.Item, "narr"))" />
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn CellClass="d-flex justify-end" Sortable="false">
                            <CellTemplate Context="det">
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveRow(det.Item))" Color="Color.Error" title="@Localizer("Delete")" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudPaper>

            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal" @bind-value="expenseDto.Gross" Label="@Localizer("GrossAmount")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N3" ReadOnly="true" Style="font-weight: bold;" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal" @bind-value="expenseDto.VatTotal" Label="@Localizer("VATTotal")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N3" ReadOnly="true" Style="font-weight: bold;" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal" @bind-value="expenseDto.NetTotal" Label="@Localizer("NetTotal")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N3" ReadOnly="true" Style="font-weight: bold; color: green;" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudStack Row="true" Spacing="3" Class="d-flex justify-start mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => Clear(false))" StartIcon="@Icons.Material.Filled.Add">@Localizer("New")</MudButton>
                @if(Id == 0)
                {
                    <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @Localizer("Save")
                        }
                    </MudButton>
                }
                else
                {
                    <MudButton OnClick="Update" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @Localizer("Update")
                        }
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Delete" StartIcon="@Icons.Material.Filled.Delete" Disabled="@(Id == 0)">@Localizer("Delete")</MudButton>
            </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2 mt-0" Elevation="3">
    <MudDataGrid T="ExpenseEntryHdr"
                 @ref="grid"
                 ServerData="LoadServerData"
                 RowClick="@RowClicked"
                 Dense="true"
                 Bordered="true"
                 Striped="true"
                 Hover="true"
                 SortMode="SortMode.Multiple" Filterable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("ExpenseEntryList")</MudText>
            <MudSpacer />
            <MudTextField Margin="Margin.Dense" T="string" Value="@searchText" ValueChanged="OnSearch" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.ExpenseNo" Title="@Localizer("ExpenseNo")" />
            <PropertyColumn Property="x => x.EntryDate" Title="@Localizer("EntryDate")" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.Narration" Title="@Localizer("Narration")" />
            <PropertyColumn Property="x => x.Gross" Title="@Localizer("GrossAmount")" Format="@PermanentSettingsData.CurrencyFormat" />
            <PropertyColumn Property="x => x.VatTotal" Title="@Localizer("VATTotal")" Format="@PermanentSettingsData.CurrencyFormat" />
            <PropertyColumn Property="x => x.NetTotal" Title="@Localizer("NetTotal")" Format="@PermanentSettingsData.CurrencyFormat" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ExpenseEntryHdr" PageSizeOptions="new int[] { 5, 10, 20 }" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

<script>
    window.focusElement = function (id) {
        setTimeout(() => {
            const element = document.getElementById(id);
            if (element) {
                element.focus();
                if (element.select) element.select();
            }
        }, 100);
    };
</script>
