@page "/purchase"
@inject IViewService api
@inject IDialogService DialogService
@inject ModelService Dialog
@inject Downloader Downloader
@inject TabService TabService
@inject ZakiSAASERP.Shared.Services.ShiftService ShiftService

<PageTitle>Zaki ERP | @Localizer("PurchaseTitle")</PageTitle>

<MudPaper Elevation="3" Class="ma-2">
    <MudStack Row="true" Class="pa-2 ma-2">
        <MudText Typo="Typo.h5">@Localizer("PurchaseTitle")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>

    <style>
        .mud-input-disabled-dark .mud-input-slot {
            opacity: 0.6;
        }
    </style>

    <EditForm Model="@purchase" OnValidSubmit="SaveOrUpdate" Context="editContext">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Class="ma-2" Elevation="3" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1">
            <MudTabPanel Text=@Localizer("Details")>
                <MudGrid Spacing="1">
                    @* Row 1 - Purchase Header *@
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("PurchaseNo")</MudText>
                        <MudTextField @ref="txtPurchaseNo"
                                      @bind-Value="purchase.PurchaseNo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="IsAutoCode && purchase.PurchaseId == 0"
                                      Adornment="IsAutoCode? Adornment.End: Adornment.None"
                                      AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                                      AdornmentColor="Color.Secondary"
                                      @ondblclick="SearchClickAsync"
                                      OnKeyDown="HandlePurchaseNoKeyDown" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("PurchaseDate")</MudText>
                        <MudDatePicker @ref="txtPurchaseDate"
                                       @bind-Date="purchase.PurchaseDate"
                                       DateFormat="dd-MM-yyyy"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("SupplierInvoiceNo")</MudText>
                        <MudTextField @ref="txtInvoiceNo"
                                      @bind-Value="purchase.InvoiceNo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("ReferenceNo")</MudText>
                        <MudTextField @ref="txtRefNo"
                                      @bind-Value="purchase.RefNo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("PONo")</MudText>
                        <MudTextField @bind-Value="purchase.PONo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("Purchaser")</MudText>
                        <MudSelect T="int?"
                                   @ref="cmbPurchaser"
                                   @bind-Value="purchase.FK_PurchaserId"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var purch in purchaserList)
                            {
                                <MudSelectItem T="int?" Value="@purch.Id">@purch.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    @* Project Moved to Additional Details *@

                    @* Row 2 - Supplier and Bill Type *@
                    @* Row 2 - Supplier and Bill Type *@
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption">@Localizer("Supplier")</MudText>
                        <MudStack Row>
                            <MudTextField @ref="txtSupplierName"
                                          @bind-Value="purchase.SupplierName"
                                          OnKeyDown="HandleSupplierSearchKeyDown"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Placeholder="@Localizer("SupplierName")"
                                          ReadOnly="@(!IsCashSupplier)"
                                          Clearable="true"
                                          Class="w-100" />
                            <MudFab StartIcon="@Icons.Material.Filled.Add"
                                    Color="Color.Info"
                                    Size="Size.Small"
                                    OnClick="CreateSupplierMethod" />
                            <MudFab StartIcon="@Icons.Material.Rounded.Search"
                                    Color="Color.Info"
                                    Size="Size.Small"
                                    OnClick="SupplierSearchMethod" />
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">@Localizer("VatNo")</MudText>
                        <MudTextField @ref="txtVatNo"
                                      @bind-Value="purchase.SupplierVatNo"
                                      For="@(() => purchase.SupplierVatNo)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("BillType")</MudText>
                        <MudSelect @ref="cmbBillType"
                                   Value="@purchase.BillType"
                                   ValueChanged="OnBillTypeChanged"
                                   T="string"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="string" Value="@("Cash")">@Localizer("Cash")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Credit")">@Localizer("Credit")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Card")">@Localizer("Card")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Transfer")">@Localizer("Transfer")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Cheque")">@Localizer("Cheque")</MudSelectItem>
                        </MudSelect>
                    </MudItem>


                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption">@Localizer("Remarks")</MudText>
                        <MudTextField @ref="txtRemarks"
                                      @bind-Value="purchase.Remarks"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText>@Localizer("AdditionalDiscPer")</MudText>
                            <MudNumericField @ref="txtAdditional" @bind-Value="purchase.AdditionalDiscPertge" Format="N2" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(e => DiscountMethod(e, 1))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>@Localizer("AdditionalDiscount")</MudText>
                            <MudNumericField @ref="txtAdditionalDisc" @bind-Value="purchase.AdditionalDiscAmnt" Format="@strCurencyFormat" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(e => DiscountMethod(e, 2))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Project")</MudText>
                            <MudSelect T="int?" @bind-Value="purchase.FK_ProjectId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var project in projectList)
                                {
                                    <MudSelectItem T="int?" Value="@project.Id">@project.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudRadioGroup @bind-Value="purchase.AdditionalDiscountType">
                                <MudRadio Value="1" Color="Color.Primary" Dense="true">Ex Amount</MudRadio>
                                <MudRadio Value="2" Color="Color.Primary" Dense="true">Inc Amount</MudRadio>
                                <MudRadio Value="3" Color="Color.Primary" Dense="true">Round</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudHidden>
            </MudTabPanel>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudTabPanel Text=@Localizer("Details")>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText>@Localizer("Barcode")</MudText>
                            <MudTextField AutoFocus=true @ref="txtBarcode" Immediate="true" @bind-Value="transaction.Barcode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged("", transaction))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("ProductName") </MudText>
                            <MudTextField Immediate="true" @bind-Value="transaction.ItemName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Store")</MudText>
                            <MudSelect T="int" @bind-Value="transaction.FK_StoreId" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined">
                                @foreach (var store in storeList.Where(x => x.FK_BranchId == AppData.BranchId || x.FK_BranchId == null))
                                {
                                    <MudSelectItem Value="@store.StoreId">@store.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Quantity")</MudText>
                            <MudNumericField @bind-Value="transaction.Quantity" HideSpinButtons="true" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" OnBlur="@((e) => OnLineQuantityChanged(e, transaction))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Unit")</MudText>
                            <MudSelect Value="transaction.FK_UnitId" ValueChanged="@((int v) => OnChangeUnit(v, transaction))" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var item in transaction.AvailableUnits.Any() ? transaction.AvailableUnits : unitlist)
                                {
                                    <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Rate") </MudText>
                            <MudNumericField @bind-Value="transaction.ExRate" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@((e) => OnLineQuantityChanged(e, transaction))" />
                        </MudItem>
                        <div class="d-flex justify-end">
                            <MudItem Class="fixed">
                                <MudFab Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Large" OnClick="AddLineItem">Add</MudFab>
                            </MudItem>
                        </div>
                        <MudItem xs="12">
                            <MudText>@Localizer("Discount") </MudText>
                            <MudNumericField @bind-Value="transaction.DiscountPerc" HideSpinButtons="true" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(() => OnDiscountPercChanged(transaction))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("VAT%") </MudText>
                            <MudNumericField @bind-Value="transaction.TaxPerc" Format="N2" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@((e) => OnTaxBlur(e, transaction))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Total") </MudText>
                            <MudNumericField @bind-Value="transaction.LineTotal" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudHidden>

            @* Additional Details Tab *@
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudTabPanel Text=@Localizer("AdditionalDetails")>
                    <MudGrid Spacing="1">
                        <MudItem xs="6" sm="6">
                            <MudText>@Localizer("AdditionalDiscPer")</MudText>
                            <MudNumericField @ref="txtAdditional"
                                             @bind-Value="purchase.AdditionalDiscPertge"
                                             Format="N2"
                                             HideSpinButtons="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             OnKeyDown="@(e => Keydown(e, 5))"
                                             OnBlur="@(e => DiscountMethod(e, 1))" />
                        </MudItem>
                        <MudItem xs="6" sm="6">
                            <MudText>@Localizer("AdditionalDiscount")</MudText>
                            <MudNumericField @ref="txtAdditionalDisc"
                                             @bind-Value="purchase.AdditionalDiscAmnt"
                                             Format="@strCurencyFormat"
                                             HideSpinButtons="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             OnKeyDown="@(e => Keydown(e, 6))"
                                             OnBlur="@(e => DiscountMethod(e, 2))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("Project")</MudText>
                            <MudSelect T="int?"
                                       @ref="cmbProject"
                                       @bind-Value="purchase.FK_ProjectId"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (var project in projectList)
                                {
                                    <MudSelectItem T="int?" Value="@project.Id">@project.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudRadioGroup @bind-Value="purchase.AdditionalDiscountType">
                                <MudRadio Value="1">Disc on Ex Amount</MudRadio>
                                <MudRadio Value="2">Disc on Inc Amount</MudRadio>
                                <MudRadio Value="3">Round Discount</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudHidden>
        </MudTabs>

        @* Action Buttons with Totals *@
        <MudPaper Class="pa-2 ma-2" Elevation="3">
            <MudGrid>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("GrossAmount")</MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@purchase.GrossAmount.ToString(strCurencyFormat)</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("DiscountAmount") </MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@purchase.LineDsicount.ToString(strCurencyFormat)</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("TaxAmount") </MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@purchase.TaxTotal.ToString(strCurencyFormat) </MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("NetAmount") </MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@purchase.NetAmount.ToString(strCurencyFormat) </MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("GrandTotal") </MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@purchase.GrandTotal.ToString(strCurencyFormat) </MudText>
                </MudItem>
            </MudGrid>
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @Localizer("Save")
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" Color="Color.Error" OnClick="Cancel" Disabled="@(purchase.PurchaseId == 0)">@Localizer("Cancel") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" Disabled="@DisablePrintButton" OnClick="PrintMethod">@Localizer("Print") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DocumentScanner" Color="Color.Warning" Disabled="@DisablePrintButton" OnClick="PrintPrviewMethod">@Localizer("Preview") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchClickAsync">@Localizer("Search") </MudButton>
                </MudStack>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @Localizer("Save")
                        }
                    </MudButton>
                    <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Cancel">@Localizer("Delete") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                </MudStack>
                <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" Disabled="@DisablePrintButton" OnClick="PrintMethod">@Localizer("Print") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchClickAsync">@Localizer("Search") </MudButton>
                </MudStack>
            </MudHidden>
        </MudPaper>
        @* End Action*@

        @* Desktop Table*@
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <MudTable Class="ma-2" Elevation="3" Items="@entTransactions" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="400PX" OnRowClick="RowClickEvent" T="TransactionDtls">
                <HeaderContent>
                    <MudTh>@Localizer("SL")</MudTh>
                    <MudTh>@Localizer("Barcode")</MudTh>
                    <MudTh>@Localizer("ProductName")</MudTh>
                    <MudTh>@Localizer("Store")</MudTh>
                    <MudTh>@Localizer("Quantity")</MudTh>
                    <MudTh>@Localizer("Unit")</MudTh>
                    <MudTh>@Localizer("Rate")</MudTh>
                    <MudTh>@Localizer("Disc%")</MudTh>
                    <MudTh>@Localizer("DiscAmt")</MudTh>
                    <MudTh>@Localizer("Tax")</MudTh>
                    <MudTh>@Localizer("VATAmt")</MudTh>
                    <MudTh>@Localizer("Total")</MudTh>
                    <MudTh>@Localizer("Action")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="SL"><MudTextField @bind-Value="@context.SL" Disabled="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd DataLabel="Barcode">
                        <MudTextField AutoFocus=true @ref="textField" Immediate="true" @bind-Value="@context.Barcode" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged(context.Barcode, context))"
                                      OnBlur="@((e) => OnBarcodeBlurEvent(e, context))" OnKeyDown="@(e => OnEnterMethod(e, context))" />
                    </MudTd>
                    <MudTd DataLabel="Product Name"><MudTextField Immediate="true" @bind-Value="@context.ItemName" Margin="Margin.Dense" /></MudTd>
                    <MudTd DataLabel="Store">
                        <MudSelect T="int" Value="@context.FK_StoreId" ValueChanged="@((int s) => context.FK_StoreId = s)" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var store in storeList.Where(x => x.FK_BranchId == AppData.BranchId || x.FK_BranchId == null))
                            {
                                <MudSelectItem Value="@store.StoreId">@store.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Quantity">
                        <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @ref="txtQuantity"
                                         @bind-Value="@context.Quantity"
                                         Disabled="@(context.FK_ItemId == 0)"
                                         OnBlur="@((e) => OnLineQuantityChanged(e, context))"
                                         Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 2))" />
                    </MudTd>
                    <MudTd DataLabel="Unit">
                        <MudSelect Value="@context.FK_UnitId" ValueChanged="@((int v) => OnChangeUnit(v, context))" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Margin="Margin.Dense">
                            @foreach (var item in context.AvailableUnits.Any() ? context.AvailableUnits : unitlist)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Rate">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtRate"
                                         @bind-Value="@context.ExRate"
                                         Disabled="@(context.FK_ItemId == 0)"
                                         OnBlur="@((e) => OnLineQuantityChanged(e, context))"
                                         Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 4))" />
                    </MudTd>
                    <MudTd DataLabel="Disc%">
                        <MudNumericField HideSpinButtons="true" Format="N2" @ref="txtDiscPerc"
                                         @bind-Value="@context.DiscountPerc"
                                         Disabled="@(context.FK_ItemId == 0)"
                                         OnBlur="@(() => OnDiscountPercChanged(context))"
                                         Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 5))" />
                    </MudTd>
                    <MudTd DataLabel="DiscAmt">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtDiscount"
                                         @bind-Value="@context.DiscountAmnt"
                                         Disabled="@(context.FK_ItemId == 0)"
                                         OnBlur="@(() => OnDiscountAmountChanged(context))"
                                         Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 6))" />
                    </MudTd>
                    <MudTd DataLabel="Tax">
                        <MudNumericField HideSpinButtons="true" Format="N2" @ref="txtTax"
                                         @bind-Value="@context.TaxPerc"
                                         Disabled="@(context.FK_ItemId == 0)"
                                         OnBlur="@((e) => OnTaxBlur(e, context))"
                                         Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 7))" />
                    </MudTd>
                    <MudTd DataLabel="VATAmt"><MudNumericField Disabled="true" HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.TaxAmount" Margin="Margin.Dense" Class="mud-input-disabled-dark" OnKeyDown="@(e => TaskOnEnterMethod(e, 8))" /></MudTd>
                    <MudTd DataLabel="Net Amount">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" @ref="txtNet" @bind-Value="@context.LineTotal"
                                         Format="@strCurencyFormat" Margin="Margin.Dense" Style="text-align:right" OnKeyDown="@(e => TaskOnEnterMethod(e, 9))" />
                    </MudTd>
                    <MudTd DataLabel="Action"> <MudIconButton OnClick="@(() => DltTransaction(@context))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" /></MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddNewRow" Size="Size.Small" Style="white-space: nowrap;">
                            @Localizer("AddRow")
                        </MudButton>
                    </MudTd>
                </FooterContent>
            </MudTable>
        </MudHidden>
        @* End Desktop*@

        @*Mobile Datagrid*@
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudDataGrid Class="ma-2" Elevation="3" T="TransactionDtls" Items="@entTransactions" Bordered="true" Dense="true" RowClick="@RowClicked">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@Localizer("ProductList")</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.SL" Title=@Localizer("SL") Sortable="false" />
                    <PropertyColumn Property="x => x.Barcode" Title=@Localizer("Barcode") Sortable="false" />
                    <PropertyColumn Property="x => x.ItemName" Title=@Localizer("Product") />
                    <PropertyColumn Property='x => x.Quantity.ToString(strQuantityFormat)' Title=@Localizer("Quantity") Sortable="false" />
                    <PropertyColumn Property="x => x.UnitName" Title=@Localizer("Unit") Sortable="false" />
                    <PropertyColumn Property='x => x.ExRate.ToString(strCurencyFormat)' Title=@Localizer("Rate") Sortable="false" />
                    <PropertyColumn Property='x => x.DiscountPerc.ToString("N2")' Title=@Localizer("Discount") Sortable="false" />
                    <PropertyColumn Property='x => x.DiscountAmnt.ToString(strCurencyFormat)' Title=@Localizer("DiscountAmount") Sortable="false" />
                    <PropertyColumn Property='x => x.TaxPerc.ToString("N2")' Title=@Localizer("Tax") Sortable="false" />
                    <PropertyColumn Property='x => x.TaxAmount.ToString(strCurencyFormat)' Title=@Localizer("TaxAmount") Sortable="false" />
                    <PropertyColumn Property='x => x.LineTotal.ToString(strCurencyFormat)' Title=@Localizer("Total") Sortable="false" />
                    <TemplateColumn Title=@Localizer("Action") CellClass="d-flex justify-end" Sortable="false" Filterable="false">
                        <CellTemplate>
                            <MudIconButton OnClick="@(() => DltTransaction(@context.Item))" Color="@Color.Default" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="TransactionDtls" PageSizeOptions="new int[] { 25, 100 }" />
                </PagerContent>
            </MudDataGrid>
        </MudHidden>
        @* End Mobile*@
    </EditForm>
</MudPaper>
