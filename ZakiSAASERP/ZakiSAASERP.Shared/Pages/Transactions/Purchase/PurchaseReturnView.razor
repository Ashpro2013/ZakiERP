@page "/purchasereturn"
@inject IViewService api
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject ModelService Dialog
@inject Downloader Downloader
@inject IndexDBHelper indexdbHelper
@inject TabService TabService
@inject ZakiSAASERP.Shared.Services.ShiftService ShiftService
<PageTitle>Zaki ERP | @Localizer("Purchase Return")</PageTitle>

<MudPaper Elevation="3" Class="ma-2">
    <MudStack Row="true" Class="pa-2 ma-2">
        <MudText Typo="Typo.h5">@Localizer("Purchase Return")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>

    <EditForm Model="@hdr" OnValidSubmit="SaveOrUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Class="ma-2" Elevation="3" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1">
            <MudTabPanel Text=@Localizer("Details")>
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("VoucherNo")</MudText>
                        <MudTextField @ref="txtVoucherNo"
                                      OnKeyDown="@(e => Keydown(e, 1))"
                                      @bind-Value="hdr.PurchaseReturnNo"
                                      Variant="Variant.Outlined"
                                      Class="w-100" Margin="Margin.Dense"
                                      ReadOnly="IsAutoCode && hdr.PurchaseReturnId == 0"
                                      Adornment="IsAutoCode? Adornment.End: Adornment.None"
                                      AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                                      AdornmentColor="Color.Secondary" />
                        <ValidationMessage For="@(() => hdr.PurchaseReturnNo)" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("Date")</MudText>
                        <MudDatePicker @ref="txtVoucherDate" @bind-Date="hdr.PurchaseReturnDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                        <ValidationMessage For="@(() => hdr.PurchaseReturnDate)" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("Supplier")</MudText>
                        <MudStack Row>
                            <MudTextField @ref="txtSupplier" OnKeyDown="@(e => Keydown(e, 2))" @bind-Value="hdr.SupplierName" Variant="Variant.Outlined" Class="w-100"
                                          Margin="Margin.Dense" Clearable="true" Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="PartySearchMethod" />
                        </MudStack>
                        <ValidationMessage For="@(() => hdr.SupplierName)" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("Purchase VoucherNo")</MudText>
                        <MudStack Row="true">
                            <MudTextField @ref="txtRefNo" OnKeyDown="@(e => Keydown(e, 3))" @bind-Value="hdr.PurchaseVoucherNo" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="@(ReturnMode == 1)" ondblclick="@OpenPurchaseSearch" />
                            <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" OnClick="OpenPurchaseSearch" Disabled="@(ReturnMode == 1)" />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("BillType")</MudText>
                        <MudSelect T="string" @bind-Value="hdr.BillType" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var type in BillTypes)
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudStack Row="true" Spacing="4">
                            <div>
                                <MudText Typo="Typo.caption">@Localizer("ReturnMode")</MudText>
                                <MudRadioGroup T="int" Value="ReturnMode" ValueChanged="OnReturnModeChanged">
                                    <MudRadio Value="0" Color="Color.Primary" Dense="true">@Localizer("FromInvoice")</MudRadio>
                                    <MudRadio Value="1" Color="Color.Secondary" Dense="true">@Localizer("DirectReturn")</MudRadio>
                                </MudRadioGroup>
                            </div>
                            @if (ReturnMode == 0)
                            {
                                <div>
                                    <MudText Typo="Typo.caption">@Localizer("LoadMode")</MudText>
                                    <MudRadioGroup Value="LoadMode" ValueChanged="@((int val) => OnLoadModeChanged(val))">
                                        <MudRadio Value="0" Color="Color.Primary" Dense="true">@Localizer("FillQty")</MudRadio>
                                        <MudRadio Value="1" Color="Color.Secondary" Dense="true">@Localizer("ZeroQty")</MudRadio>
                                    </MudRadioGroup>
                                </div>
                            }
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("InvoiceNo")</MudText>
                        <MudTextField @bind-Value="hdr.InvoiceNo" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("Purchaser")</MudText>
                        <MudStack Row>
                            <MudSelect T="int?" @ref="cmbPurchaser" @bind-Value="hdr.FK_PurchaserId" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var sman in purchaserList)
                                {
                                    <MudSelectItem T="int?" Value="@sman.Id">@sman.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" OnClick="PurchaserSearchMethod" />
                        </MudStack>
                        <ValidationMessage For="@(() => hdr.FK_PurchaserId)" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText>@Localizer("Remarks")</MudText>
                        <MudTextField @ref="txtRemarks" OnKeyDown="@(e => Keydown(e, 4))" @bind-Value="hdr.Remarks" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText>@Localizer("AdditionalDiscPer")</MudText>
                            <MudNumericField @ref="txtAdditional" @bind-Value="hdr.AdditionalDiscPertge" Format="N2" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="@(e => Keydown(e, 5))" OnBlur="@(e => DiscountMethod(e, 1))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("AdditionalDiscount")</MudText>
                            <MudNumericField @ref="txtAdditionalDisc" @bind-Value="hdr.AdditionalDiscAmnt" Format="@strCurencyFormat" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="@(e => Keydown(e, 6))" OnBlur="@(e => DiscountMethod(e, 2))" />
                        </MudItem>
                    </MudGrid>
                </MudHidden>
            </MudTabPanel>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudTabPanel Text=@Localizer("Details")>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText>@Localizer("Barcode")</MudText>
                            <MudTextField AutoFocus=true @ref="txtBarcode" Immediate="true" @bind-Value="transaction.Barcode" Variant="Variant.Outlined" Margin="Margin.Dense" TextChanged="MobileBarcodeChanged" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("ProductName") </MudText>
                            <MudTextField Immediate="true" @bind-Value="transaction.ItemName" Variant="Variant.Outlined" Margin="Margin.Dense" TextChanged="MobileBarcodeChanged" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Quantity")</MudText>
                            <MudNumericField @bind-Value="transaction.Quantity" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Unit")</MudText>
                            <MudSelect Value="transaction.FK_UnitId" ValueChanged="OnChangeUnit" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var item in itemUnitlist)
                                {
                                    <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Rate") </MudText>
                            <MudNumericField @bind-Value="transaction.ExRate" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                        </MudItem>
                        <div class="d-flex justify-end">
                            <MudItem Class="fixed">
                                <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Large" OnClick="AddLineItem" Label="Add" />
                            </MudItem>
                        </div>
                        <MudItem xs="12">
                            <MudText>@Localizer("Discount") </MudText>
                            <MudNumericField @bind-Value="transaction.DiscountPerc" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Tax") </MudText>
                            <MudNumericField @bind-Value="transaction.TaxAmount" Format="@strCurencyFormat" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Total") </MudText>
                            <MudNumericField @bind-Value="transaction.LineTotal" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudTabPanel Text=@Localizer("Additional")>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("AdditionalDiscPer")</MudText>
                            <MudNumericField @ref="txtAdditional" onBlur="@(e => DiscountMethod(e, 1))" Format="N2" OnKeyDown="@(e => Keydown(e, 5))" @bind-Value="hdr.AdditionalDiscPertge" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("AdditionalDiscount") </MudText>
                            <MudNumericField @ref="txtAdditionalDisc" onBlur="@(e => DiscountMethod(e, 2))" Format="@strCurencyFormat" OnKeyDown="@(e => Keydown(e, 6))" @bind-Value="hdr.AdditionalDiscAmnt" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText>@Localizer("Project")</MudText>
                            <MudSelect T="int?" @ref="cmbProject" @bind-Value="hdr.FK_ProjectId" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var project in projectList)
                                {
                                    <MudSelectItem T="int?" Value="@project.Id">@project.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem>
                            <MudRadioGroup @bind-Value="hdr.AdditionalDiscountType">
                                <MudRadio Value="1">Disc on Ex Amount</MudRadio>
                                <MudRadio Value="2">Disc on Inc Amount</MudRadio>
                                <MudRadio Value="3">Round Discount</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudHidden>
        </MudTabs>

        @* Action*@
        <MudPaper Class="pa-2 ma-2" Elevation="3">
            <MudGrid>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("GrossAmount")</MudText>
                    <MudText>@hdr.GrossAmount.ToString(strCurencyFormat)</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("DiscountAmount") </MudText>
                    <MudText>@hdr.LineDsicount.ToString(strCurencyFormat)</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("TaxAmount") </MudText>
                    <MudText>@hdr.TaxTotal.ToString(strCurencyFormat) </MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("NetAmount") </MudText>
                    <MudText>@hdr.NetAmount.ToString(strCurencyFormat) </MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText>@Localizer("GrandTotal") </MudText>
                    <MudText>@hdr.GrandTotal.ToString(strCurencyFormat) </MudText>
                </MudItem>
            </MudGrid>
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @(hdr.PurchaseReturnId > 0 ? Localizer("Update") : Localizer("Save"))
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="@DisableCancelButton" OnClick="Cancel">@Localizer("Cancel") </MudButton>
                    <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DocumentScanner" Color="Color.Warning" Disabled="@DisablePrintButton" OnClick="PrintPrviewMethod">@Localizer("Preview") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" Disabled="@DisablePrintButton" OnClick="PrintMethod">@Localizer("Print") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchMethod">@Localizer("Search") </MudButton>
                </MudStack>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @(hdr.PurchaseReturnId > 0 ? Localizer("Update") : Localizer("Save"))
                        }
                    </MudButton>
                    <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete") </MudButton>
                </MudStack>
                <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DocumentScanner" Color="Color.Warning" Disabled="@DisablePrintButton" OnClick="PrintPrviewMethod">@Localizer("Preview") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" Disabled="@DisablePrintButton" OnClick="PrintMethod">@Localizer("Print") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchMethod">@Localizer("Search") </MudButton>
                </MudStack>
            </MudHidden>
        </MudPaper>
        @* End Action*@
    </EditForm>

    @* Desktop Table*@
    <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
        <MudTable Class="ma-2" Elevation="3" Items="@entTransactions" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="400PX" OnRowClick="RowClickEvent" T="TransactionDtls">
            <HeaderContent>
                <MudTh>@Localizer("SL")</MudTh>
                @if (gridSettings.ShowItemCode)
                {
                    <MudTh>@Localizer("ItemCode")</MudTh>
                }
                @if (gridSettings.ShowBarcode)
                {
                    <MudTh>@Localizer("Barcode")</MudTh>
                }
                @if (gridSettings.ShowItemName)
                {
                    <MudTh>@Localizer("Item Name")</MudTh>
                }
                @if (gridSettings.ShowArabicName)
                {
                    <MudTh>@Localizer("ArabicName")</MudTh>
                }
                <MudTh>@Localizer("Store")</MudTh>
                <MudTh>@Localizer("Quantity")</MudTh>
                @if (gridSettings.ShowUnit)
                {
                    <MudTh>@Localizer("Unit")</MudTh>
                }
                @if (gridSettings.ShowExRate)
                {
                    <MudTh>@Localizer("ExRate")</MudTh>
                }
                @if (gridSettings.ShowIncRate)
                {
                    <MudTh>@Localizer("IncRate")</MudTh>
                }
                @if (gridSettings.ShowGross)
                {
                    <MudTh>@Localizer("GrossAmount")</MudTh>
                }
                @if (gridSettings.ShowDiscPercentage)
                {
                    <MudTh>@Localizer("Discount") %</MudTh>
                }
                @if (gridSettings.ShowDiscAmount)
                {
                    <MudTh>@Localizer("DiscAmount")</MudTh>
                }
                @if (gridSettings.ShowTaxableAmount)
                {
                    <MudTh>@Localizer("TaxableAmount")</MudTh>
                }
                @if (gridSettings.ShowTaxPercentage)
                {
                    <MudTh>@Localizer("Tax") %</MudTh>
                }
                @if (gridSettings.ShowTaxAmount)
                {
                    <MudTh>@Localizer("TaxAmount")</MudTh>
                }
                @if (gridSettings.ShowAmount)
                {
                    <MudTh>@Localizer("Total")</MudTh>
                }
                <MudTh>@Localizer("Action")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="SL"><MudTextField @bind-Value="@context.SL" Disabled="true" Margin="Margin.Dense" /></MudTd>
                @if (gridSettings.ShowItemCode)
                {
                    <MudTd DataLabel="Item Code">
                        <MudTextField @bind-Value="@context.ItemCode" ReadOnly="true" Margin="Margin.Dense" />
                    </MudTd>
                }
                @if (gridSettings.ShowBarcode)
                {
                    <MudTd DataLabel="Barcode">
                        <MudTextField AutoFocus=true @ref="textField" Immediate="true" @bind-Value="@context.Barcode" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged(context.Barcode))"
                                      OnBlur="OnBarcodBlurEvent" OnKeyDown="OnEnterMethod" />
                    </MudTd>
                }
                @if (gridSettings.ShowItemName)
                {
                    <MudTd DataLabel="Item Name"><MudTextField Immediate="true" @bind-Value="@context.ItemName" Margin="Margin.Dense" /></MudTd>
                }
                @if (gridSettings.ShowArabicName)
                {
                    <MudTd DataLabel="Arabic Name"><MudTextField Immediate="true" @bind-Value="@context.ItemArabicName" Margin="Margin.Dense" /></MudTd>
                }
                <MudTd DataLabel="Store">
                    <MudSelect T="int" Value="@context.FK_StoreId" ValueChanged="@((int s) => context.FK_StoreId = s)" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var store in storeList.Where(x => x.FK_BranchId == AppData.BranchId || x.FK_BranchId == null))
                        {
                            <MudSelectItem Value="@store.StoreId">@store.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="Quantity">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @ref="txtQuantity" @bind-Value="@context.Quantity"
                                     Margin="Margin.Dense" OnBlur="OnBlurQtEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 2))" />
                </MudTd>
                @if (gridSettings.ShowUnit)
                {
                    <MudTd DataLabel="Unit">
                        <MudSelect Value="@context.FK_UnitId" ValueChanged="OnChangeUnit" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Margin="Margin.Dense">
                            @foreach (var item in itemUnitlist)
                            {
                                <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                }
                @if (gridSettings.ShowExRate)
                {
                    <MudTd DataLabel="Ex Rate">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtRate"
                                         Value="@context.ExRate"
                                         ValueChanged="@((decimal v) => OnExRateChanged(context, v))"
                                         ReadOnly="@(!gridSettings.AllowEditExcRate)"
                                         Margin="Margin.Dense" OnBlur="OnBlurQtEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 4))" />
                    </MudTd>
                }
                @if (gridSettings.ShowIncRate)
                {
                    <MudTd DataLabel="Inc Rate">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat"
                                         Value="@context.InRate"
                                         ValueChanged="@((decimal v) => OnInRateChanged(context, v))"
                                         ReadOnly="@(!gridSettings.AllowEditIncRate)"
                                         Margin="Margin.Dense" OnBlur="OnBlurQtEvent" />
                    </MudTd>
                }
                @if (gridSettings.ShowGross)
                {
                    <MudTd DataLabel="Gross">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" Value="@context.GrossAmount" Format="@strCurencyFormat" Margin="Margin.Dense" Style="text-align:right" />
                    </MudTd>
                }
                @if (gridSettings.ShowDiscPercentage)
                {
                    <MudTd DataLabel="Discount %">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtDiscount"
                                         Value="@context.DiscountPerc"
                                         ValueChanged="@((decimal v) => OnDiscPerChanged(context, v))"
                                         ReadOnly="@(!gridSettings.AllowEditDiscPer)"
                                         Margin="Margin.Dense" OnBlur="OnBlurQtEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 5))" />
                    </MudTd>
                }
                @if (gridSettings.ShowDiscAmount)
                {
                    <MudTd DataLabel="Disc Amount">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat"
                                         Value="@context.DiscountAmnt"
                                         ValueChanged="@((decimal v) => OnDiscAmountChanged(context, v))"
                                         ReadOnly="@(!gridSettings.AllowEditDiscAmount)"
                                         Margin="Margin.Dense" OnBlur="OnBlurQtEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 6))" />
                    </MudTd>
                }
                @if (gridSettings.ShowTaxableAmount)
                {
                    <MudTd DataLabel="Taxable Amount">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" Value="@context.TaxableAmnt" Format="@strCurencyFormat" Margin="Margin.Dense" Style="text-align:right" />
                    </MudTd>
                }
                @if (gridSettings.ShowTaxPercentage)
                {
                    <MudTd DataLabel="Tax %">
                        <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtTax" @bind-Value="@context.TaxPerc" Margin="Margin.Dense" OnBlur="OnBlurEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 7))" />
                    </MudTd>
                }
                @if (gridSettings.ShowTaxAmount)
                {
                    <MudTd DataLabel="Tax Amount">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" Value="@context.TaxAmount" Format="@strCurencyFormat" Margin="Margin.Dense" Style="text-align:right" OnKeyDown="@(e => TaskOnEnterMethod(e, 8))" />
                    </MudTd>
                }
                @if (gridSettings.ShowAmount)
                {
                    <MudTd DataLabel="Total">
                        <MudNumericField ReadOnly="true" HideSpinButtons="true" @ref="txtNet" @bind-Value="@context.LineTotal" Format="@strCurencyFormat" Margin="Margin.Dense" Style="text-align:right" OnKeyDown="@(e => TaskOnEnterMethod(e, 9))" />
                    </MudTd>
                }
                <MudTd DataLabel="Action"> <MudIconButton OnClick="@(() => DltTransaction(@context))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" /></MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddNewRow" Size="Size.Small" Style="white-space: nowrap;">
                        @Localizer("AddRow")
                    </MudButton>
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudHidden>
    @* End Desktop*@

    @*Mobile Datagrid*@
    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
        <MudDataGrid Class="ma-2" Elevation="3" T="TransactionDtls" Items="@entTransactions" Bordered="true" Dense="true" RowClick="@RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("ProductList")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.SL" Title=@Localizer("SL") Sortable="false" />
                @if (gridSettings.ShowItemCode)
                {
                    <PropertyColumn Property="x => x.ItemCode" Title=@Localizer("ItemCode") Sortable="false" />
                }
                @if (gridSettings.ShowBarcode)
                {
                    <PropertyColumn Property="x => x.Barcode" Title=@Localizer("Barcode") Sortable="false" />
                }
                @if (gridSettings.ShowItemName)
                {
                    <PropertyColumn Property="x => x.ItemName" Title=@Localizer("Product") />
                }
                @if (gridSettings.ShowArabicName)
                {
                    <PropertyColumn Property="x => x.ItemArabicName" Title=@Localizer("ArabicName") Sortable="false" />
                }
                <PropertyColumn Property="x => x.Quantity.ToString(strQuantityFormat)" Title=@Localizer("Quantity") Sortable="false" />
                @if (gridSettings.ShowUnit)
                {
                    <PropertyColumn Property="x => x.UnitName" Title=@Localizer("Unit") Sortable="false" />
                }
                @if (gridSettings.ShowExRate)
                {
                    <PropertyColumn Property="x => x.ExRate.ToString(strCurencyFormat)" Title=@Localizer("ExRate") Sortable="false" />
                }
                @if (gridSettings.ShowIncRate)
                {
                    <PropertyColumn Property="x => x.InRate.ToString(strCurencyFormat)" Title=@Localizer("IncRate") Sortable="false" />
                }
                @if (gridSettings.ShowGross)
                {
                    <PropertyColumn Property="x => x.GrossAmount.ToString(strCurencyFormat)" Title=@Localizer("GrossAmount") Sortable="false" />
                }
                @if (gridSettings.ShowDiscPercentage)
                {
                    <PropertyColumn Property="x => x.DiscountPerc.ToString(strCurencyFormat)" Title=@Localizer("Discount") Sortable="false" />
                }
                @if (gridSettings.ShowDiscAmount)
                {
                    <PropertyColumn Property="x => x.DiscountAmnt.ToString(strCurencyFormat)" Title=@Localizer("DiscAmount") Sortable="false" />
                }
                @if (gridSettings.ShowTaxableAmount)
                {
                    <PropertyColumn Property="x => x.TaxableAmnt.ToString(strCurencyFormat)" Title=@Localizer("TaxableAmount") Sortable="false" />
                }
                @if (gridSettings.ShowTaxPercentage)
                {
                    <PropertyColumn Property="x => x.TaxPerc.ToString(strCurencyFormat)" Title=@Localizer("Tax") Sortable="false" />
                }
                @if (gridSettings.ShowTaxAmount)
                {
                    <PropertyColumn Property="x => x.TaxAmount.ToString(strCurencyFormat)" Title=@Localizer("TaxAmount") Sortable="false" />
                }
                @if (gridSettings.ShowAmount)
                {
                    <PropertyColumn Property="x => x.LineTotal.ToString(strCurencyFormat)" Title=@Localizer("Total") Sortable="false" />
                }
                <TemplateColumn Title=@Localizer("Action") CellClass="d-flex justify-end" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton OnClick="@(() => DltTransaction(@context.Item))" Color="@Color.Default" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="TransactionDtls" PageSizeOptions="new int[] { 25, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudHidden>
    @* End Mobile*@
</MudPaper>

