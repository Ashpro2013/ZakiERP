@page "/joborder"
@using ZakiSAASERP.Models.Transactions.Workshop
@inject IViewService api
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject ModelService Dialog
@inject Downloader Downloader
@inject TabService TabService

<PageTitle>Zaki ERP | @Localizer("JobOrder")</PageTitle>
<MudPaper Elevation="3" Class="ma-2">
    <MudStack Row="true" Class="pa-2 ma-2">
        <MudText Typo="Typo.h5">@Localizer("JobOrder")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>

    <style>
        .mud-input-disabled-dark .mud-input-slot {
            opacity: 0.6;
        }
    </style>

<EditForm Model="@jobOrder" OnValidSubmit="SaveOrUpdate" Context="editContext">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Class="ma-2" Elevation="3" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1">
        <MudTabPanel Text=@Localizer("Header")>
            <MudGrid Spacing="1">
                @* Row 1 - Header Info *@
                <MudItem xs="12" sm="2">
                    <MudText Typo="Typo.caption">@Localizer("JobOrderNo")</MudText>
                    <MudTextField @bind-Value="jobOrder.VoucherNo" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  ReadOnly="@IsAutoCode"
                                  id="VoucherNo"
                                  OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await _txtVoucherDate.FocusAsync(); })"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                                  AdornmentColor="Color.Secondary" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudText Typo="Typo.caption">@Localizer("JobOrderDate")</MudText>
                    <MudDatePicker @ref="_txtVoucherDate"
                                  @bind-Date="jobOrder.VoucherDate"
                                  DateFormat="dd-MM-yyyy" 
                                  Variant="Variant.Outlined" 
                                  Color="Color.Primary"
                                  Margin="Margin.Dense" 
                                  Editable="true"
                                  Mask="@(new DateMask("dd-MM-yyyy"))"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Event"
                                  Class="mud-width-full" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudText Typo="Typo.caption">@Localizer("PromisedDate")</MudText>
                     <MudDatePicker @ref="_txtPromisedDate"
                                  @bind-Date="jobOrder.PromisedDate"
                                  DateFormat="dd-MM-yyyy" 
                                  Variant="Variant.Outlined" 
                                  Color="Color.Primary"
                                  Margin="Margin.Dense" 
                                  Editable="true"
                                  Mask="@(new DateMask("dd-MM-yyyy"))"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Event"
                                  Class="mud-width-full" />
                </MudItem>
                 <MudItem xs="12" sm="2">
                    <MudText Typo="Typo.caption">@Localizer("Status")</MudText>
                     <MudSelect T="string" @bind-Value="jobOrder.Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                         <MudSelectItem Value="@("Opened")">Opened</MudSelectItem>
                         <MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
                         <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                         <MudSelectItem Value="@("Closed")">Closed</MudSelectItem>
                     </MudSelect>
                </MudItem>

                    @* Row 2 - Vehicle Info *@
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">@Localizer("PlateNo")</MudText>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @ref="txtPlateNo"
                                          @bind-Value="jobOrder.PlateNo"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="@(async () => await SearchVehicle())"
                                          OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchVehicle(); })" />
                            <MudTooltip Text="@Localizer("CreateVehicle")">
                                <MudFab StartIcon="@Icons.Material.Filled.Add"
                                        Color="Color.Info"
                                        Size="Size.Small"
                                        OnClick="OpenCreateVehicle"
                                        Class="mx-1" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer("VehicleHistory")">
                                <MudFab StartIcon="@Icons.Material.Filled.History"
                                        Color="Color.Secondary"
                                        Size="Size.Small"
                                        OnClick="OpenVehicleHistory" />
                            </MudTooltip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption">@Localizer("ChassisNo")</MudText>
                        <MudTextField @bind-Value="jobOrder.ChassisNo" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption">@Localizer("Model")</MudText>
                        <MudTextField @bind-Value="jobOrder.Model" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("Year")</MudText>
                        <MudNumericField @bind-Value="jobOrder.Year" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("Kilometer")</MudText>
                        <MudTextField @ref="txtKilometer" @bind-Value="jobOrder.Kilometer"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await txtReference.FocusAsync(); })" />
                    </MudItem>

                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption">@Localizer("Reference")</MudText>
                        <MudTextField @ref="txtReference" @bind-Value="jobOrder.ReferenceNo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await cmbSalesMan.FocusAsync(); })" />
                    </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">@Localizer("CustomerName")</MudText>
                    <MudTextField @bind-Value="jobOrder.CustomerName" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">@Localizer("SalesMan")</MudText>
                    <MudSelect @ref="cmbSalesMan" T="int?" @bind-Value="jobOrder.FK_SalesManId" 
                               Variant="Variant.Outlined" 
                               Margin="Margin.Dense" 
                               AnchorOrigin="Origin.BottomCenter"
                               OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await txtContactNo.FocusAsync(); })">
                        @foreach (var sman in salesmanList)
                        {
                            <MudSelectItem T="int?" Value="@sman.Id">@sman.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">@Localizer("ContactNo")</MudText>
                    <MudTextField @ref="txtContactNo" @bind-Value="jobOrder.ContactNo" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense"
                                  OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await txtDeliveredBy.FocusAsync(); })" />
                </MudItem>
         
                <MudItem xs="12" sm="2">
                    <MudText Typo="Typo.caption">@Localizer("TimeIn")</MudText>
                    <MudTimePicker @bind-Time="timeInSpan" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
       
                 <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">@Localizer("DeliveredBy")</MudText>
                    <MudTextField @ref="txtDeliveredBy" @bind-Value="jobOrder.DeliveredBy" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await FocusById("repair_0"); })" />
                </MudItem>
            
                @* Mobile Additional Details *@
                <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                     <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption">@Localizer("VehicleInfo")</MudText>
                        <MudTextField @bind-Value="jobOrder.VehicleInfo" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                    </MudItem>
                     <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption">@Localizer("Comments")</MudText>
                        <MudTextField @bind-Value="jobOrder.Comments" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Class="mb-1">@Localizer("IstimaraImage")</MudText>
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadIstimara" Accept=".png,.jpg,.jpeg" MaximumFileCount="1">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Class="mb-2">
                                    @Localizer("UploadImage")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                        @if (!string.IsNullOrWhiteSpace(istimaraImagePreview))
                        {
                            <MudPaper Elevation="3" Class="pa-2 mt-1 d-inline-block position-relative" Style="width:150px; border-radius:12px;">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Class="position-absolute" Style="top:-8px; right:-8px; background:white; border-radius:50%;" OnClick="RemoveIstimaraImage" />
                                <img src="@istimaraImagePreview" width="140" style="cursor:pointer; border-radius:8px;" @onclick="@(() => ShowImagePopup(istimaraImagePreview))" />
                                <MudText Typo="Typo.caption" Class="mt-1 text-center" Style="max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @(pendingIstimaraFile is not null ? pendingIstimaraFile.Name : jobOrder.IstimaraPath?.Split(new char[] { '\\', '/' }).LastOrDefault())
                                </MudText>
                            </MudPaper>
                        }
                    </MudItem>
                </MudHidden>

            </MudGrid>
        </MudTabPanel>

        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudTabPanel Text="@Localizer("Items")">
                 @* Mobile Entry Form *@
                 <MudGrid Class="pa-2">
                    <MudItem xs="12">
                         <MudTextField @bind-Value="mobileItem.RepairName" Label="@Localizer("Repair")" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                                       Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="MobileRepairSearch" />
                    </MudItem>
                    <MudItem xs="12">
                         <MudTextField @bind-Value="mobileItem.TechnicianName" Label="@Localizer("Technician")" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                                       Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="MobileTechnicianSearch" />
                    </MudItem>
                    <MudItem xs="6">
                         <MudNumericField @bind-Value="mobileItem.Qty" Label="@Localizer("Quantity")" Variant="Variant.Outlined" Format="@PermanentSettingsData.QuantityFormat" Margin="Margin.Dense" HideSpinButtons="true" OnBlur="CalculateMobileItem" />
                    </MudItem>
                    <MudItem xs="6">
                         <MudNumericField @bind-Value="mobileItem.Rate" Label="@Localizer("Rate")" Variant="Variant.Outlined" Format="@PermanentSettingsData.CurrencyFormat" Margin="Margin.Dense" HideSpinButtons="true" OnBlur="CalculateMobileItem" />
                    </MudItem>
                    <MudItem xs="12">
                         <MudText>@Localizer("Total"): @PermanentSettingsData.FormatCurrency(mobileItem.LineTotal)</MudText>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.Xs">
        <MudTabPanel Text=@Localizer("AdditionalDetails")>
             <MudGrid Spacing="1">
                 <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">@Localizer("VehicleInfo")</MudText>
                    <MudTextField @bind-Value="jobOrder.VehicleInfo" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                </MudItem>
                 <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">@Localizer("Comments")</MudText>
                    <MudTextField @bind-Value="jobOrder.Comments" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Class="mb-1">@Localizer("IstimaraImage")</MudText>
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadIstimara" Accept=".png,.jpg,.jpeg" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Class="mb-2">
                                @Localizer("UploadImage")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (!string.IsNullOrWhiteSpace(istimaraImagePreview))
                    {
                        <MudPaper Elevation="3" Class="pa-2 mt-1 d-inline-block position-relative" Style="width:150px; border-radius:12px;">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Class="position-absolute" Style="top:-8px; right:-8px; background:white; border-radius:50%;" OnClick="RemoveIstimaraImage" />
                            <img src="@istimaraImagePreview" width="140" style="cursor:pointer; border-radius:8px;" @onclick="@(() => ShowImagePopup(istimaraImagePreview))" />
                            <MudText Typo="Typo.caption" Class="mt-1 text-center" Style="max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                @(pendingIstimaraFile is not null ? pendingIstimaraFile.Name : jobOrder.IstimaraPath?.Split(new char[] { '\\', '/' }).LastOrDefault())
                            </MudText>
                        </MudPaper>
                    }
                </MudItem>
             </MudGrid>
        </MudTabPanel>
        </MudHidden>
    </MudTabs>

    @* Action *@
    <MudPaper Class="pa-2 ma-2" Elevation="3">
        <MudGrid>
             <MudItem xs="6" sm="4">
                <MudText>@Localizer("GrossAmount")</MudText>
                <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@PermanentSettingsData.FormatCurrency(jobOrder.TotalAmount)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText>@Localizer("VatAmount") </MudText>
                <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@PermanentSettingsData.FormatCurrency(jobOrder.TotalVat) </MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText>@Localizer("NetAmount") </MudText>
                <MudText Variant="Variant.Outlined" Margin="Margin.Dense">@PermanentSettingsData.FormatCurrency(jobOrder.GrandTotal) </MudText>
            </MudItem>
        </MudGrid>
        
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Button" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@Localizer("Processing")</MudText>
                    }
                    else
                    {
                        @Localizer(jobOrder.JobOrderId == 0 ? "Save" : "Update")
                    }
                </MudButton>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Button" StartIcon="@Icons.Material.Filled.Cancel" Color="Color.Error" OnClick="Cancel" Disabled="@(jobOrder.JobOrderId == 0)">@Localizer("Cancel") </MudButton>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Button" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Button" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" OnClick="@(() => PrintMethod())">@Localizer("Print") </MudButton>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Button" StartIcon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Warning" OnClick="@(() => PrintHelperMethod(true))">@Localizer("Preview") </MudButton>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Button" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchClickAsync">@Localizer("Search") </MudButton>
            </MudStack>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
             <MudGrid Class="pa-2" Spacing="1">
                 <MudItem xs="6">
                     <MudButton FullWidth="true" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveOrUpdate" Disabled="@_isSaving">
                         @if (_isSaving)
                         {
                             <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                             <MudText Class="ms-2">@Localizer("Processing")</MudText>
                         }
                         else
                         {
                             @Localizer(jobOrder.JobOrderId == 0 ? "Save" : "Update")
                         }
                     </MudButton>
                 </MudItem>
                 <MudItem xs="6">
                     <MudButton FullWidth="true" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New")</MudButton>
                 </MudItem>
                 <MudItem xs="6">
                     <MudButton FullWidth="true" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Tertiary" OnClick="@(() => PrintHelperMethod(true))">@Localizer("Preview")</MudButton>
                 </MudItem>
                 <MudItem xs="6">
                     <MudButton FullWidth="true" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" OnClick="@(() => PrintMethod())">@Localizer("Print")</MudButton>
                 </MudItem>
                 <MudItem xs="6">
                     <MudButton FullWidth="true" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchClickAsync">@Localizer("Search")</MudButton>
                 </MudItem>
             </MudGrid>
        </MudHidden>
    </MudPaper>
    @* End Action *@

        @* Desktop Table *@
        <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <MudTable Class="ma-2" Elevation="3" Items="@entTransactions" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="400PX" OnRowClick="RowClickEvent" T="JobOrderDtls">
                <ColGroup>
                    <col style="width: 25px;" />
                    <col style="width: 10%;" />
                    <col style="width: 22%;" />
                    <col style="width: 15%;" />
                    <col style="width: 8%;" />
                    <col style="width: 8%;" />
                    <col style="width: 10%;" />
                    <col style="width: 7%;" />
                    <col style="width: 8%;" />
                    <col style="width: 12%;" />
                    <col style="width: 40px;" />
                </ColGroup>
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>@Localizer("Code")</MudTh>
                    <MudTh>@Localizer("Repair")</MudTh>
                    <MudTh>@Localizer("Technician")</MudTh>
                    <MudTh>@Localizer("Quantity")</MudTh>
                    <MudTh>@Localizer("Rate")</MudTh>
                    <MudTh>@Localizer("Total")</MudTh>
                    <MudTh>@Localizer("Vat%")</MudTh>
                    <MudTh>@Localizer("Vat")</MudTh>
                    <MudTh>@Localizer("LineTotal")</MudTh>
                    <MudTh>@Localizer("Action")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(entTransactions.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Code">
                        <MudTextField @bind-Value="@context.RepairCode" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(async (MouseEventArgs e) => await OpenRepairSearch(context))"
                                      id="@("repair_" + entTransactions.IndexOf(context))"
                                      @onfocus="@(() => JSRuntime.InvokeVoidAsync("selectTextById", "repair_" + entTransactions.IndexOf(context)))"
                                      OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await OpenRepairSearch(context); })" />
                    </MudTd>
                    <MudTd DataLabel="Repair"><MudTextField @bind-Value="@context.RepairName" Margin="Margin.Dense" ReadOnly="true" /></MudTd>
                    <MudTd DataLabel="Technician">
                        <MudTextField @bind-Value="@context.TechnicianName" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(async (MouseEventArgs e) => await OpenTechnicianSearch(context))"
                                      id="@("technician_" + entTransactions.IndexOf(context))"
                                      OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await OpenTechnicianSearch(context); })" />
                    </MudTd>
                    <MudTd DataLabel="Quantity">
                        <MudNumericField @bind-Value="@context.Qty" Margin="Margin.Dense" HideSpinButtons="true" TextChanged="@((v) => CalculateRow(context))" Format="@PermanentSettingsData.QuantityFormat"
                                         id="@("qty_" + entTransactions.IndexOf(context))"
                                         @onfocus="@(() => JSRuntime.InvokeVoidAsync("selectTextById", "qty_" + entTransactions.IndexOf(context)))"
                                         OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await FocusById("rate_" + entTransactions.IndexOf(context)); })" />
                    </MudTd>
                    <MudTd DataLabel="Rate">
                        <MudNumericField @bind-Value="@context.Rate" Margin="Margin.Dense" HideSpinButtons="true" TextChanged="@((v) => CalculateRow(context))" Format="@PermanentSettingsData.CurrencyFormat"
                                         id="@("rate_" + entTransactions.IndexOf(context))"
                                         @onfocus="@(() => JSRuntime.InvokeVoidAsync("selectTextById", "rate_" + entTransactions.IndexOf(context)))"
                                         OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") { AddRow(); await Task.Delay(50); await FocusById("repair_" + (entTransactions.IndexOf(context) + 1)); } })" />
                    </MudTd>
                    <MudTd DataLabel="Total"><MudNumericField Value="@context.Total" ReadOnly="true" Margin="Margin.Dense" HideSpinButtons="true" Format="@PermanentSettingsData.CurrencyFormat" /></MudTd>
                    <MudTd DataLabel="Vat%">
                        <MudNumericField @bind-Value="@context.VatPercent" Margin="Margin.Dense" HideSpinButtons="true" TextChanged="@((v) => CalculateRow(context))" Format="N2" />
                    </MudTd>
                    <MudTd DataLabel="Vat"><MudNumericField Value="@context.VatAmount" ReadOnly="true" Margin="Margin.Dense" HideSpinButtons="true" Format="@PermanentSettingsData.CurrencyFormat" /></MudTd>
                    <MudTd DataLabel="LineTotal"><MudNumericField Value="@context.LineTotal" ReadOnly="true" Margin="Margin.Dense" HideSpinButtons="true" Format="@PermanentSettingsData.CurrencyFormat" /></MudTd>
                    <MudTd DataLabel="Action"><MudIconButton OnClick="@(() => RemoveRow(context))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" /></MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd ColSpan="10" />
                    <MudTd>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddRow" Size="Size.Small" Style="white-space: nowrap;">
                            @Localizer("AddRow")
                        </MudButton>
                    </MudTd>
                </FooterContent>
            </MudTable>
        </MudHidden>
        @* End Desktop Table *@

    @* Mobile Datagrid *@
    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
        <MudDataGrid Class="ma-2" Elevation="3" T="JobOrderDtls" Items="@entTransactions" Bordered="true" Dense="true" RowClick="@RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("RepairList")</MudText>
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.RepairName" Title=@Localizer("Repair") />
                <PropertyColumn Property="x => x.Qty" Format="@PermanentSettingsData.QuantityFormat" Title=@Localizer("Quantity") />
                <PropertyColumn Property="x => x.LineTotal" Title=@Localizer("Total") Format="@PermanentSettingsData.CurrencyFormat" />
                <TemplateColumn Title=@Localizer("Action") CellClass="d-flex justify-end" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton OnClick="@(() => RemoveRow(@context.Item))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
             <PagerContent>
                 <MudDataGridPager T="JobOrderDtls" PageSizeOptions="new int[] { 25, 100 }" />
            </PagerContent>
        </MudDataGrid>
        <MudFab Style="position:fixed; bottom:80px; right:20px; z-index:100;" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Medium" OnClick="AddRow" />
    </MudHidden>
    @* End Mobile *@

    </EditForm>
</MudPaper>


@code {
    private async Task OpenVehicleHistory()
    {
        if (string.IsNullOrEmpty(jobOrder.PlateNo))
        {
            snackbar.Add(Localizer("PlateNoRequired"), Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["PlateNo"] = jobOrder.PlateNo };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<SubWindows.VehicleHistoryDialog>(Localizer("VehicleHistory"), parameters, options);
        await dialog.Result;
    }
}
