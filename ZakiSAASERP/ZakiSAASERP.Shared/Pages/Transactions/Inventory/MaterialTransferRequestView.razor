@page "/materialtransferrequest"
@inject IViewService api
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject ModelService Dialog
@inject Downloader Downloader
@using ZakiSAASERP.Models.Transactions.Inventory
@inject TabService TabService

<PageTitle>Zaki ERP | @Localizer("MaterialTransferRequest")</PageTitle>

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Row="true" Class="pa-2 ma-2">
        <MudText Typo="Typo.h5">@Localizer("MaterialTransferRequest")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>
    <EditForm Model="@hdr" OnValidSubmit="SaveOrUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Class="ma-2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1">
            <MudTabPanel Text="@Localizer("Header")">
                <MudGrid>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("VoucherNo")</MudText>
                        <MudTextField @ref="txtVoucherNo"
                                      OnKeyDown="@(e => Keydown(e, 1))"
                                      @bind-Value="hdr.VoucherNo"
                                      Variant="Variant.Outlined"
                                      Class="w-100" Margin="Margin.Dense"
                                      ReadOnly="@(IsAutoCode || IsLocked)"
                                      Adornment="IsAutoCode? Adornment.End: Adornment.None"
                                      AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                                      AdornmentColor="Color.Secondary" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("VoucherDate")</MudText>
                        <MudDatePicker @ref="txtVoucherDate" @bind-Date="hdr.VoucherDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="@IsLocked" />
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("FromBranch")</MudText>
                        <MudSelect T="int" Value="hdr.FK_FromBranchId" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            @foreach (var x in branches)
                            {
                                <MudSelectItem Value="@x.BranchId">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                     <MudItem xs="12" sm="3">
                        <MudText>@Localizer("ToBranch")</MudText>
                        <MudSelect T="int" Value="hdr.FK_ToBranchId" ValueChanged="OnToBranchChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@IsLocked">
                            @foreach (var x in branches)
                            {
                                <MudSelectItem Value="@x.BranchId">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("EnteredBy")</MudText>
                        <MudTextField @bind-Value="hdr.EnteredBy" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="false" />
                    </MudItem>
                   @if (hdr.Status == "Rejected" && !string.IsNullOrEmpty(hdr.RejectionReason))
                   {
                        <MudItem xs="12" sm="3">
                            <MudText>@Localizer("RejectionReason")</MudText>
                            <MudTextField Value="@hdr.RejectionReason" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText>@Localizer("RejectedBy")</MudText>
                            <MudTextField Value="@(hdr.RejectorUser?.UserName)" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="true" />
                        </MudItem>
                   }
                   @if (hdr.Status == "Approved")
                   {
                        <MudItem xs="12" sm="3">
                            <MudText>@Localizer("ApprovedBy")</MudText>
                            <MudTextField Value="@(hdr.ApproverUser?.UserName)" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="true" />
                        </MudItem>
                   }
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("ReferenceNo")</MudText>
                        <MudTextField @bind-Value="hdr.ReferenceNo" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="@IsLocked" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText>@Localizer("Remarks")</MudText>
                        <MudTextField @ref="txtRemarks" @bind-Value="hdr.Remarks" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="@IsLocked" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudTabPanel Text="@Localizer("Details")">
                     <MudGrid Class="pa-2">
                        <MudItem xs="12">
                            <MudText>@Localizer("Barcode")</MudText>
                            <MudTextField AutoFocus=true @ref="txtBarcode" Immediate="true" @bind-Value="transaction.Barcode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => MobileSearch())" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("ProductName") </MudText>
                            <MudTextField Immediate="true" @bind-Value="transaction.ItemName" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Store")</MudText>
                            <MudSelect T="int" Value="@transaction.FK_FromStoreId" ValueChanged="@((int v) => OnChangeStore(v, transaction))" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Disabled="@IsLocked">
                                @foreach(var store in stores.Where(x => x.FK_BranchId == hdr.FK_FromBranchId || x.FK_BranchId == null))
                                {
                                     <MudSelectItem Value="@((int)store.StoreId)">@store.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Unit")</MudText>
                            <MudSelect Value="transaction.FK_UnitId" ValueChanged="@((int v) => OnChangeUnit(v, transaction))" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsLocked">
                                @foreach (var item in unitlist)
                                {
                                    <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("QtyPerUnit")</MudText>
                            <MudNumericField @bind-Value="transaction.QtyPerUnit" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" ReadOnly="true" HideSpinButtons="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("CurrentQty")</MudText>
                            <MudNumericField @bind-Value="transaction.CurrentQty" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" ReadOnly="true" HideSpinButtons="true" />
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("Quantity")</MudText>
                            <MudNumericField id="mobile-qty" @bind-Value="transaction.Quantity" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" OnBlur="@(e => OnBlurQtEvent(transaction))" HideSpinButtons="true" ReadOnly="@IsLocked" />
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("Rate") </MudText>
                            <MudNumericField @bind-Value="transaction.Rate" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(e => TotalFindMethod())" ReadOnly="@IsLocked" />
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("Description") </MudText>
                            <MudTextField @bind-Value="transaction.Description" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@IsLocked" />
                        </MudItem>
                         <div class="d-flex justify-end">
                            <MudItem Class="fixed">
                                <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Large" OnClick="@(() => AddLineItem())" Disabled="@IsLocked" Label="Add" />
                            </MudItem>
                        </div>
                     </MudGrid>
                </MudTabPanel>
            </MudHidden>
        </MudTabs>
        
        <MudPaper Class="pa-2 ma-2" Elevation="3">
             <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText>@Localizer("TotalAmount")</MudText>
                    <MudText>
                        <b>@hdr.TotalAmount.ToString(strCurencyFormat)</b>
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText>@Localizer("TotalQty")</MudText>
                    <MudText>
                        <b>@TotalQty.ToString(strQuantityFormat)</b>
                    </MudText>
                </MudItem>
             </MudGrid>
             <MudHidden Breakpoint="Breakpoint.Xs">
                 <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
                    <MudButton Disabled="@(_processing || IsLocked)" Variant="Variant.Filled" StartIcon="@(hdr.MatTransReqId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)" Color="Color.Success" OnClick="SaveOrUpdate">
                        @(hdr.MatTransReqId == 0 ? Localizer("Save") : Localizer("Update"))
                    </MudButton>
                    <MudButton Disabled="@(_processing || hdr.MatTransReqId == 0 || IsLocked)" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" Color="Color.Error" OnClick="Delete">@Localizer("Cancel")</MudButton>
                    <MudButton Disabled="@_processing" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New")</MudButton>
                    <MudButton Disabled="@DisablePrintButton" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Color="Color.Primary" OnClick="PrintMethod">@Localizer("Print")</MudButton>
                    <MudButton Disabled="@DisablePrintButton" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DocumentScanner" Color="Color.Warning" OnClick="PrintPrviewMethod">@Localizer("Preview")</MudButton>
                    <MudButton Disabled="@_processing" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchMethod">@Localizer("Search")</MudButton>
                </MudStack>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                 <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@(hdr.MatTransReqId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)" Color="@(hdr.MatTransReqId == 0 ? Color.Success : Color.Info)" OnClick="SaveOrUpdate" Disabled="@(_processing || IsLocked)">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @(hdr.MatTransReqId == 0 ? Localizer("Save") : Localizer("Update"))
                        }
                    </MudButton>
                    <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                 </MudStack>
                 <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="@(() => SearchMethod())">@Localizer("Search") </MudButton>
                 </MudStack>
            </MudHidden>
       </MudPaper>

    </EditForm>
    @* Desktop Table *@
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudTable Class="ma-2" Elevation="3" Items="@dtls" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="400PX" OnRowClick="RowClickEvent" T="MaterialTransferRequestDtls">
            <ColGroup>
                <col style="width: 40px;" />
                <col style="width: 12%;" />
                <col style="width: 20%;" />
                <col style="width: 12%;" />
                <col style="width: 8%;" />
                <col style="width: 7%;" />
                <col style="width: 7%;" />
                <col style="width: 10%;" />
                <col style="width: 10%;" />
                <col style="width: 10%;" />
                <col style="width: 10%;" />
                <col style="width: 50px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>@Localizer("SL")</MudTh>
                <MudTh>@Localizer("Barcode")</MudTh>
                <MudTh>@Localizer("ProductName")</MudTh>
                <MudTh>@Localizer("Store")</MudTh>
                <MudTh>@Localizer("Unit")</MudTh>
                <MudTh>@Localizer("QtyPerUnit")</MudTh>
                <MudTh>@Localizer("CurrentQty")</MudTh>
                <MudTh>@Localizer("Quantity")</MudTh>
                @if (hdr.Status == "Approved")
                {
                    <MudTh>@Localizer("ApprovedQty")</MudTh>
                    <MudTh>@Localizer("ApproverComment")</MudTh>
                }
                <MudTh>@Localizer("Rate")</MudTh>
                <MudTh>@Localizer("Amount")</MudTh>
                <MudTh>@Localizer("Description")</MudTh>
                <MudTh>@Localizer("Action")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="SL"><MudTextField @bind-Value="@context.SL" Disabled="true" Margin="Margin.Dense" /></MudTd>
                <MudTd DataLabel="Barcode">
                    <MudTextField AutoFocus=true @ref="textField" Immediate="true" @bind-Value="@context.Barcode" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged(context.Barcode, context))"
                                  OnKeyDown="@(e => OnEnterMethod(e, context))" />
                </MudTd>
                <MudTd DataLabel="Product Name"><MudTextField Immediate="true" @bind-Value="@context.ItemName" Margin="Margin.Dense" /></MudTd>
                <MudTd DataLabel="Store">
                    <MudSelect T="int" Value="@context.FK_FromStoreId" ValueChanged="@((int v) => OnChangeStore(v, context))" Margin="Margin.Dense" Dense="true" Disabled="@IsLocked">
                        @foreach (var s in stores.Where(x => x.FK_BranchId == hdr.FK_FromBranchId || x.FK_BranchId == null))
                        {
                            <MudSelectItem Value="@s.StoreId">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="Unit">
                    @if (transaction == context)
                    {
                        <MudSelect T="int" Disabled="@(PermanentSettingsData.ItemSearchMode == 2 || IsLocked)" Value="@context.FK_UnitId" ValueChanged="@((int v) => OnChangeUnit(v, context))" Margin="Margin.Dense" Dense="true">
                            @foreach (var u in unitlist)
                            {
                                <MudSelectItem Value="@u.Id">@u.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField Value="@context.UnitName" ReadOnly="true" Margin="Margin.Dense" Underline="false" />
                    }
                </MudTd>
                <MudTd DataLabel="QtyPerUnit">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @bind-Value="@context.QtyPerUnit" ReadOnly="true" Margin="Margin.Dense"
                                     OnBlur="@(() => OnBlurQtyPerUnit(context))" />
                </MudTd>
                <MudTd DataLabel="Current Qty">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @bind-Value="@context.CurrentQty" ReadOnly="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="Quantity">
                    <MudNumericField id="@($"qty-{dtls.IndexOf(context)}")" HideSpinButtons="true" Format="@strQuantityFormat" @ref="txtQuantity" @bind-Value="@context.Quantity"
                                     Margin="Margin.Dense" OnBlur="@(() => OnBlurQtEvent(context))" OnKeyDown="@(e => TaskOnEnterMethod(e, 2, context))" ReadOnly="@IsLocked" />
                </MudTd>
                @if (hdr.Status == "Approved")
                {
                    <MudTd DataLabel="ApprovedQty">
                        <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @bind-Value="@context.ApprovedQuantity" ReadOnly="true" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="ApproverComment">
                        <MudTextField @bind-Value="@context.ApproverComment" ReadOnly="true" Margin="Margin.Dense" />
                    </MudTd>
                }
                <MudTd DataLabel="Rate">
                    <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtRate" @bind-Value="@context.Rate"
                                     Margin="Margin.Dense" OnBlur="@(() => OnBlurQtEvent(context))" OnKeyDown="@(e => TaskOnEnterMethod(e, 4, context))" ReadOnly="@IsLocked" />
                </MudTd>
                <MudTd DataLabel="Amount">
                    <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @bind-Value="@context.Amount" ReadOnly="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="Description">
                    <MudTextField @ref="txtDescription" @bind-Value="@context.Description" Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 5, context))" ReadOnly="@IsLocked" />
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudIconButton Disabled="@IsLocked" OnClick="@(() => DltTransaction(@context))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd colspan="11" Class="text-right"></MudTd>
                <MudTd>
                    <MudButton Disabled="@IsLocked" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddNewRow" Size="Size.Small" Style="white-space: nowrap;">
                        @Localizer("AddRow")
                    </MudButton>
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudHidden>
    @* Mobile DataGrid *@
    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
        <MudDataGrid Class="ma-2" Elevation="3" T="MaterialTransferRequestDtls" Items="@dtls.Where(x => !string.IsNullOrEmpty(x.ItemName) || !string.IsNullOrEmpty(x.Barcode))" Bordered="true" Dense="true" RowClick="@RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("ProductList")</MudText>
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Barcode" Title=@Localizer("Barcode") Sortable="false" />
                <PropertyColumn Property="x => x.ItemName" Title=@Localizer("Product") />
                <PropertyColumn Property="x => x.Quantity.ToString(strQuantityFormat)" Title=@Localizer("Quantity") Sortable="false" />
                <PropertyColumn Property="x => x.UnitName" Title=@Localizer("Unit") Sortable="false" />
                <PropertyColumn Property="x => x.Rate.ToString(strCurencyFormat)" Title=@Localizer("Rate") Sortable="false" />
                <TemplateColumn Title=@Localizer("Action") CellClass="d-flex justify-end" Sortable="false" Filterable="false">
                    <CellTemplate Context="cellContext">
                        <MudIconButton OnClick="@(() => DltTransaction(cellContext.Item))" Color="@Color.Default" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" Disabled="@IsLocked" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="MaterialTransferRequestDtls" PageSizeOptions="new int[] { 25, 100 }" />
            </PagerContent>
        </MudDataGrid>
        <MudFab Style="position:fixed; bottom:80px; right:20px; z-index:100;" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Medium" OnClick="@(() => AddLineItem())" Disabled="@IsLocked" />
    </MudHidden>
</MudPaper>


