@page "/stockadjustment"
@inject IViewService api
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject ModelService Dialog
@inject Downloader Downloader
@using ZakiSAASERP.Models.Transactions.Inventory
@inject TabService TabService

<PageTitle>Zaki ERP | @Localizer("StockAdjustment")</PageTitle>

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Row="true" Class="pa-2 ma-2">
        <MudText Typo="Typo.h5">@Localizer("StockAdjustment")</MudText>
        <MudSpacer />
        <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
    </MudStack>
    <EditForm Model="@hdr" OnValidSubmit="SaveOrUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Class="ma-2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1">
            <MudTabPanel Text="@Localizer("Header")">
                <MudGrid Class="pa-2">
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption">@Localizer("VoucherNo")</MudText>
                        <MudTextField @ref="txtVoucherNo"
                                      OnKeyDown="@(e => Keydown(e, 1))"
                                      @bind-Value="hdr.VoucherNo"
                                      Variant="Variant.Outlined"
                                      Class="w-100" Margin="Margin.Dense"
                                      ReadOnly="IsAutoCode && hdr.StockAdjId == 0"
                                      Adornment="IsAutoCode? Adornment.End: Adornment.None"
                                      AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                                      AdornmentColor="Color.Secondary" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption">@Localizer("VoucherDate")</MudText>
                        <MudDatePicker @ref="txtVoucherDate" @bind-Date="hdr.VoucherDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>


                    @* ReferenceNo - Commented for future use
                    <MudItem xs="12" sm="3">
                        <MudText>@Localizer("ReferenceNo")</MudText>
                        <MudTextField @ref="txtRefNo" @bind-Value="hdr.ReferenceNo" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>
                    *@
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption">@Localizer("Branch")</MudText>
                        <MudSelect T="int" Value="hdr.FK_BranchId" ValueChanged="OnBranchChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var x in branches)
                            {
                                <MudSelectItem Value="@x.BranchId">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                     <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption">@Localizer("EnteredBy")</MudText>
                        <MudTextField @bind-Value="hdr.EnteredBy" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="9">
                        <MudText Typo="Typo.caption">@Localizer("Remarks")</MudText>
                        <MudTextField @ref="txtRemarks" @bind-Value="hdr.Remarks" Variant="Variant.Outlined" Class="w-100" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudTabPanel Text="@Localizer("Details")">
                     <MudGrid Class="pa-2">
                        <MudItem xs="12">
                            <MudText>@Localizer("Barcode")</MudText>
                            <MudTextField AutoFocus=true @ref="txtBarcode" Immediate="true" @bind-Value="transaction.Barcode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => MobileSearch())" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("ProductName") </MudText>
                            <MudTextField Immediate="true" @bind-Value="transaction.ItemName" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Store")</MudText>
                            <MudSelect T="int" Value="@transaction.FK_StoreId" ValueChanged="@((int v) => OnChangeStore(v, transaction))" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                @foreach(var store in stores.Where(x => x.FK_BranchId == hdr.FK_BranchId || x.FK_BranchId == null))
                                {
                                     <MudSelectItem Value="@((int)store.StoreId)">@store.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("Unit")</MudText>
                            <MudSelect Value="transaction.FK_UnitId" ValueChanged="@((int v) => OnChangeUnit(v, transaction))" T="int" Immediate="true" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var item in unitlist)
                                {
                                    <MudSelectItem Value=@item.Id>@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("QtyPerUnit")</MudText>
                            <MudNumericField @bind-Value="transaction.QtyPerUnit" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" ReadOnly="true" HideSpinButtons="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>@Localizer("CurrentQty")</MudText>
                            <MudNumericField @bind-Value="transaction.CurrentQty" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" ReadOnly="true" HideSpinButtons="true" />
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("NewQty")</MudText>
                            <MudNumericField id="mobile-qty" @bind-Value="transaction.NewQty" Variant="Variant.Outlined" Format="@strQuantityFormat" Margin="Margin.Dense" OnBlur="@(e => OnBlurQtEvent(e))" HideSpinButtons="true" />
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("Cost") </MudText>
                            <MudNumericField @bind-Value="transaction.Rate" HideSpinButtons="true" Format="@strCurencyFormat" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(e => TotalFindMethod())" />
                        </MudItem>
                         <MudItem xs="12">
                            <MudText>@Localizer("Reason") </MudText>
                            <MudTextField @bind-Value="transaction.Description" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                         <div class="d-flex justify-end">
                            <MudItem Class="fixed">
                                <MudFab Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Large" OnClick="@(() => AddLineItem())">Add</MudFab>
                            </MudItem>
                        </div>
                     </MudGrid>
                </MudTabPanel>
            </MudHidden>
        </MudTabs>
        
        <MudPaper Class="pa-2 ma-2" Elevation="3">
             <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText>@Localizer("TotalAmount")</MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">
                        <b>@hdr.TotalAmount.ToString(strCurencyFormat)</b>
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText>@Localizer("TotalQty")</MudText>
                    <MudText Variant="Variant.Outlined" Margin="Margin.Dense">
                        <b>@TotalQty.ToString(strQuantityFormat)</b>
                    </MudText>
                </MudItem>
             </MudGrid>
             
             @* Desktop Buttons *@
             <MudHidden Breakpoint="Breakpoint.Xs">
                 <MudStack Row="true" Spacing="1" Class="ma-2">
                    <MudButton Disabled="@_processing" Variant="Variant.Filled" StartIcon="@(hdr.StockAdjId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)" Color="@(hdr.StockAdjId == 0 ? Color.Success : Color.Info)" OnClick="SaveOrUpdate">
                        @(hdr.StockAdjId == 0 ? Localizer("Save") : Localizer("Update"))
                    </MudButton>
                    <MudButton Disabled="@(_processing || hdr.StockAdjId == 0)" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete")</MudButton>
                    <MudButton Disabled="@_processing" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New")</MudButton>
                    <MudButton Disabled="@_processing" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="SearchMethod">@Localizer("Search")</MudButton>
                </MudStack>
            </MudHidden>

            @* Mobile Buttons *@
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                 <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@(hdr.StockAdjId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)" Color="@(hdr.StockAdjId == 0 ? Color.Success : Color.Info)" OnClick="SaveOrUpdate" Disabled="@_processing">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @(hdr.StockAdjId == 0 ? Localizer("Save") : Localizer("Update"))
                        }
                    </MudButton>
                    <MudButton Style="display:none" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete">@Localizer("Delete") </MudButton>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="NewClick">@Localizer("New") </MudButton>
                 </MudStack>
                 <MudStack Row="true" Spacing="1" Class=" ma-2">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Secondary" OnClick="@(() => SearchMethod())">@Localizer("Search") </MudButton>
                 </MudStack>
            </MudHidden>
       </MudPaper>

    </EditForm>
    @* Desktop Table *@
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudTable Class="ma-2" Elevation="3" Items="@dtls" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="400PX" OnRowClick="RowClickEvent" T="StockAdjustmentDtls">
            <ColGroup>
                <col style="width: 40px;" />
                <col style="width: 12%;" />
                <col style="width: 20%;" /> @* Widened Product Name column *@
                <col style="width: 12%;" />
                <col style="width: 8%;" />
                <col style="width: 7%;" />
                <col style="width: 7%;" />
                <col style="width: 7%;" />
                <col style="width: 7%;" />
                <col style="width: 7%;" />
                <col style="width: 15%;" />
                <col style="width: 50px;" />

            </ColGroup>
            <HeaderContent>
                <MudTh>@Localizer("SL")</MudTh>
                <MudTh>@Localizer("Barcode")</MudTh>
                <MudTh>@Localizer("ProductName")</MudTh>
                <MudTh>@Localizer("Store")</MudTh>
                <MudTh>@Localizer("Unit")</MudTh>
                <MudTh>@Localizer("QtyPerUnit")</MudTh>
                <MudTh>@Localizer("CurrentQty")</MudTh>
                <MudTh>@Localizer("AdjQty")</MudTh>
                <MudTh>@Localizer("NewQty")</MudTh>
                <MudTh>@Localizer("Cost")</MudTh>
                <MudTh>@Localizer("Reason")</MudTh>
                <MudTh>@Localizer("Action")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="SL"><MudTextField @bind-Value="@context.SL" Disabled="true" Margin="Margin.Dense" /></MudTd>
                <MudTd DataLabel="Barcode">
                    <MudTextField AutoFocus=true @ref="textField" Immediate="true" @bind-Value="@context.Barcode" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => BarcodeChanged(context.Barcode, context))"
                                  OnBlur="OnBarcodBlurEvent" OnKeyDown="OnEnterMethod" />
                </MudTd>
                <MudTd DataLabel="Product Name"><MudTextField Immediate="true" @bind-Value="@context.ItemName" Margin="Margin.Dense" /></MudTd>
                <MudTd DataLabel="Store">
                    <MudSelect T="int" Value="@context.FK_StoreId" ValueChanged="@((int v) => OnChangeStore(v, context))" Margin="Margin.Dense" Dense="true">
                        @foreach (var s in stores.Where(x => x.FK_BranchId == hdr.FK_BranchId || x.FK_BranchId == null))
                        {
                            <MudSelectItem Value="@s.StoreId">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="Unit">
                    @if (transaction == context)
                    {
                        <MudSelect T="int" Disabled="@(PermanentSettingsData.ItemSearchMode == 2)" Value="@context.FK_UnitId" ValueChanged="@((int v) => OnChangeUnit(v, context))" Margin="Margin.Dense" Dense="true">
                            @foreach (var u in unitlist)
                            {
                                <MudSelectItem Value="@u.Id">@u.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField Value="@context.UnitName" ReadOnly="true" Margin="Margin.Dense" DisableUnderLine="true" />
                    }
                </MudTd>
                <MudTd DataLabel="QtyPerUnit">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @bind-Value="@context.QtyPerUnit" ReadOnly="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="CurrentQty">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @bind-Value="@context.CurrentQty" ReadOnly="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="AdjQty">
                    <MudNumericField HideSpinButtons="true" Format="@strQuantityFormat" @bind-Value="@context.Quantity" ReadOnly="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="NewQty">
                    <MudNumericField id="@($"qty-{dtls.IndexOf(context)}")" HideSpinButtons="true" Format="@strQuantityFormat" @ref="txtQuantity" @bind-Value="@context.NewQty"
                                     Margin="Margin.Dense" OnBlur="OnBlurQtEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 2))" />
                </MudTd>
                <MudTd DataLabel="Cost">
                    <MudNumericField HideSpinButtons="true" Format="@strCurencyFormat" @ref="txtRate" @bind-Value="@context.Rate"
                                     Margin="Margin.Dense" OnBlur="OnBlurQtEvent" OnKeyDown="@(e => TaskOnEnterMethod(e, 4))" />
                </MudTd>
                <MudTd DataLabel="Reason">
                    <MudTextField @ref="txtDescription" @bind-Value="@context.Description" Margin="Margin.Dense" OnKeyDown="@(e => TaskOnEnterMethod(e, 5))" />
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudIconButton OnClick="@(() => DltTransaction(@context))" Color="@Color.Error" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd ColSpan="11" Class="text-right"></MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddNewRow" Size="Size.Small" Style="white-space: nowrap;">
                        @Localizer("AddRow")
                    </MudButton>
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudHidden>
    @* Mobile DataGrid *@
    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
        <MudDataGrid Class="ma-2" Elevation="3" T="StockAdjustmentDtls" Items="@dtls.Where(x => !string.IsNullOrEmpty(x.ItemName))" QuickFilter="@_quickFilter" Bordered="true" Dense="true" RowClick="@RowClicked">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer("ProductList")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Barcode" Title=@Localizer("Barcode") Sortable="false" />
                <PropertyColumn Property="x => x.ItemName" Title=@Localizer("Product") />
                <PropertyColumn Property="x => x.NewQty.ToString(strQuantityFormat)" Title=@Localizer("NewQty") Sortable="false" />
                <PropertyColumn Property="x => x.UnitName" Title=@Localizer("Unit") Sortable="false" />
                <PropertyColumn Property="x => x.Rate.ToString(strCurencyFormat)" Title=@Localizer("Cost") Sortable="false" />
                <TemplateColumn Title=@Localizer("Action") CellClass="d-flex justify-end" Sortable="false" Filterable="false">
                    <CellTemplate Context="cellContext">
                        <MudIconButton OnClick="@(() => DltTransaction(cellContext.Item))" Color="@Color.Default" Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="StockAdjustmentDtls" PageSizeOptions="new int[] { 25, 100 }" />
            </PagerContent>
        </MudDataGrid>
        <MudFab Style="position:fixed; bottom:80px; right:20px; z-index:100;" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Medium" OnClick="@(() => AddNewMobileEntry())" />
    </MudHidden>
</MudPaper>



