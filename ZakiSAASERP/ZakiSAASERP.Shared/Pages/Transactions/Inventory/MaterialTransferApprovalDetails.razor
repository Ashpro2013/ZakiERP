@using ZakiSAASERP.Models.Transactions.Inventory
@using ZakiSAASERP.Models.Masters
@inject IViewService api
@inject ISnackbar snackbar
@inject IDialogService DialogService

<style>
    .compact-table .mud-table-cell {
        padding: 4px 8px !important;
    }
    .compact-input .mud-input-control {
        margin-top: 0 !important;
    }
    .compact-input input {
        padding-top: 4px !important;
        padding-bottom: 4px !important;
        height: auto !important;
        font-size: 0.85rem !important;
    }
    .compact-select .mud-input-control {
        margin-top: 0 !important;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @if (isLoading)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-flex mx-auto my-4"/>
            }
            else if (request is not null)
            {
                <MudGrid>
                    <MudItem xs="12" md="12">
                        <MudCard Elevation="0" Outlined="true" Class="mb-4">
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Value="@request.VoucherNo" Label="@ArabicLocalization.Localizer("VoucherNo")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Value="@(request.VoucherDate?.ToString("dd-MM-yyyy"))" Label="@ArabicLocalization.Localizer("Date")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Value="@(request.EnteredBy ?? "")" Label="@ArabicLocalization.Localizer("RequestedBy")" ReadOnly="true"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Value="@request.Status" Label="@ArabicLocalization.Localizer("Status")" ReadOnly="true"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Class="@(request.Status == "Approved" ? "text-success" : request.Status == "Rejected" ? "text-danger" : "text-warning")" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Value="@GetBranchName(request.FK_FromBranchId)" Label="@ArabicLocalization.Localizer("FromBrach")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Value="@GetBranchName(request.FK_ToBranchId)" Label="@ArabicLocalization.Localizer("ToBranch")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField Value="@request.Remarks" Label="@ArabicLocalization.Localizer("Remarks")" ReadOnly="true" 
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" 
                                                      Class="resizable-textarea" />
                                    </MudItem>
                                    @if (request.Status == "Approved" && request.ApproverUser is not null)
                                    {
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Value="@request.ApproverUser.UserName" Label="@ArabicLocalization.Localizer("ApprovedBy")" ReadOnly="true"
                                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                    }
                                    @if (request.Status == "Rejected" && request.RejectorUser is not null)
                                    {
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Value="@request.RejectorUser.UserName" Label="@ArabicLocalization.Localizer("RejectedBy")" ReadOnly="true"
                                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        @if (!string.IsNullOrEmpty(request.RejectionReason))
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudTextField Value="@request.RejectionReason" Label="@ArabicLocalization.Localizer("RejectionReason")" ReadOnly="true"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                            </MudItem>
                                        }
                                    }
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <style>
                        .resizable-textarea .mud-input-slot {
                            resize: vertical !important;
                            max-height: 200px;
                            overflow-y: auto !important;
                        }
                    </style>

                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudItem xs="12">
                            <MudTable Items="@request.MaterialTransferRequestDetails" T="MaterialTransferRequestDtls" 
                                      Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0" 
                                      FixedHeader="true" FixedFooter="true" Height="450px" Class="compact-table">
                                <ColGroup>
                                    <col style="width: 15%;" /> <!-- Item Name -->
                                    <col style="width: 11%;" /> <!-- Barcode -->
                                    <col style="width: 4%;" />  <!-- Unit -->
                                    <col style="width: 5%;" />  <!-- Rate -->
                                    <col style="width: 8%;" />  <!-- Req Qty -->
                                    @if (request.Status == "Opened")
                                    {
                                        <col style="width: 5%;" />  <!-- Stock -->
                                    }
                                    <col style="width: 7%;" />  <!-- Appr Qty -->
                                    <col style="width: 6%;" />  <!-- Appr Amt -->
                                    <col style="width: 10%;" /> <!-- Appr Comment -->
                                    <col style="width: 11%;" /> <!-- From Store -->
                                    <col style="width: 18%;" /> <!-- To Store -->
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@ArabicLocalization.Localizer("ItemName")</MudTh>
                                    <MudTh>@ArabicLocalization.Localizer("Barcode")</MudTh>
                                    <MudTh>@ArabicLocalization.Localizer("Unit")</MudTh>
                                    <MudTh>@ArabicLocalization.Localizer("Rate")</MudTh>
                                    <MudTh>@ArabicLocalization.Localizer("RequestedQty")</MudTh>
                                    @if (request.Status == "Opened")
                                    {
                                        <MudTh>@ArabicLocalization.Localizer("SupplierStock")</MudTh>
                                    }
                                    <MudTh>@ArabicLocalization.Localizer("ApprovedQty")</MudTh>
                                    <MudTh>@ArabicLocalization.Localizer("Amount")</MudTh>
                                    <MudTh>@ArabicLocalization.Localizer("ApproverComment")</MudTh>
                                    <MudTh>
                                        @ArabicLocalization.Localizer("FromStore") 
                                        @if (request is not null)
                                        {
                                            <span style="font-size: 0.75rem; color: #666;">(@GetBranchName(request.FK_FromBranchId))</span>
                                        }
                                    </MudTh>
                                    <MudTh>
                                        @ArabicLocalization.Localizer("ToStore")
                                        @if (request is not null)
                                        {
                                            <span style="font-size: 0.75rem; color: #666;">(@GetBranchName(request.FK_ToBranchId))</span>
                                        }
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ItemName">
                                        <span style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;" title="@context.ItemName">
                                            @context.ItemName
                                        </span>
                                    </MudTd>
                                    <MudTd DataLabel="Barcode">
                                        <span class="text-muted">@context.Barcode</span>
                                    </MudTd>
                                    <MudTd DataLabel="Unit">@context.UnitName</MudTd>
                                    <MudTd DataLabel="Rate" Style="text-align:right">
                                        <span style="font-weight: 500;">@PermanentSettingsData.FormatCurrency(context.Rate)</span>
                                    </MudTd>
                                    <MudTd DataLabel="RequestedQty" Style="text-align:right">@context.Quantity</MudTd>
                                    @if (request.Status == "Opened")
                                    {
                                        <MudTd DataLabel="SupplierStock" Style="text-align:right">
                                            @{
                                                // Show stock from ToStore (destination/receiving store) divided by QtyPerUnit
                                                var stock = GetCurrentStock(context.FK_ItemId, context.FK_ToStoreId, context.QtyPerUnit);
                                                var isLow = context.ApprovedQuantity > stock;
                                            }
                                            <span style="color: @(isLow ? "red" : "inherit"); font-weight: @(isLow ? "600" : "500");">
                                                @stock
                                             </span>
                                        </MudTd>
                                    }
                                    <MudTd DataLabel="ApprovedQty">
                                        @if (request.Status == "Approved" || request.Status == "Rejected")
                                        {
                                            @context.ApprovedQuantity
                                        }
                                        else
                                        {
                                            var currentIndex = request.MaterialTransferRequestDetails.IndexOf(context);
                                            <MudNumericField Value="@context.ApprovedQuantity" 
                                                             ValueChanged="@((decimal val) => OnApprovedQuantityChanged(context, val))"
                                                             Min="0" Max="@context.Quantity" 
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"
                                                             id="@($"qty-{currentIndex}")"
                                                             @onkeydown="@(async (e) => await HandleKeyDown(e, currentIndex))"
                                                             Class="centered-input" />
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="ApprovedAmount">
                                        <span style="font-weight: 500;">@PermanentSettingsData.FormatCurrency(context.ApprovedAmount)</span>
                                    </MudTd>
                                    <MudTd DataLabel="Approver Comment">
                                        <MudTextField @bind-Value="@context.ApproverComment" Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd DataLabel="FromStore">
                                        <span>@GetStoreName(context.FK_FromStoreId) </span>
                                    </MudTd>
                                    <MudTd DataLabel="ToStore">
                                        @if (request.Status == "Approved" || request.Status == "Rejected")
                                        {
                                            <span>@GetStoreName(context.FK_ToStoreId ?? 0) (@GetBranchName(request.FK_ToBranchId))</span>
                                        }
                                        else
                                        {
                                            <MudSelect T="int?" Value="@context.FK_ToStoreId"
                                                       ValueChanged="@((int? val) => OnToStoreChanged(context, val))"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter"
                                                       Class="compact-select" Style="margin:0;">
                                                @foreach (var store in GetStoresForBranch(request.FK_ToBranchId))
                                                {
                                                    <MudSelectItem Value="@((int?)store.StoreId)">@store.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                    </MudHidden>

                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                        <MudItem xs="12">
                            @if (isMobileEditing && selectedMobileItem is not null)
                            {
                                 <MudCard Elevation="3" Class="pa-2">
                                     <MudCardHeader>
                                         <CardHeaderContent>
                                             <MudText Typo="Typo.h6">@selectedMobileItem.ItemName</MudText>
                                             <MudText Typo="Typo.caption" Color="Color.Secondary">@selectedMobileItem.Barcode</MudText>
                                         </CardHeaderContent>
                                         <CardHeaderActions>
                                             <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="ClearMobileSelection" />
                                         </CardHeaderActions>
                                     </MudCardHeader>
                                     <MudCardContent>
                                         <MudGrid>
                                             <MudItem xs="6">
                                                 <MudText Typo="Typo.caption">@ArabicLocalization.Localizer("RequestedQty")</MudText>
                                                  <MudText Typo="Typo.h6">@PermanentSettingsData.FormatQuantity(selectedMobileItem.Quantity)</MudText>
                                             </MudItem>
                                             @if (request.Status == "Opened")
                                             {
                                                 <MudItem xs="6">
                                                      <MudText Typo="Typo.caption">@ArabicLocalization.Localizer("SupplierStock")</MudText>
                                                      @{
                                                          var stock = GetCurrentStock(selectedMobileItem.FK_ItemId, selectedMobileItem.FK_ToStoreId, selectedMobileItem.QtyPerUnit);
                                                      }
                                                      <MudText Typo="Typo.h6" Color="@(selectedMobileItem.ApprovedQuantity > stock ? Color.Error : Color.Inherit)">
                                                          @PermanentSettingsData.FormatQuantity(stock)
                                                      </MudText>
                                                 </MudItem>
                                             }
                                             
                                             <MudItem xs="12" Class="mt-2">
                                                 <MudNumericField Value="@selectedMobileItem.ApprovedQuantity" 
                                                                  ValueChanged="@((decimal val) => OnApprovedQuantityChanged(selectedMobileItem, val))"
                                                                  Label="@ArabicLocalization.Localizer("ApprovedQty")"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="@selectedMobileItem.Quantity" 
                                                                  Disabled="@(request.Status != "Opened")" />
                                             </MudItem>
                                             
                                              <MudItem xs="12">
                                                  @if (request.Status != "Opened")
                                                  {
                                                      <MudTextField Value="@GetStoreName(selectedMobileItem.FK_ToStoreId ?? 0)" Label="@ArabicLocalization.Localizer("ToStore")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                  }
                                                  else
                                                  {
                                                      <MudSelect T="int?" Value="@selectedMobileItem.FK_ToStoreId"
                                                                 ValueChanged="@((int? val) => OnToStoreChanged(selectedMobileItem, val))"
                                                                 Label="@ArabicLocalization.Localizer("ToStore")"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                                          @foreach (var store in GetStoresForBranch(request.FK_ToBranchId))
                                                          {
                                                              <MudSelectItem Value="@((int?)store.StoreId)">@store.Name</MudSelectItem>
                                                          }
                                                      </MudSelect>
                                                  }
                                              </MudItem>

                                             <MudItem xs="12">
                                                 <MudTextField @bind-Value="@selectedMobileItem.ApproverComment" Label="@ArabicLocalization.Localizer("ApproverComment")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(request.Status != "Opened")" />
                                             </MudItem>
                                         </MudGrid>
                                     </MudCardContent>
                                     <MudCardActions>
                                         <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClearMobileSelection" FullWidth="true">@ArabicLocalization.Localizer("Done")</MudButton>
                                     </MudCardActions>
                                 </MudCard>
                            }
                            else
                            {
                                <MudTable Items="@request.MaterialTransferRequestDetails" T="MaterialTransferRequestDtls" 
                                          Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0" 
                                          OnRowClick="@((TableRowClickEventArgs<MaterialTransferRequestDtls> e) => SelectMobileItem(e.Item))">
                                    <HeaderContent>
                                        <MudTh>@ArabicLocalization.Localizer("Product")</MudTh>
                                        <MudTh>@ArabicLocalization.Localizer("Req")</MudTh>
                                        <MudTh>@ArabicLocalization.Localizer("Appr")</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Product">
                                            <div class="d-flex flex-column">
                                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.ItemName</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">@context.Barcode</MudText>
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="Req">@context.Quantity.ToString("0.##")</MudTd>
                                        <MudTd DataLabel="Appr">
                                            <span style="font-weight:600; color: @(context.ApprovedQuantity < context.Quantity ? "orange" : "green")">
                                                @context.ApprovedQuantity.ToString("0.##")
                                            </span>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudItem>
                    </MudHidden>
                    

                </MudGrid>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudGrid Class="w-100 ma-0" Spacing="0">
            <MudItem xs="12" Class="mb-2">
                <MudPaper Class="pa-2 grey lighten-4" Elevation="0">
                    <MudGrid>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption">@ArabicLocalization.Localizer("RequestedQty")</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @PermanentSettingsData.FormatQuantity(request.MaterialTransferRequestDetails.Sum(x => x.Quantity))
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption">@ArabicLocalization.Localizer("RequestedAmount")</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @PermanentSettingsData.FormatCurrency(request.TotalAmount)
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption">@ArabicLocalization.Localizer("ApprovedQty")</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @PermanentSettingsData.FormatQuantity(request.MaterialTransferRequestDetails.Sum(x => x.ApprovedQuantity))
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption">@ArabicLocalization.Localizer("TotalApprovedAmount")</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @PermanentSettingsData.FormatCurrency(request.MaterialTransferRequestDetails.Sum(x => x.ApprovedAmount))
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-end gap-2">
                <MudButton OnClick="Close" Variant="Variant.Outlined" Color="Color.Default">@ArabicLocalization.Localizer("Close")</MudButton>
                @if (request is not null && (request.Status == "Approved" || request.Status == "Rejected"))
                {
                    <MudButton OnClick="PrintMethod" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print">
                        @ArabicLocalization.Localizer("Print")
                    </MudButton>
                    <MudButton OnClick="PrintPrviewMethod" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.DocumentScanner">
                        @ArabicLocalization.Localizer("Preview")
                    </MudButton>
                }
                @if (request is not null && request.Status == "Opened")
                {
                    <MudButton OnClick="RejectRequest" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" Disabled="@_isSaving">
                        @ArabicLocalization.Localizer("Reject")
                    </MudButton>
                    <MudButton OnClick="ApproveRequest" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@ArabicLocalization.Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @ArabicLocalization.Localizer("Approve")
                        }
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>


