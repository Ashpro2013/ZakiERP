@page "/customerstatement"
@using ZakiSAASERP.Shared.Pages.Component
@using ZakiSAASERP.Shared.SubWindows
@inject IViewService api;
@inject Downloader downloader
@inject ModelService Dialog
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TabService TabService

<PageTitle>@AppData.OEMAgency | @Localizer("Customer Statement")</PageTitle>

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Customer Statement")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Date Range *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("FromDate")</MudText>
                <MudDatePicker @bind-Date="FromDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("ToDate")</MudText>
                <MudDatePicker @bind-Date="ToDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* Branch *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Branch")</MudText>
                <MudSelect T="int" @bind-Value="BranchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Customer *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Customer")</MudText>
                <MudStack Row>
                    <MudTextField @bind-Value="CustomerName" Variant="Variant.Outlined"
                                  Class="w-100" Margin="Margin.Dense" Clearable="true" Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="PartySearchMethod" ReadOnly="true" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => { CustomerId = 0; CustomerName = ""; })" Disabled="@(CustomerId == 0)" />
                </MudStack>
            </MudItem>

        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudGrid Class="ma-2">
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Receipt" Color="Color.Success" OnClick="ReportGenerate">@Localizer("Generate")</MudButton>
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.TableView" Color="Color.Primary" OnClick="ExcelExportMethod">@Localizer("Excel")</MudButton>
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" OnClick="PDFExportMethod">@Localizer("PDF")</MudButton>
            <MudButton Style="margin:5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudGrid>
    </MudCardActions>
</MudCard>

@if(IsLoaded)
{
    @* Display Summary *@
    <MudGrid Class="ma-2">
         <MudItem xs="12" sm="3">
             <MudText><b>@Localizer("Opening Balance"):</b> @PermanentSettingsData.FormatCurrency(result?.OpeningBalance)</MudText>
         </MudItem>
          <MudItem xs="12" sm="3">
             <MudText><b>@Localizer("Total Debit"):</b> @PermanentSettingsData.FormatCurrency(result?.TotalDebit)</MudText>
         </MudItem>
          <MudItem xs="12" sm="3">
             <MudText><b>@Localizer("Total Credit"):</b> @PermanentSettingsData.FormatCurrency(result?.TotalCredit)</MudText>
         </MudItem>
          <MudItem xs="12" sm="3">
             <MudText><b>@Localizer("Closing Balance"):</b> @PermanentSettingsData.FormatCurrency(result?.ClosingBalance)</MudText>
         </MudItem>
    </MudGrid>

    <MudTable T="CustomerStatementReportDtls" Items="@result?.Details" Hover="true" Striped="true" Dense="true" Class="ma-2" Elevation="3" FixedHeader="true" Height="400px" OnRowClick="RowClickEvent" RowStyle="cursor: pointer;">
        <HeaderContent>
            <MudTh>@Localizer("SL")</MudTh>
            <MudTh>@Localizer("Date")</MudTh>
            <MudTh>@Localizer("Voucher No")</MudTh>
            <MudTh>@Localizer("Ref No")</MudTh>
            <MudTh>@Localizer("Type")</MudTh>
            <MudTh>@Localizer("Narration")</MudTh>
            <MudTh Class="text-right">@Localizer("Debit")</MudTh>
            <MudTh Class="text-right">@Localizer("Credit")</MudTh>
            <MudTh Class="text-right">@Localizer("Balance")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SL">@context.SL</MudTd>
            <MudTd DataLabel="Date">@context.Date</MudTd>
            <MudTd DataLabel="Voucher No">@context.VoucherNo</MudTd>
            <MudTd DataLabel="Ref No">@context.RefNo</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Narration">@context.Description</MudTd>
            <MudTd DataLabel="Debit" Class="text-right">@((context.Debit ?? 0) == 0 ? "-" : PermanentSettingsData.FormatCurrency(context.Debit))</MudTd>
            <MudTd DataLabel="Credit" Class="text-right">@((context.Credit ?? 0) == 0 ? "-" : PermanentSettingsData.FormatCurrency(context.Credit))</MudTd>
            <MudTd DataLabel="Balance" Class="text-right">@PermanentSettingsData.FormatCurrency(context.Balance)</MudTd>
        </RowTemplate>
    </MudTable>
}

<ReportView pdfData="@pdfData" />
