@page "/stockreport"
@using ZakiSAASERP.Shared.Pages.Component
@inject IViewService api;
@inject Downloader downloader
@inject ModelService Dialog
@inject IJSRuntime JS
@inject TabService TabService
@* Title*@
<PageTitle>@AppData.OEMAgency | Stock Report</PageTitle>
@*End Title*@

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Stock Report")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("As On Date")</MudText>
                <MudDatePicker @bind-Date="req.Date" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("Branch")</MudText>
                <MudSelect T="int" @bind-Value="req.BranchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @if (branchList is not null)
                    {
                        @foreach (var branch in branchList)
                        {
                            <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("Store")</MudText>
                <MudSelect T="int" @bind-Value="req.StoreId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @if (storeList is not null)
                    {
                        @foreach (var store in storeList)
                        {
                            <MudSelectItem Value="@store.Id">@store.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("Category")</MudText>
                <MudSelect T="int" @bind-Value="req.CategoryId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @if (categoryList is not null)
                    {
                        @foreach (var category in categoryList)
                        {
                            <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText>@Localizer("Brand")</MudText>
                <MudSelect T="int" @bind-Value="req.BrandId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @if (brandList is not null)
                    {
                        @foreach (var brand in brandList)
                        {
                            <MudSelectItem Value="@brand.Id">@brand.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudRadioGroup @bind-Value="req.ReportType">
                    <MudRadio Value="0" Color="Color.Primary">All</MudRadio>
                    <MudRadio Value="1" Color="Color.Tertiary">Positive</MudRadio>
                    <MudRadio Value="2" Color="Color.Secondary">Negative</MudRadio>
                    <MudRadio Value="3" Color="Color.Warning">Zero</MudRadio>
                </MudRadioGroup>
            </MudItem>
        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="ReportGenerate">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="ExcelExportMethod">@Localizer("Excel")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Error" OnClick="PDFExportMethod">@Localizer("PDF")</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>
@if (IsLoading)
{
    <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
}
@if (pdfData is not null)
{
    <ReportView pdfData="@pdfData" />
}

