@page "/customerpendinginvoice"
@using ZakiSAASERP.Models.DTO
@using ZakiSAASERP.Shared
@using FileDownloader
@inject TabService TabService

<PageTitle>@Localizer("Customer Pending Invoices")</PageTitle>

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
             <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Customer Pending Invoices")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Filters *@
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@Localizer("FromDate")" @bind-Date="fromDate" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@Localizer("ToDate")" @bind-Date="toDate" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int" Label="@Localizer("Branch")" @bind-Value="branchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var item in branchList)
                    {
                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="customerName" Label="@Localizer("Customer")" Variant="Variant.Outlined" Margin="Margin.Dense"
                              OnAdornmentClick="CustomerSearchMethod" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" OnClearButtonClick="ClearCustomer" />
            </MudItem>
        </MudGrid>
    </MudCardContent>

    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DetailSearch" StartIcon="@Icons.Material.Filled.Search">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Print" StartIcon="@Icons.Material.Filled.Print">@Localizer("Print")</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="Preview" StartIcon="@Icons.Material.Filled.Preview">@Localizer("Preview")</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ExportExcel" StartIcon="@Icons.Material.Filled.TableView">@Localizer("Excel")</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>

@if (reportData.Any())
{
    <MudGrid Class="ma-2">
        <MudItem xs="12" sm="4">
            <MudText><b>@Localizer("Total Invoice Amount"):</b> @PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.NetAmount))</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText><b>@Localizer("Total Paid Amount"):</b> @PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.PaidAmount))</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText><b>@Localizer("Total Pending Amount"):</b> @PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.Balance))</MudText>
        </MudItem>
    </MudGrid>
}

@if (reportData.Any())
{
    @* Result Grid *@
    <MudTable T="CustomerPendingInvoiceDTO" Items="@reportData" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="500px" Class="ma-2" Elevation="3">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>@Localizer("Date")</MudTh>
            <MudTh>@Localizer("VoucherNo")</MudTh>
            <MudTh>@Localizer("Narration")</MudTh>
            <MudTh>@Localizer("Invoice Amount")</MudTh>
            <MudTh>@Localizer("Paid Amount")</MudTh>
            <MudTh>@Localizer("Return Amount")</MudTh>
            <MudTh>@Localizer("Discount")</MudTh>
            <MudTh>@Localizer("Balance")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SL">@context.SL</MudTd>
            <MudTd DataLabel="Date">@(context.Date.HasValue? context.Date.Value.ToString("dd/MM/yyyy") : "")</MudTd>
            <MudTd DataLabel="VoucherNo">@context.VoucherNo</MudTd>
            <MudTd DataLabel="Narration">@context.Narration</MudTd>
            <MudTd DataLabel="Invoice Amount" Style="color:green">@((context.NetAmount == 0) ? "" : PermanentSettingsData.FormatCurrency(context.NetAmount))</MudTd>
            <MudTd DataLabel="Paid Amount" Style="color:red">@((context.PaidAmount == 0) ? "" : PermanentSettingsData.FormatCurrency(context.PaidAmount))</MudTd>
            <MudTd DataLabel="Return Amount" Style="color:blue">@((context.ReturnAmount == 0) ? "" : PermanentSettingsData.FormatCurrency(context.ReturnAmount))</MudTd>
            <MudTd DataLabel="Discount" Style="color:orange">@((context.Discount == 0) ? "" : PermanentSettingsData.FormatCurrency(context.Discount))</MudTd>
            <MudTd DataLabel="Balance" Style="font-weight:bold">@PermanentSettingsData.FormatCurrency(context.Balance)</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd ColSpan="4" Style="font-weight:bold; text-align:right">@Localizer("Total")</MudTd>
            <MudTd Style="font-weight:bold; color:green">@PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.NetAmount))</MudTd>
            <MudTd Style="font-weight:bold; color:red">@PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.PaidAmount))</MudTd>
            <MudTd Style="font-weight:bold; color:blue">@PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.ReturnAmount))</MudTd>
            <MudTd Style="font-weight:bold; color:orange">@PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.Discount))</MudTd>
            <MudTd Style="font-weight:bold">@PermanentSettingsData.FormatCurrency(reportData.Sum(x => x.Balance))</MudTd>
        </FooterContent>

    </MudTable>
}
