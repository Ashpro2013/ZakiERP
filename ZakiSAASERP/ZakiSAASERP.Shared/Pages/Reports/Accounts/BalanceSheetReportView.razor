@page "/balancesheetreport"
@using ZakiSAASERP.Shared.Pages.Component
@using ZakiSAASERP.Shared.SubWindows
@inject IViewService api;
@inject Downloader downloader
@inject ModelService Dialog
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TabService TabService
<PageTitle>@AppData.OEMAgency | @Localizer("Balance Sheet Report")</PageTitle>

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
           <MudStack Row="true">
                <MudText Typo="Typo.h5">@Localizer("Balance Sheet Report")</MudText>
                <MudSpacer />
                <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
           </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Date Range *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("FromDate")</MudText>
                <MudDatePicker @bind-Date="FromDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("ToDate") ("As On")</MudText>
                <MudDatePicker @bind-Date="ToDate" DateFormat="dd-MM-yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* Branch *@
            <MudItem xs="12" sm="3">
                <MudText>@Localizer("Branch")</MudText>
                <MudSelect T="int" @bind-Value="BranchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Receipt" Color="Color.Success" OnClick="ReportGenerate">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.TableView" Color="Color.Primary" OnClick="ExcelExportMethod">@Localizer("Excel")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" OnClick="PDFExportMethod">@Localizer("PDF")</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudStack>
    </MudCardActions>
    <MudOverlay Visible="IsLoading" DarkBackground="true" Absolute="true">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    </MudOverlay>
</MudCard>

@if (reportData.Any())
{
    <MudTable Items="@reportData" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="500px" Class="ma-2" Elevation="3">
        <HeaderContent>
            <MudTh>@Localizer("Liabilities / Capital")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Amount")</MudTh>
            <MudTh>@Localizer("Assets")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Amount")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Liabilities">
                @if (context.LiabilityAccount == "Total" || context.LiabilityAccount == "LIABILITIES" || context.LiabilityAccount == "CAPITAL ACCOUNT" || context.LiabilityAccount == "Net Profit" || context.LiabilityAccount == "Net Loss")
                {
                    <b>@context.LiabilityAccount</b>
                }
                else
                {
                    @context.LiabilityAccount
                }
            </MudTd>
            <MudTd DataLabel="Amount" Style="text-align:right">
                @if (context.LiabilityAccount == "Total")
                {
                    <b>@context.LiabilityAmount</b>
                }
                else
                {
                    @context.LiabilityAmount
                }
            </MudTd>
            <MudTd DataLabel="Assets">
                @if (context.AssetAccount == "Total" || context.AssetAccount == "ASSETS")
                {
                    <b>@context.AssetAccount</b>
                }
                else
                {
                    @context.AssetAccount
                }
            </MudTd>
            <MudTd DataLabel="Amount" Style="text-align:right">
                @if (context.AssetAccount == "Total")
                {
                    <b>@context.AssetAmount</b>
                }
                else
                {
                    @context.AssetAmount
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<ReportView pdfData="@pdfData" />
