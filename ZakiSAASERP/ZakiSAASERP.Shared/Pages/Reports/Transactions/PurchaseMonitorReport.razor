@page "/purchaseMonitorReport"
@using ZakiSAASERP.Shared.Layout

@using ZakiSAASERP.Shared.SubWindows
@inject IViewService api;
@inject Downloader downloader
@inject ModelService Dialog
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TabService TabService


<PageTitle>@Localizer("Purchase Monitor Report")</PageTitle>

<MudCard Elevation="3" Class="ma-2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true">
                <MudText Typo="Typo.h6">@Localizer("Purchase Monitor Report")</MudText>
                <MudSpacer />
                 <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            @* Date Range *@
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@Localizer("From Date")" @bind-Date="fromDate" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@Localizer("To Date")" @bind-Date="toDate" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* Branch *@
             <MudItem xs="12" sm="3">
                <MudSelect T="int" Label="@Localizer("Branch")" @bind-Value="branchId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var branch in branchList)
                    {
                        <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="supplierName" Label="@Localizer("Supplier")" Variant="Variant.Outlined"
                              Class="w-100" Margin="Margin.Dense" Adornment="Adornment.End"
                              AdornmentIcon="@(supplierId > 0 ? Icons.Material.Filled.Close : Icons.Material.Filled.Search)"
                              OnAdornmentClick="@(async () => { if (supplierId > 0) { supplierId = 0; supplierName = ""; } else { await SupplierSearchMethod(); } })" 
                              ReadOnly="true" />
            </MudItem>

            @* Status *@
             <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="@Localizer("Status")" @bind-Value="status" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">@Localizer("All")</MudSelectItem>
                    <MudSelectItem Value="@("Closed")">@Localizer("ClosedInvoice")</MudSelectItem>
                    <MudSelectItem Value="@("Pending")">@Localizer("Pending")</MudSelectItem>
                </MudSelect>
            </MudItem>

            @* Bill Type *@
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="@Localizer("Bill Type")" @bind-Value="billType" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">@Localizer("All")</MudSelectItem>
                    <MudSelectItem Value="@("Cash")">@Localizer("Cash")</MudSelectItem>
                    <MudSelectItem Value="@("Credit")">@Localizer("Credit")</MudSelectItem>
                    <MudSelectItem Value="@("Bank")">@Localizer("Bank")</MudSelectItem>
                </MudSelect>
            </MudItem>

        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="3" Class="pa-4 ma-2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadData" StartIcon="@Icons.Material.Filled.Receipt">@Localizer("Generate")</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportExcel" StartIcon="@Icons.Material.Filled.TableView">@Localizer("Excel")</MudButton>
             <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ClearAll" Color="Color.Warning" OnClick="ClearMethod">@Localizer("Clear")</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>

@if (result is not null)
{
    @* Summary *@
    <MudGrid Class="ma-2">
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Count"):</b> @result.TotalCount</MudText>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Amount"):</b> @PermanentSettingsData.FormatCurrency(result.TotalAmount)</MudText>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Paid"):</b> @PermanentSettingsData.FormatCurrency(result.TotalPaid)</MudText>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Discount"):</b> @PermanentSettingsData.FormatCurrency(result.TotalDiscount)</MudText>
        </MudItem>
        <MudItem xs="12" sm="2">
             <MudText><b>@Localizer("Return"):</b> @PermanentSettingsData.FormatCurrency(result.TotalReturn)</MudText>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudText><b>@Localizer("Balance"):</b> @PermanentSettingsData.FormatCurrency(result.TotalBalance)</MudText>
        </MudItem>
    </MudGrid>
}

    <MudTable Items="@(result?.Reports ?? new List<PurchaseMonitorDtls>())" @ref="table" Dense="true" Hover="true" Bordered="true" Striped="true" T="PurchaseMonitorDtls" Class="ma-2" Elevation="3" OnRowClick="RowClickEvent">
         <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("Search Results")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchString" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" OnDebounceIntervalElapsed="LoadData" DebounceInterval="500"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localizer("PURCHASE NO.")</MudTh>
            <MudTh>@Localizer("DATE")</MudTh>
            <MudTh>@Localizer("Supplier Name")</MudTh>
            <MudTh>@Localizer("Bill Type")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Amount")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Paid")</MudTh>
             <MudTh Style="text-align:right">@Localizer("Discount")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Return")</MudTh>
            <MudTh Style="text-align:right">@Localizer("Balance")</MudTh>
             <MudTh>@Localizer("Status")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="PURCHASE NO.">@context.InvoiceNo</MudTd>
            <MudTd DataLabel="DATE">@context.Date</MudTd>
            <MudTd DataLabel="Supplier Name">@context.SupplierName</MudTd>
            <MudTd DataLabel="Bill Type">@context.BillType</MudTd>
            <MudTd DataLabel="Amount" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Amount)</MudTd>
            <MudTd DataLabel="Paid" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Paid)</MudTd>
            <MudTd DataLabel="Discount" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Discount)</MudTd>
            <MudTd DataLabel="Return" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Return)</MudTd>
            <MudTd DataLabel="Balance" Style="text-align:right">@PermanentSettingsData.FormatCurrency(context.Balance)</MudTd>
            <MudTd DataLabel="Status">
                @if (context.Status == "Closed")
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">@context.Status</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error">@context.Status</MudChip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

@if (IsLoading)
{
    <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
}
