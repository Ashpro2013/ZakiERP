@inject IViewService api
@inject ISnackbar Snackbar
@inject IFormFactor FormFactor

<MudPaper Class="pa-0" Elevation="8" Style="width: 95vw; max-width: 1200px; height: 90vh; max-height: 800px; display: flex; flex-direction: column;">
    <!-- Header (Fixed) -->
    <MudPaper Class="pa-3" Elevation="0" Style="border-bottom: 1px solid var(--mud-palette-divider);">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                @Localizer("PermanentSettings")
            </MudText>
            <MudFab StartIcon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="HandleClose" />
        </MudStack>
    </MudPaper>

    <!-- Content (Scrollable) -->
    <MudPaper Class="pa-4" Elevation="0" Style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" 
                 SliderColor="Color.Primary" Color="Color.Transparent" 
                 Style="height: 100%; display: flex; flex-direction: column;">
            
            <!-- Tab 1: Code Generation -->
            <MudTabPanel Text="@Localizer("CodeGeneration")" Icon="@Icons.Material.Filled.QrCode2" Style="height: 100%; overflow: hidden;">
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"  
                         SliderColor="Color.Secondary" Color="Color.Transparent" Position="Position.Left" Border="true" 
                         Style="height: 100%; display: flex;" Class="left-align-tabs">
                    
                    <!-- Inner Tab 1: Masters -->
                    <MudTabPanel Text="@Localizer("Masters")" Icon="@Icons.Material.Filled.Storage">
                        <div style="max-height: calc(90vh - 250px); overflow-y: auto; padding: 16px;">
                            <MudGrid Spacing="3">
                            <!-- Left Column -->
                            <MudItem xs="12" md="6">
                                <!-- Item Code Settings -->
                                <MudPaper Class="pa-3 mb-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1" />
                                        @Localizer("ItemCode")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoItemCode" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoItemCode)
                                        {
                                            <MudItem xs="8"><MudText>@Localizer("CategoryWiseCode")</MudText></MudItem>
                                            <MudItem xs="4"><MudSwitch @bind-Value="settings.CategoryWiseItemCode" @bind-Value:after="OnCategoryWiseChanged" Color="Color.Info" /></MudItem>

                                            @if (settings.CategoryWiseItemCode)
                                            {
                                                <MudItem xs="8"><MudText>@Localizer("SubCategoryWiseCode")</MudText></MudItem>
                                                <MudItem xs="4"><MudSwitch @bind-Value="settings.SubCategoryWiseItemCode" @bind-Value:after="MarkDirty" Color="Color.Tertiary" /></MudItem>
                                            }

                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.ItemCodePrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.ItemCodeStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.ItemCodeZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>

                                            @if (settings.CategoryWiseItemCode)
                                            {
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="settings.CodeSeparator" @bind-Value:after="MarkDirty" Label="@Localizer("Separator")" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="-" />
                                                </MudItem>
                                            }

                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetItemCodePreview()
                                                </MudAlert>
                                            </MudItem>
                                        }

                                        <MudItem xs="8">
                                            <MudText>@Localizer("AutoBarcodeGeneration")</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer("AutoBarcodeGenerationDesc")</MudText>
                                        </MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoBarcodeGeneration" @bind-Value:after="MarkDirty" Color="Color.Primary" /></MudItem>
                                    </MudGrid>
                                </MudPaper>

                                <!-- Customer Code Settings -->
                                <MudPaper Class="pa-3 mb-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
                                        @Localizer("CustomerCode")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoCustomerCode" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoCustomerCode)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.CustomerCodePrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.CustomerCodeStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.CustomerCodeZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Success" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.CustomerCodePrefix, settings.CustomerCodeZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>

                                <!-- Supplier Code Settings -->
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Warning" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="mr-1" />
                                        @Localizer("SupplierCode")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoSupplierCode" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoSupplierCode)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.SupplierCodePrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.SupplierCodeStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.SupplierCodeZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Warning" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.SupplierCodePrefix, settings.SupplierCodeZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Right Column: Category & SubCategory -->
                            <MudItem xs="12" md="6">
                                <!-- Category Code Settings -->
                                <MudPaper Class="pa-3 mb-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="mr-1" />
                                        @Localizer("CategoryCode")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoCategoryCode" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoCategoryCode)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.CategoryCodePrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.CategoryCodeStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.CategoryCodeZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Normal" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.CategoryCodePrefix, settings.CategoryCodeZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>

                                <!-- SubCategory Code Settings -->
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Tertiary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-1" />
                                        @Localizer("SubCategoryCode")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoSubCategoryCode" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoSubCategoryCode)
                                        {
                                            <MudItem xs="8"><MudText>@Localizer("CategoryWiseCode")</MudText></MudItem>
                                            <MudItem xs="4"><MudSwitch @bind-Value="settings.CategoryWiseSubCategoryCode" @bind-Value:after="OnCategoryWiseSubCategoryChanged" Color="Color.Info" /></MudItem>

                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.SubCategoryCodePrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.SubCategoryCodeStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.SubCategoryCodeZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Normal" Dense="true">
                                                    @Localizer("Preview"): @GetSubCategoryCodePreview()
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                        </div>
                    </MudTabPanel>

                    <!-- Inner Tab 2: Transactions -->
                    <MudTabPanel Text="@Localizer("Transactions")" Icon="@Icons.Material.Filled.Receipt">
                        <div style="max-height: calc(90vh - 250px); overflow-y: auto; padding: 16px;">
                            <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <!-- Quotation Number Settings -->
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Info" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Small" Class="mr-1" />
                                        @Localizer("QuotationNumber")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoQuotationNo" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoQuotationNo)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.QuotationNoPrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.QuotationNoStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.QuotationNoZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.QuotationNoPrefix, settings.QuotationNoZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Sales Order Number -->
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Tertiary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
                                        @Localizer("SalesOrderNo")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoSalesOrderNo" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoSalesOrderNo)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.SalesOrderNoPrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.SalesOrderNoStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.SalesOrderNoZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.SalesOrderNoPrefix, settings.SalesOrderNoZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Delivery Note Number -->
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Tertiary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="mr-1" />
                                        @Localizer("DeliveryNoteNo")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoDeliveryNoteNo" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>
                                        
                                        @if (settings.AutoDeliveryNoteNo)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.DeliveryNoteNoPrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.DeliveryNoteNoStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.DeliveryNoteNoZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.DeliveryNoteNoPrefix, settings.DeliveryNoteNoZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Purchase Order Number -->
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Tertiary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-1" />
                                        @Localizer("PurchaseOrderNo")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoPurchaseOrderNo" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoPurchaseOrderNo)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.PurchaseOrderNoPrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.PurchaseOrderNoStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.PurchaseOrderNoZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.PurchaseOrderNoPrefix, settings.PurchaseOrderNoZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Proforma Invoice Number -->
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Info" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
                                        @Localizer("ProformaInvoiceNo")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoProformaInvoiceNo" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoProformaInvoiceNo)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.ProformaInvoiceNoPrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.ProformaInvoiceNoStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.ProformaInvoiceNoZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.ProformaInvoiceNoPrefix, settings.ProformaInvoiceNoZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Purchase Number -->
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Tertiary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
                                        @Localizer("PurchaseNo")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="8"><MudText>@Localizer("AutoGenerate")</MudText></MudItem>
                                        <MudItem xs="4"><MudSwitch @bind-Value="settings.AutoPurchaseNo" @bind-Value:after="MarkDirty" Color="Color.Success" /></MudItem>

                                        @if (settings.AutoPurchaseNo)
                                        {
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="settings.PurchaseNoPrefix" @bind-Value:after="MarkDirty" Label="@Localizer("Prefix")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.PurchaseNoStartNumber" @bind-Value:after="MarkDirty" Label="@Localizer("StartNo")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="4">
                                                <MudNumericField @bind-Value="settings.PurchaseNoZeroPadding" @bind-Value:after="MarkDirty" Label="@Localizer("MinDigits")" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="10" HideSpinButtons="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAlert Severity="Severity.Info" Dense="true">
                                                    @Localizer("Preview"): @GetSimpleCodePreview(settings.PurchaseNoPrefix, settings.PurchaseNoZeroPadding)
                                                </MudAlert>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Stock Adjustment Number -->
                            <MudItem xs="12" md="6">
