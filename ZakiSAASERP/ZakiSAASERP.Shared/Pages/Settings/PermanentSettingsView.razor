                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                Select default printers for desktop printing. If left blank, system default printer will be used.
                                            </MudAlert>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }

                            @if (AppData.IsWindows && (string.Equals(AppData.DBProvider, "MSSQL", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(AppData.DBProvider)))
                            {
                                <MudPaper Class="pa-3 mt-3" Outlined="true">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Backup" Size="Size.Small" Color="Color.Info" Class="mr-1" />
                                        <MudText Typo="Typo.subtitle1" Color="Color.Info">
                                            @Localizer("DatabaseBackupSettings")
                                        </MudText>
                                    </MudStack>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12">
                                            <MudSwitch @bind-Value="settings.BackupWhenClosing" @bind-Value:after="MarkDirty"
                                                       Label="@Localizer("Back Up When Closing")"
                                                       Color="Color.Primary" />
                                            <MudText Typo="Typo.caption" Class="text-muted d-block mt-1">
                                                @Localizer("Prompt to backup the MSSQL database before closing the application.")
                                            </MudText>
                                        </MudItem>
                                        @if (settings.BackupWhenClosing)
                                        {
                                            <MudItem xs="12">
                                                <MudTextField @bind-Value="settings.BackupFolder" @bind-Value:after="MarkDirty"
                                                              Label="@Localizer("BackupFolder")"
                                                              Placeholder="Leave blank for SQL Server default backup directory"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudItem>
                    </MudGrid>
                </div>
            </MudTabPanel>

            <!-- Tab 3: Zatca Configuration -->
            <MudTabPanel Text="Zatca Configuration" Icon="@Icons.Material.Filled.QrCodeScanner">
                <div style="max-height: calc(90vh - 250px); overflow-y: auto; padding: 16px;">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Class="mr-2" />
                            ZATCA FATOORA Configuration (Saudi Arabia)
                        </MudText>
                        
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">Zatca Phase</MudText>
                                <MudRadioGroup @bind-Value="settings.ZatcaPhase" @bind-Value:after="MarkDirty" T="string">
                                    <MudRadio Value='@("1")' Color="Color.Primary" Dense="true">First Phase</MudRadio>
                                    <MudRadio Value='@("2")' Color="Color.Secondary" Dense="true" Class="ml-4">Second Phase</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">Upload Simplified XML Realtime</MudText>
                                <MudSwitch T="bool" @bind-Value="settings.UploadSimplifiedXMLRealtime" @bind-Value:after="MarkDirty" Color="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">Default Zatca Mode</MudText>
                                <MudRadioGroup @bind-Value="settings.ZatcaConnection" @bind-Value:after="MarkDirty" T="string">
                                    <MudRadio Value='@("Production")' Color="Color.Primary" Dense="true">Production</MudRadio>
                                    <MudRadio Value='@("Simulation")' Color="Color.Secondary" Dense="true" Class="ml-4">Simulation</MudRadio>
                                    <MudRadio Value='@("Developer")' Color="Color.Primary" Dense="true">Developer</MudRadio>
                                </MudRadioGroup>
                            </MudItem>
                            
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    <strong>Note:</strong> Select "Simulation" for testing and "Production" for the live ZATCA clearance/reporting environment.
                                </MudAlert>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </div>
            </MudTabPanel>

            <!-- Tab 4: Invoice & Purchase -->
            <MudTabPanel Text="@Localizer("InvoicePurchase")" Icon="@Icons.Material.Filled.Receipt">
                <div style="height: calc(90vh - 220px); overflow-y: auto; padding-right: 8px;">
                    <MudPaper Class="pa-4 mb-3" Outlined="true" Style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-radius: 8px;">
                        <div class="d-flex align-center gap-3">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0f172a;">
                                    @Localizer("InvoiceSettings")
                                </MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">
                                    @Localizer("InvoiceSettingsDesc")
                                </MudText>
                            </div>
                        </div>
                    </MudPaper>

                    <MudPaper Class="pa-3" Outlined="true" Style="border-radius: 8px;">
                        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
                                 SliderColor="Color.Primary" Color="Color.Transparent" PanelClass="pt-3">
                            <MudTabPanel Text="Sales Invoice" Icon="@Icons.Material.Filled.ReceiptLong">
                                <TransactionGridSettingsEditor Model="@settings.SalesInvoiceSettings"
                                                               TransactionTitle="Sales Invoice"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Sales Order" Icon="@Icons.Material.Filled.ShoppingCartCheckout">
                                <TransactionGridSettingsEditor Model="@settings.SalesOrderSettings"
                                                               TransactionTitle="Sales Order"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Sales Quotation" Icon="@Icons.Material.Filled.RequestQuote">
                                <TransactionGridSettingsEditor Model="@settings.SalesQuotationSettings"
                                                               TransactionTitle="Sales Quotation"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Proforma Invoice" Icon="@Icons.Material.Filled.Description">
                                <TransactionGridSettingsEditor Model="@settings.ProformaInvoiceSettings"
                                                               TransactionTitle="Proforma Invoice"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Sales Return" Icon="@Icons.Material.Filled.AssignmentReturn">
                                <MudPaper Class="pa-4 mb-3" Outlined="true" Style="border-radius: 8px; background: #ffffff;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0f172a;">
                                            @Localizer("Print Format Settings")
                                        </MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Style="color: #64748b;" Class="d-block mb-3">
                                        Select default print output format for Sales Return Invoice (A4 standard invoice or Thermal 80mm receipt).
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudSelect T="string" @bind-Value="settings.SalesReturnPrintFormat" @bind-Value:after="MarkDirty"
                                                       Label="@Localizer("Sales Return Invoice Print Format")"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       AnchorOrigin="Origin.BottomCenter">
                                                <MudSelectItem Value="@("A4")">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Info" />
                                                        <span>A4 (Standard Invoice)</span>
                                                    </div>
                                                </MudSelectItem>
                                                <MudSelectItem Value="@("Thermal")">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Warning" />
                                                        <span>Thermal (80mm Receipt)</span>
                                                    </div>
                                                </MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                                <TransactionGridSettingsEditor Model="@settings.SalesReturnSettings"
                                                               TransactionTitle="Sales Return"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Purchase Invoice" Icon="@Icons.Material.Filled.LocalMall">
                                <MudPaper Class="pa-4 mb-3" Outlined="true" Style="border-radius: 8px; background: #ffffff;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Tertiary" Class="mr-1" />
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0f172a;">
                                            @Localizer("AiInvoiceOcrSettings")
                                        </MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Style="color: #64748b;" Class="d-block mb-3">
                                        @Localizer("AiInvoiceOcrSettingsDesc")
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="4" Class="d-flex align-center">
                                            <MudSwitch @bind-Value="settings.ShowAIInvoiceOCR" @bind-Value:after="MarkDirty"
                                                       Color="Color.Primary" Label="@Localizer("ShowAIInvoiceOCR")" />
                                        </MudItem>
                                        <MudItem xs="12" sm="5">
                                            <MudTextField @bind-Value="settings.AiApiKey" @bind-Value:after="MarkDirty"
                                                          Label="Gemini API Key"
                                                          InputType="InputType.Password"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="AIzaSy..."
                                                          Disabled="@(!settings.ShowAIInvoiceOCR)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudSelect T="string" @bind-Value="settings.AiModelName" @bind-Value:after="MarkDirty"
                                                       Label="AI Model"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Disabled="@(!settings.ShowAIInvoiceOCR)">
                                                <MudSelectItem Value="@("gemini-2.5-flash")">gemini-2.5-flash</MudSelectItem>
                                                <MudSelectItem Value="@("gemini-2.0-flash")">gemini-2.0-flash</MudSelectItem>
                                                <MudSelectItem Value="@("gemini-1.5-flash")">gemini-1.5-flash</MudSelectItem>
                                                <MudSelectItem Value="@("gemini-1.5-pro")">gemini-1.5-pro</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                                <TransactionGridSettingsEditor Model="@settings.PurchaseSettings"
                                                               TransactionTitle="Purchase Invoice"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Delivery Note" Icon="@Icons.Material.Filled.LocalShipping">
                                <TransactionGridSettingsEditor Model="@settings.DeliveryNoteSettings"
                                                               TransactionTitle="Delivery Note"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Delivery Note Return" Icon="@Icons.Material.Filled.Undo">
                                <TransactionGridSettingsEditor Model="@settings.DeliveryNoteReturnSettings"
                                                               TransactionTitle="Delivery Note Return"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Purchase Return" Icon="@Icons.Material.Filled.KeyboardReturn">
                                <TransactionGridSettingsEditor Model="@settings.PurchaseReturnSettings"
                                                               TransactionTitle="Purchase Return"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>

                            <MudTabPanel Text="Goods Receipt" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                                <TransactionGridSettingsEditor Model="@settings.GoodsReceiptSettings"
                                                               TransactionTitle="Goods Receipt"
                                                               ShowApplyToAll="true"
                                                               OnChanged="MarkDirty"
                                                               OnApplyToAll="ApplyToAllTransactions" />
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                </div>
            </MudTabPanel>

            <!-- Tab 4: Reports -->
            <MudTabPanel Text="@Localizer("Reports")" Icon="@Icons.Material.Filled.Assessment">
                <MudPaper Class="pa-4" Outlined="true" Style="min-height: 250px;">
                    <MudText Typo="Typo.subtitle1" Color="Color.Default" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" Class="mr-1" />
                        @Localizer("ReportSettings")
                    </MudText>
                    <MudText Typo="Typo.body2">@Localizer("ReportSettingsDesc")</MudText>
                </MudPaper>
            </MudTabPanel>

            <!-- Tab 5: Menu Configuration -->
            <MudTabPanel Text="Menu Configuration" Icon="@Icons.Material.Filled.Menu">
                <div style="max-height: calc(90vh - 250px); overflow-y: auto; padding: 16px;">
                    
                    <!-- ERP Type Selector -->
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
                            Business Type & Menu Visibility
                        </MudText>
                        
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="selectedERPTypeId" 
                                          Label="Select ERP / Business Type" 
                                          Variant="Variant.Outlined"
                                          Disabled="menuConfigLoading"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Category">
                                    @if (erpTypes is not null)
                                    {
                                        @foreach (var type in erpTypes)
                                        {
                                            <MudSelectItem Value="type.Id">
                                                @type.TypeName
                                                @if (!string.IsNullOrEmpty(type.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Class="ml-2" Color="Color.Secondary">- @type.Description</MudText>
                                                }
                                            </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            
                            <MudItem xs="12" md="6" Class="d-flex align-center">
                                @if (selectedERPTypeId != currentERPTypeId && !menuConfigLoading)
                                {
                                    <MudButton Variant="Variant.Filled" 
                                              Color="Color.Primary" 
                                              StartIcon="@Icons.Material.Filled.Check"
                                              OnClick="ApplyERPTypePreset">
                                        Apply This Type
                                    </MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                                  Color="Color.Default" 
                                                  Class="ml-2"
                                                  OnClick="ReloadMenuConfiguration" title="Cancel and Reload" />
                                }
                            </MudItem>
                        </MudGrid>

                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                            <MudText Typo="Typo.body2">
                                <strong>Note:</strong> Menu changes will take effect after you refresh the page or log out and log back in.
                            </MudText>
                        </MudAlert>

                        @if (currentERPType is not null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                <strong>Current Type:</strong> @currentERPType.TypeName
                                @if (!string.IsNullOrEmpty(currentERPType.Description))
                                {
                                    <br />@currentERPType.Description
                                }
                            </MudAlert>
                        }
                    </MudPaper>

                    <!-- Menu Configuration Section -->
                    @if (menuConfigLoading)
                    {
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudProgressCircular Indeterminate="true" />
                            <MudText Class="ml-3">Loading menu configuration...</MudText>
                        </MudPaper>
                    }
                    else if (selectedMenuConfig is not null)
                    {
                        @if (selectedMenuConfig.IsCustomType)
                        {
                            <!-- Custom Type - Editable Menu Tree -->
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudText Typo="Typo.h6" Class="mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="mr-2" />
                                    Customize Menu Visibility
                                </MudText>
                                
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                    Select which menus appear in your navigation. Click to expand/collapse sections.
                                </MudText>

                                <MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true">
                                    @foreach (var topMenu in GetTopLevelMenus())
                                    {
                                        var topMenuChildren = GetChildMenus(topMenu.MenuId);
                                        var visibleCount = topMenuChildren.Count(m => m.IsVisible);
                                        var totalCount = topMenuChildren.Count;
                                        
                                        <MudExpansionPanel Class="mb-2 mud-border-primary" Style="border-radius: 6px;">
                                            <TitleContent>
                                                <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                                    <div class="d-flex align-center">
                                                        <MudSwitch @bind-Value="topMenu.IsVisible" 
                                                                   @bind-Value:after="MarkMenuDirty"
                                                                   Disabled="!topMenu.CanToggle"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   @onclick:stopPropagation="true"
                                                                   Class="mr-2" />
                                                        <MudIcon Icon="@GetMenuIcon(topMenu.Name)" Size="Size.Small" Class="mr-2" Color="Color.Primary" />
                                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">
                                                            @(AppData.IsArabic ? topMenu.ArabicCaption : topMenu.MenuCaption)
                                                        </MudText>
                                                    </div>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                                                        @visibleCount / @totalCount visible
                                                    </MudChip>
                                                </div>
                                            </TitleContent>
                                            <ChildContent>
                                                <MudPaper Class="pa-2" Elevation="0" Square="true">
                                                    @foreach (var childGroup in topMenuChildren)
                                                    {
                                                        var grandChildren = GetChildMenus(childGroup.MenuId);
                                                        var hasGrandChildren = grandChildren.Any();
                                                        
                                                        @if (hasGrandChildren)
                                                        {
                                                            <!-- Child group with sub-items -->
                                                            <MudPaper Class="mb-2 pa-2" Outlined="true" Elevation="0">
                                                                <div class="d-flex align-center justify-space-between">
                                                                    <div class="d-flex align-center">
                                                                        <MudSwitch @bind-Value="childGroup.IsVisible" 
                                                                                   @bind-Value:after="MarkMenuDirty"
                                                                                   Disabled="!childGroup.CanToggle || !topMenu.IsVisible"
                                                                                   Color="Color.Secondary"
                                                                                   Size="Size.Small"
                                                                                   Class="mr-2" />
                                                                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                                                                        <MudText Typo="Typo.body1" Style="font-weight: 500;">
                                                                            @(AppData.IsArabic ? childGroup.ArabicCaption : childGroup.MenuCaption)
                                                                        </MudText>
                                                                    </div>
                                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                                                        @grandChildren.Count(m => m.IsVisible) / @grandChildren.Count items
                                                                    </MudChip>
                                                                </div>
                                                                
                                                                <!-- Grand children items -->
                                                                <MudStack Class="ml-8 mt-2" Spacing="1">
                                                                    @foreach (var childItem in grandChildren)
                                                                    {
                                                                        <div class="d-flex align-center">
                                                                            <MudSwitch @bind-Value="childItem.IsVisible" 
                                                                                       @bind-Value:after="MarkMenuDirty"
                                                                                       Disabled="!childItem.CanToggle || !childGroup.IsVisible || !topMenu.IsVisible"
                                                                                       Color="Color.Tertiary"
                                                                                       Size="Size.Small"
                                                                                       Class="mr-1" />
                                                                            <MudIcon Icon="@Icons.Material.Filled.Description" 
                                                                                    Size="Size.Small" 
                                                                                    Class="mr-2" 
                                                                                    Color="@(childItem.IsVisible && childGroup.IsVisible && topMenu.IsVisible ? Color.Default : Color.Default)"
                                                                                    Style="@(!childItem.IsVisible || !childGroup.IsVisible || !topMenu.IsVisible ? "opacity: 0.4;" : "opacity: 0.6;")" />
                                                                            <MudText Typo="Typo.body2" 
                                                                                    Color="@(!childItem.IsVisible || !childGroup.IsVisible || !topMenu.IsVisible ? Color.Default : Color.Default)"
                                                                                    Style="@(!childItem.IsVisible || !childGroup.IsVisible || !topMenu.IsVisible ? "opacity: 0.5;" : "")">
                                                                                @(AppData.IsArabic ? childItem.ArabicCaption : childItem.MenuCaption)
                                                                            </MudText>
                                                                        </div>
                                                                    }
                                                                </MudStack>
                                                            </MudPaper>
                                                        }
                                                        else
                                                        {
                                                            <!-- Direct child item without sub-items -->
                                                            <div class="d-flex align-center mb-2 pa-1">
                                                                <MudSwitch @bind-Value="childGroup.IsVisible" 
                                                                           @bind-Value:after="MarkMenuDirty"
                                                                           Disabled="!childGroup.CanToggle || !topMenu.IsVisible"
                                                                           Color="Color.Secondary"
                                                                           Size="Size.Small"
                                                                           Class="mr-2" />
                                                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                                                                <MudText Typo="Typo.body2" 
                                                                        Color="@(!childGroup.IsVisible || !topMenu.IsVisible ? Color.Default : Color.Default)"
                                                                        Style="@(!childGroup.IsVisible || !topMenu.IsVisible ? "opacity: 0.5;" : "")">
                                                                    @(AppData.IsArabic ? childGroup.ArabicCaption : childGroup.MenuCaption)
                                                                </MudText>
                                                            </div>
                                                        }
                                                    }
                                                </MudPaper>
                                            </ChildContent>
                                        </MudExpansionPanel>
                                    }
                                </MudExpansionPanels>

                                @* Note: Menu configuration is saved with general Save button at bottom *@
                            </MudPaper>
                        }
                        else
                        {
                            <!-- Preset Type - Read-only Preview -->
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudText Typo="Typo.subtitle1" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Preview" Size="Size.Small" Class="mr-1" />
                                    Menu Preview for @selectedMenuConfig.ERPTypeName
                                </MudText>
                                
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                    This is a preset configuration. Switch to "Custom" type to customize menus manually.
                                </MudAlert>

                                <MudText Typo="Typo.body2" Class="mb-2"><strong>Visible Menus:</strong></MudText>
                                <MudChipSet T="string">
                                    @foreach (var menu in selectedMenuConfig.MenuItems.Where(m => m.IsVisible && (m.ParentId == null || m.ParentId == 0)))
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                            @(AppData.IsArabic ? menu.ArabicCaption : menu.MenuCaption)
                                        </MudChip>
                                    }
                                </MudChipSet>

                                @if (selectedMenuConfig.MenuItems.Any(m => !m.IsVisible))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-3 mb-2"><strong>Hidden Menus:</strong></MudText>
                                    <MudChipSet T="string">
                                        @foreach (var menu in selectedMenuConfig.MenuItems.Where(m => !m.IsVisible && (m.ParentId == null || m.ParentId == 0)))
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                                @(AppData.IsArabic ? menu.ArabicCaption : menu.MenuCaption)
                                            </MudChip>
                                        }
                                    </MudChipSet>
                                }
                            </MudPaper>
                        }
                    }
                </div>
            </MudTabPanel>

            <!-- Tab 6: Image Storage Configuration -->
            <MudTabPanel Text="Image Storage" Icon="@Icons.Material.Filled.CloudUpload">
                <div style="max-height: calc(90vh - 250px); overflow-y: auto; padding: 16px;">
                    
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Class="mr-2" />
                            Image Storage Configuration
                        </MudText>

                        <MudGrid Spacing="3">
                            <!-- Web Based Setting -->
                            <MudItem xs="12">
                                <MudPaper Class="pa-3 mb-3" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>@Localizer("WebBasedDeployment")</strong></MudText>
                                            <MudText Typo="Typo.caption">@Localizer("WebBasedDeploymentDesc")</MudText>
                                        </div>
                                        <MudSwitch @bind-Value="settings.IsWebBased" @bind-Value:after="MarkDirty" Color="Color.Primary" />
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <!-- Storage Mode Selector -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">Storage Mode</MudText>
                                <MudRadioGroup @bind-Value="settings.ImageStorageMode" @bind-Value:after="MarkDirty" T="int">
                                    <MudRadio Value="0" Color="Color.Primary" Dense="true">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                                            <span><strong>Local Storage</strong> - For on-premise/client-server installations</span>
                                        </MudStack>
                                    </MudRadio>
                                    <MudRadio Value="1" Color="Color.Secondary" Dense="true" Class="mt-2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" />
                                            <span><strong>AWS S3</strong> - For cloud/internet-based deployments</span>
                                        </MudStack>
                                    </MudRadio>
                                </MudRadioGroup>
                            </MudItem>

                            <!-- Client Folder (Required for both) -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="settings.ImageClientFolder" 
                                            @bind-Value:after="MarkDirty"
                                            Label="Client Folder Name"
                                            Variant="Variant.Outlined"
                                            HelperText="Unique folder name for this tenant/client"
                                            Required="true" />
                            </MudItem>

                            @if (settings.ImageStorageMode == 0)
                            {
                                <!-- Local Storage Configuration -->
                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-1" />
                                        Local Storage Settings
                                    </MudText>
                                </MudItem>



                                <MudItem xs="12">
                                    <MudTextField @bind-Value="settings.ImageLocalBasePath" 
                                                @bind-Value:after="MarkDirty"
                                                Label="Base Path"
                                                Variant="Variant.Outlined"
                                                HelperText="@(settings.IsWebBased ? "Managed by Web Server (wwwroot)" : "Root folder for image storage (e.g., D:\\ERPImages)")"
                                                Required="true"
                                                Disabled="@settings.IsWebBased" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <strong>Folder Structure:</strong><br />
                                        Images will be stored at: 
                                        @if (settings.IsWebBased)
                                        {
                                            <code>[WebServerRoot]\wwwroot\@settings.ImageClientFolder\Category\{ID}\image.png</code>
                                        }
                                        else
                                        {
                                            <code>@settings.ImageLocalBasePath\@settings.ImageClientFolder\Category\{ID}\image.png</code>
                                        }
                                    </MudAlert>
                                </MudItem>
                            }
                            else
                            {
                                <!-- AWS S3 Configuration -->
                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" Class="mr-1" />
                                        AWS S3 Settings
                                    </MudText>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="settings.ImageAwsRegion" 
                                                @bind-Value:after="MarkDirty"
                                                Label="AWS Region"
                                                Variant="Variant.Outlined"
                                                HelperText="e.g., us-east-1, eu-west-1"
                                                Required="true" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="settings.ImageAwsBucket" 
                                                @bind-Value:after="MarkDirty"
                                                Label="S3 Bucket Name"
                                                Variant="Variant.Outlined"
                                                HelperText="Existing S3 bucket name"
                                                Required="true" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="settings.ImageAwsAccessKey" 
                                                @bind-Value:after="MarkDirty"
                                                Label="Access Key ID"
                                                Variant="Variant.Outlined"
                                                HelperText="IAM access key"
                                                Required="true" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="settings.ImageAwsSecretKey" 
                                                @bind-Value:after="MarkDirty"
                                                Label="Secret Access Key"
                                                Variant="Variant.Outlined"
                                                InputType="InputType.Password"
                                                HelperText="IAM secret key (encrypted)"
                                                Required="true" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <strong>S3 Key Structure:</strong><br />
                                        Images will be stored at: <code>s3://@settings.ImageAwsBucket/@settings.ImageClientFolder/Category/{ID}/image.png</code>
                                    </MudAlert>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        <strong>Required IAM Permissions:</strong> s3:PutObject, s3:GetObject, s3:DeleteObject
                                    </MudAlert>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudPaper>

                </div>
            </MudTabPanel>

            <!-- AI & OCR Configuration Tab -->
            <MudTabPanel Text="@Localizer("AiAndOcr")" Icon="@Icons.Material.Filled.AutoAwesome">
                <div class="pa-4" style="height: 100%; overflow-y: auto;">
                    <MudPaper Class="pa-4 mb-4" Outlined="true" Style="border-radius: 8px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium" Color="Color.Tertiary" />
                            <div>
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">@Localizer("AiConfigurationTitle")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer("AiConfigurationDesc")</MudText>
                            </div>
                        </MudStack>

                        <MudDivider Class="my-3" />

                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-4" Elevation="0" Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@Localizer("AiPurchaseInvoiceOcr")</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @Localizer("AiInvoiceOcrSettingsDesc")
                                            </MudText>
                                        </div>
                                        <MudSwitch @bind-Value="settings.ShowAIInvoiceOCR" @bind-Value:after="MarkDirty"
                                                   Color="Color.Primary" />
                                    </MudStack>
                                    <MudText Typo="Typo.body2" Class="mt-2">
                                        Status: @(settings.ShowAIInvoiceOCR ? "Enabled (Visible in Purchase Invoice)" : "Disabled (Hidden in Purchase Invoice)")
                                    </MudText>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-4" Elevation="0" Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;" Class="mb-2">AI Engine & Model</MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="5">
                                            <MudSelect T="string" @bind-Value="settings.AiProvider" @bind-Value:after="MarkDirty"
                                                       Label="AI Provider" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Disabled="@(!settings.ShowAIInvoiceOCR)">
                                                <MudSelectItem Value="@("Gemini")">Google Gemini</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="7">
                                            <MudSelect T="string" @bind-Value="settings.AiModelName" @bind-Value:after="MarkDirty"
                                                       Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Disabled="@(!settings.ShowAIInvoiceOCR)">
                                                <MudSelectItem Value="@("gemini-2.5-flash")">gemini-2.5-flash (Recommended)</MudSelectItem>
                                                <MudSelectItem Value="@("gemini-2.0-flash")">gemini-2.0-flash</MudSelectItem>
                                                <MudSelectItem Value="@("gemini-1.5-flash")">gemini-1.5-flash</MudSelectItem>
                                                <MudSelectItem Value="@("gemini-1.5-pro")">gemini-1.5-pro</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="settings.AiApiKey" @bind-Value:after="MarkDirty"
                                              Label="Google Gemini API Key"
                                              InputType="InputType.Password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Placeholder="AIzaSy..."
                                              HelperText="API Key from Google AI Studio (aistudio.google.com). Stored securely in ERP permanent settings."
                                              Disabled="@(!settings.ShowAIInvoiceOCR)" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                    <strong>Multimodal OCR Features:</strong> Scans PDF documents and image files (JPEG, PNG, WEBP), accurately parses vendor VAT registration numbers, item descriptions in Arabic and English, quantities, unit prices, discounts, 15% ZATCA tax, and auto-matches products against ERP inventory masters.
                                </MudAlert>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>


    <!-- Inline Close Confirmation (shown when unsaved changes) -->
    @if (showCloseConfirmation)
    {
        <MudPaper Class="pa-3" Elevation="4" Style="background-color: var(--mud-palette-warning-lighten); border-top: 2px solid var(--mud-palette-warning);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                    <MudText Typo="Typo.body1">@Localizer("UnsavedChangesMsg")</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelClose">@Localizer("Cancel")</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DiscardAndClose">@Localizer("Discard")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveAndClose">@Localizer("SaveAndClose")</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }

    <!-- Footer with Action Buttons (Fixed) - only show when not confirming close -->
    @if (!showCloseConfirmation)
    {
        <MudPaper Class="pa-3" Elevation="4" Style="border-top: 1px solid var(--mud-palette-divider);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="@(isDirty ? Color.Warning : Color.Default)">
                    @if (isDirty)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                        <span>@Localizer("UnsavedChangesAlert")</span>
                    }
                </MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Disabled="@(!isDirty)">
                        @Localizer("SaveSettings")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Close" OnClick="HandleClose">
                        @Localizer("Close")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudPaper>

<style>
    .left-align-tabs .mud-tab {
        justify-content: flex-start !important;
        text-align: left;
    }
    .left-align-tabs .mud-tab .mud-tab-content {
        justify-content: flex-start;
    }
</style>
