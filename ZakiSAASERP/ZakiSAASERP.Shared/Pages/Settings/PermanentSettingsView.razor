                                    <MudItem xs="8"><MudText>@Localizer("BlockInvoiceOnCreditLimitExceeded")</MudText></MudItem>
                                    <MudItem xs="4"><MudSwitch @bind-Value="settings.BlockInvoiceOnCreditLimitExceeded" @bind-Value:after="MarkDirty" Color="Color.Error" /></MudItem>

                                    <MudItem xs="8"><MudText>@Localizer("RequireBarcode")</MudText></MudItem>
                                    <MudItem xs="4"><MudSwitch T="bool" @bind-Value="settings.RequireBarcode" @bind-Value:after="MarkDirty" Color="Color.Primary" /></MudItem>

                                    <MudItem xs="8">
                                        <MudText>@Localizer("AutoBarcodeGeneration")</MudText>
