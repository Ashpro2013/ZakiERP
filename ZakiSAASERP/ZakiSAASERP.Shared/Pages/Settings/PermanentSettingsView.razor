            <!-- Tab 2: Default Behavior -->
            <MudTabPanel Text="@Localizer("Defaults")" Icon="@Icons.Material.Filled.Tune">
                <div style="max-height: calc(90vh - 250px); overflow-y: auto; padding: 16px;">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
