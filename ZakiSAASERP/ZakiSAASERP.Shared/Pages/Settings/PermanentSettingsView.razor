                                    </MudItem>
                                    <MudItem xs="4"><MudSwitch T="bool" @bind-Value="settings.AutoBarcodeGeneration" @bind-Value:after="MarkDirty" Color="Color.Primary" /></MudItem>

                                    <MudItem xs="8"><MudText>@Localizer("ShowCostInSales")</MudText></MudItem>
                                    <MudItem xs="4"><MudSwitch T="bool" @bind-Value="settings.ShowCostInSales" @bind-Value:after="MarkDirty" Color="Color.Info" /></MudItem>

                                    <MudItem xs="8"><MudText>@Localizer("EnableShiftClosing")</MudText></MudItem>
