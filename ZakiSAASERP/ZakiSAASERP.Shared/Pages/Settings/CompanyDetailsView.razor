@page "/companydetails"
@using ZakiSAASERP.Models.Masters
@using ZakiSAASERP.Shared.Services
@inject TabService TabService
@inject ModelService Dialog
@inject IDialogService DialogService

<PageTitle>Company Details</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <MudPaper Elevation="2" Class="pa-3" Style="position: relative;">
        <!-- Loading Overlay -->
        @if (isLoading)
        {
            <MudOverlay Visible="true" DarkBackground="true" Absolute="true">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </MudOverlay>
        }
        
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1" />
            <MudText Typo="Typo.h6">@Localizer("Company Details")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>

        <EditForm Model="@companyDetail" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <!-- Branch Selection & Actions -->
            <MudGrid Spacing="1" Class="mb-2">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int" Value="selectedBranchId" Label="Branch" Variant="Variant.Outlined" 
                              Disabled="@(!canChangeBranch)" Dense="true" Margin="Margin.Dense"
                              ValueChanged="@OnBranchChangedHandler">
                        @if (branches is not null && branches.Any())
                        {
                            @foreach (var branch in branches)
                            {
                                <MudSelectItem Value="@branch.BranchId">@branch.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="9" Class="d-flex justify-end align-center">
                    @if (isEditMode)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" 
                                  Class="mr-1" ButtonType="ButtonType.Submit">
                            <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" Class="mr-1" /> SAVE
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" 
                                  OnClick="CancelEdit">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="mr-1" /> CANCEL
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" 
                                  OnClick="ToggleEditMode" Disabled="@(!dataExists)">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-1" /> Edit
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>

            <MudDivider Class="mb-3" />

            <!-- Company Name - Special Row -->
            <div class="form-row mb-2">
                <div class="form-field-group full-width">
                    <label class="field-label">@Localizer("Company Name") **</label>
                    <MudTextField @bind-Value="companyDetail.Name" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)"
                                Required="true" For="@(() => companyDetail.Name)" 
                                Placeholder="@Localizer("Company Name")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.Name)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.NameArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="اسم الشركة" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Contact | VAT No (REORDERED) -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Contact")</label>
                    <MudTextField @bind-Value="companyDetail.Contact" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Contact")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.Contact)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.ContactArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="جهة الاتصال" Class="flex-input rtl-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("VAT No")</label>
                    <MudTextField @bind-Value="companyDetail.VatNo" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("VAT No")" For="@(() => companyDetail.VatNo)" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.VatNo)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.VatNoArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="الرقم الضريبي" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Telephone | Street Name (REORDERED) -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Telephone")</label>
                    <MudTextField @bind-Value="companyDetail.Telephone" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Telephone")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.Telephone)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.TelephoneArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="هاتف" Class="flex-input rtl-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Street Name")</label>
                    <MudTextField @bind-Value="companyDetail.StreetName" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Street Name")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.StreetName)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.StreetNameArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="اسم الشارع" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Fax | District (REORDERED) -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Fax")</label>
                    <MudTextField @bind-Value="companyDetail.Fax" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Fax")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.Fax)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.FaxArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="فاكس" Class="flex-input rtl-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("District")</label>
                    <MudTextField @bind-Value="companyDetail.District" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("District")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.District)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.DistrictArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="الحي" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Mobile | City -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Mobile")</label>
                    <MudTextField @bind-Value="companyDetail.Mobile" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Mobile")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.Mobile)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.MobileArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="موبايل" Class="flex-input rtl-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("City")</label>
                    <MudTextField @bind-Value="companyDetail.City" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("City")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.City)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.CityArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="المدينة" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Email | Postal Code -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Email")</label>
                    <MudTextField @bind-Value="companyDetail.Email" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                InputType="InputType.Email" For="@(() => companyDetail.Email)" 
                                Placeholder="@Localizer("Email")" Class="flex-input full-width-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Postal Code")</label>
                    <MudTextField @bind-Value="companyDetail.PostalCode" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Postal Code")" For="@(() => companyDetail.PostalCode)" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.PostalCode)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.PostalCodeArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="الرمز البريدي" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Identification No | Building No -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Identification No")</label>
                    <MudTextField @bind-Value="companyDetail.IdentificationNo" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Identification No")" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.IdentificationNo)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.IdentificationNoArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="رقم التعريف" Class="flex-input rtl-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Building No")</label>
                    <MudTextField @bind-Value="companyDetail.BuildingNo" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Building No")" For="@(() => companyDetail.BuildingNo)" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.BuildingNo)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.BuildingNoArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="رقم المبنى" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Additional No/Secondary No | Other Seller ID -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Add No/Sec No")</label>
                    <MudTextField @bind-Value="companyDetail.AdditionalNo" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Additional No/Secondary No")" For="@(() => companyDetail.AdditionalNo)" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.AdditionalNo)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.AdditionalNoArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="رقم إضافي" Class="flex-input rtl-input" />
                </div>
                
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Other Seller ID")</label>
                    <MudTextField @bind-Value="companyDetail.OtherSellerId" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Other Seller ID")" For="@(() => companyDetail.OtherSellerId)" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                              Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.OtherSellerId)))"
                              Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.OtherSellerIdArabic" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="معرف البائع الآخر" Class="flex-input rtl-input" />
                </div>
            </div>

            <!-- Country | Identification -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Region")</label>
                    <MudTextField @bind-Value="companyDetail.CountrySubentity" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)"
                                  Placeholder="@Localizer("Region")" For="@(() => companyDetail.CountrySubentity)" Class="flex-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Small" OnClick="@(() => TranslateToArabic(nameof(companyDetail.OtherSellerId)))"
                               Disabled="@(!isEditMode)" Class="ar-button">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" Size="Size.Small" />
                    </MudButton>
                    <MudTextField @bind-Value="companyDetail.CountrySubentityArabic" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)"
                                  Placeholder="معرف المنطقة" Class="flex-input rtl-input" />
                </div>
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Country")</label>
                    <MudSelect @bind-Value="companyDetail.FK_CountryId" Variant="Variant.Outlined" 
                              Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                              Clearable="false" Placeholder="@Localizer("Country")" Class="flex-input full-width-input">
                        @if (countries is not null && countries.Any())
                        {
                            @foreach (var country in countries)
                            {
                                <MudSelectItem Value="@((int?)country.CountryId)">@country.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
                
               
            </div>

            <!-- Group VAT -->
            <div class="form-row mb-2">
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Identification")</label>
                    <MudSelect @bind-Value="companyDetail.IdentificationType" Variant="Variant.Outlined"
                               Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)"
                               Placeholder="@Localizer("Identification")" Class="flex-input full-width-input">
                        <MudSelectItem Value="@("CRN")">Commercial Registration Number</MudSelectItem>
                        <MudSelectItem Value="@("TIN")">Tax Identification Number</MudSelectItem>
                        <MudSelectItem Value="@("MOM")">MOMRAH License</MudSelectItem>
                        <MudSelectItem Value="@("MLS")">MHRSD License</MudSelectItem>
                        <MudSelectItem Value="@("700")">700 Number</MudSelectItem>
                        <MudSelectItem Value="@("SAG")">MISA License</MudSelectItem>
                        <MudSelectItem Value="@("NAT")">National ID</MudSelectItem>
                        <MudSelectItem Value="@("GCC")">GCC ID</MudSelectItem>
                        <MudSelectItem Value="@("IQA")">Iqama Number</MudSelectItem>
                        <MudSelectItem Value="@("PAS")">Passport ID</MudSelectItem>
                        <MudSelectItem Value="@("OTH")">Other OD</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="form-field-group">
                    <label class="field-label">@Localizer("Group VAT")</label>
                    <MudTextField @bind-Value="companyDetail.GroupVat" Variant="Variant.Outlined" 
                                Dense="true" Margin="Margin.Dense" Disabled="@(!isEditMode)" 
                                Placeholder="@Localizer("Group VAT")" Class="flex-input full-width-input" />
                </div>
            </div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText>@Localizer("HeaderPhoto")</MudText>

                    <MudFileUpload T="IBrowserFile"
                                   FilesChanged="Uploadheader"
                                   Accept="image/*"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Image">
                                @Localizer("UploadHeader")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (!string.IsNullOrEmpty(headerImagePreview))
                    {
                        <MudPaper Elevation="3"
                                  Class="pa-1 mt-2 d-inline-block position-relative"
                                  Style="display:inline-block;">

                            <!-- Remove button -->
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="position-absolute"
                                           Style="top:-8px; right:-8px; background:white; border-radius:50%;"
                                           OnClick="@RemoveHeaderImage" />

                            <!-- Clickable image -->
                            <MudImage src="@headerImagePreview"
                                 width="120"
                                 style="cursor:pointer;"
                                      @onclick="@(() => CrudHelper.ShowImagePopup(Dialog, DialogService, headerImagePreview))" />
                        </MudPaper>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText>@Localizer("FooterPhoto")</MudText>

                    <MudFileUpload T="IBrowserFile"
                                   FilesChanged="Uploadfooter"
                                   Accept="image/*"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Image">
                                @Localizer("UploadFooter")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (!string.IsNullOrEmpty(footerImagePreview))
                    {
                        <MudPaper Elevation="3"
                                  Class="pa-1 mt-2 d-inline-block position-relative"
                                  Style="display:inline-block;">

                            <!-- Remove button -->
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="position-absolute"
                                           Style="top:-8px; right:-8px; background:white; border-radius:50%;"
                                           OnClick="@RemoveFooterImage" />

                            <!-- Clickable image -->
                            <img src="@footerImagePreview"
                                 width="120"
                                 style="cursor:pointer;"
                                 @onclick="@(() => CrudHelper.ShowImagePopup(Dialog, DialogService, footerImagePreview))" />
                        </MudPaper>
                    }
                </MudItem>

            </MudGrid>
        </EditForm>
    </MudPaper>
</MudContainer>

<style>
    .form-row {
        display: flex;
        gap: 16px;
        width: 100%;
    }
    
    .form-field-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 0;
    }
    
    .form-field-group.full-width {
        flex: 1 1 100%;
    }
    
    .field-label {
        min-width: 160px;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgba(0, 0, 0, 0.6);
        flex-shrink: 0;
    }
    
    .flex-input {
        flex: 1;
        min-width: 0;
    }
    
    .full-width-input {
        flex: 1 1 100%;
    }
    
    .ar-button {
        min-width: 40px !important;
        width: 40px !important;
        height: 40px !important;
        padding: 0 !important;
        flex-shrink: 0;
        border-radius: 4px !important;
        font-weight: 600;
    }
    
    .rtl-input input {
        direction: rtl;
        text-align: right;
    }
    
    @@media (max-width: 960px) {
        .form-row {
            flex-direction: column;
        }
        
        .field-label {
            min-width: 100px;
        }
    }
</style>
