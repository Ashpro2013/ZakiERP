@page "/customergroup"
@inject IViewService api
@inject ModelService Dialog
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject TabService TabService

<PageTitle>@Localizer("CustomerGroupMaster")</PageTitle>

<MudPaper Class="pa-4 ma-2" Elevation="3">
    <MudStack Spacing="2">

        <MudStack Row="true">
            <MudText Typo="Typo.h5">@Localizer("CustomerGroupMaster")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>

        <EditForm Model="customerGroup" OnValidSubmit="SaveOrUpdate">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("Code")</MudText>
                    <MudTextField @bind-Value="customerGroup.Code" AutoFocus="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  @ref="txtCode" OnKeyDown="@(e => KeyDown(e, 1))" />
                    <ValidationMessage For="@(() => customerGroup.Code)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("Name")</MudText>
                    <MudStack Row>
                        <MudTextField @bind-Value="customerGroup.Name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" @ref="txtName" OnKeyDown="@(e => KeyDown(e, 2))" />
                        <ValidationMessage For="@(() => customerGroup.Name)" />
                        <MudFab StartIcon="@Icons.Material.Rounded.Translate"
                                Color="Color.Info"
                                Size="Size.Small"
                                OnClick="ToArabic" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText>@Localizer("ArabicName")</MudText>
                    <MudTextField @bind-Value="customerGroup.NameArabic"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" @ref="txtNameArabic" OnKeyDown="@(e => KeyDown(e, 3))" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="8">
                    <MudText>@Localizer("Remarks")</MudText>
                    <MudTextField @bind-Value="customerGroup.Remarks"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="1"
                                  AutoGrow="true" @ref="txtRemarks" OnKeyDown="@(e => KeyDown(e, 4))" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="3" Class="ma-2">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="@(customerGroup.CustomerGroupId == 0 ? Color.Success : Color.Info)"
                           StartIcon="@(customerGroup.CustomerGroupId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)"
                           Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@Localizer("Processing")</MudText>
                    }
                    else
                    {
                        @Localizer(customerGroup.CustomerGroupId == 0 ? "Save" : "Update")
                    }
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="Delete">
                    @Localizer("Delete")
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NewClick">
                    @Localizer("New")
                </MudButton>
            </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2" Elevation="3">
    <MudDataGrid T="CustomerGroupMaster"
                 @ref="grid"
                 ServerData="LoadServerData"
                 RowClick="@RowClicked"
                 Dense="true"
                 Bordered="true"
                 SortMode="SortMode.Multiple" Filterable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("CustomerGroupList")</MudText>
            <MudSpacer />
            <MudTextField Margin="Margin.Dense" T="string" Value="@searchText" ValueChanged="OnSearch" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
            <PropertyColumn Property="x => x.NameArabic" Title="@Localizer("ArabicName")" />
            <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="CustomerGroupMaster" PageSizeOptions="new int[] { 5, 10, 20 }" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
