@page "/storemaster"
@using ZakiSAASERP.Models.Masters
@namespace ZakiSAASERP.Shared.Pages.Masters
@inject ISnackbar snackbar
@inject TabService TabService

<PageTitle>@Localizer("StoreMaster")</PageTitle>

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Spacing="2">
        <MudStack Row="true">
             <MudText Typo="Typo.h5">@Localizer("StoreMaster")</MudText>
             <MudSpacer />
             <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>
        <MudOverlay Visible="IsLoading" DarkBackground="true" Absolute="true" ZIndex="9999">
             <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
        </MudOverlay>

        <EditForm Model="store" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="store.Code" AutoFocus="true" Label="@Localizer("Code")" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    <ValidationMessage For="@(() => store.Code)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="store.Name" Label="@Localizer("Name")" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"/>
                    <ValidationMessage For="@(() => store.Name)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    @if (branches.Count > 0)
                    {
                        <MudSelect T="int?" Value="store.FK_BranchId" ValueChanged="OnBranchChanged" Label="@Localizer("Branch")" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@((int?)null)">@Localizer("AllBranches")</MudSelectItem>
                            @foreach (var x in branches)
                            {
                                <MudSelectItem Value="@((int?)x.BranchId)">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudCheckBox @bind-Value="store.IsDefaultStore" Label="@Localizer("DefaultStore")" Disabled="@isDefaultCheckboxReadOnly" Color="Color.Primary" />
                </MudItem>
                 <MudItem xs="12" md="12">
                    <MudTextField @bind-Value="store.Remarks" Label="@Localizer("Remarks")" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"/>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="3" Class="mt-4">
                 <MudButton OnClick="Clear" Variant="Variant.Filled" Color="Color.Secondary">@Localizer("New")</MudButton>
                 <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="@(store.StoreId == 0 ? Color.Success : Color.Info)" StartIcon="@(store.StoreId == 0 ? Icons.Material.Filled.Save : Icons.Material.Filled.Update)" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@Localizer("Processing")</MudText>
                    }
                    else
                    {
                        @Localizer(store.StoreId == 0 ? "Save" : "Update")
                    }
                 </MudButton>
                 @if(store.StoreId > 0)
                 {
                      <MudButton OnClick="Delete" Variant="Variant.Filled" Color="Color.Error">@Localizer("Delete")</MudButton>
                 }
            </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2 mt-4" Elevation="3">
    <MudDataGrid T="StoreMaster"
                 @ref="grid"
                 Items="@storeList"
                 QuickFilter="@FilterFunc"
                 RowClick="@RowClicked"
                 Dense="true"
                 Bordered="true"
                 Striped="true"
                 Hover="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("StoreList")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchText" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Dense="true" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
            <TemplateColumn Title="@Localizer("Branch")" SortBy="x => x.Branch == null ? string.Empty : x.Branch.Name">
                <CellTemplate>
                    @(context.Item.Branch == null ? Localizer("AllBranches") : context.Item.Branch.Name)
                </CellTemplate>
            </TemplateColumn>
     
            <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
            <PropertyColumn Property="x => x.IsDefaultStore" Title="@Localizer("IsDefaultStore")">
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="StoreMaster" PageSizeOptions="new int[]{5,10, 20}" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
