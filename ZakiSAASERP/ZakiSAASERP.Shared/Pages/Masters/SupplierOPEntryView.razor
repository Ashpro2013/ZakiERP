@page "/supplieropentry"
@page "/supplieropentry/{Id:int}"
@using ZakiSAASERP.Models.Masters
@using ZakiSAASERP.Models.DTO
@namespace ZakiSAASERP.Shared.Pages.Masters
@inject TabService TabService

<PageTitle>@Localizer("SupplierOpeningEntry")</PageTitle>

<MudPaper Class="pa-2 ma-2" Elevation="3">
    <MudStack Spacing="2">
        <MudStack Row="true">
            <MudText Typo="Typo.h5">@Localizer("SupplierOpeningEntry")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>
        <MudOverlay Visible="_isLoading" DarkBackground="true" Absolute="true" ZIndex="9999">
             <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
        </MudOverlay>

        <EditForm Model="entryDto">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudGrid>
                    <MudItem xs="12" md="3">
                         <MudTextField @bind-Value="entryDto.DocNo" Label="@Localizer("DocNo")" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"/>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="date" Label="@Localizer("EntryDate")" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"/>
                    </MudItem>
                     <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="entryDto.EnteredBy" Label="@Localizer("EnteredBy")" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                         <ValidationMessage For="@(() => entryDto.EnteredBy)" />
                    </MudItem>
                     <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="entryDto.Remarks" Label="@Localizer("Remarks")" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                </MudGrid>
            </MudPaper>

             <MudPaper Class="pa-2 mb-2" Outlined="true">
                  <MudToolBar Dense="true" Class="pa-0 mb-2">
                    <MudText Typo="Typo.h6">@Localizer("EntryDetails")</MudText>
                    <MudSpacer />
                </MudToolBar>

               <MudDataGrid T="SupplierOPEntryDetails" Items="@entryDto.EntryDetails" Dense="true" Bordered="true" Striped="true" Elevation="0" Style="max-height: 400px; overflow-y: auto;" FixedHeader="true">
                    <Columns>
                        <TemplateColumn Title="#">
                            <CellTemplate Context="det">
                                @(entryDto.EntryDetails.IndexOf(det.Item) + 1)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("Code")">
                            <CellTemplate Context="det">
                                <MudTextField id="@($"suppcode-{entryDto.EntryDetails.IndexOf(det.Item)}")" @bind-Value="det.Item.SupplierCode" Variant="Variant.Text" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => OpenSupplierDialog(det.Item))" Immediate="true" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "suppcode"))" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("SupplierName")">
                            <CellTemplate Context="det">
                                <MudTextField id="@($"suppname-{entryDto.EntryDetails.IndexOf(det.Item)}")" @bind-Value="det.Item.SupplierName" Variant="Variant.Text" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="@(() => OpenSupplierDialog(det.Item))" Immediate="true" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "suppname"))" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("PurchaseNo")">
                             <CellTemplate Context="det">
                                <MudTextField id="@($"purno-{entryDto.EntryDetails.IndexOf(det.Item)}")" @bind-Value="det.Item.PurchaseNo" Variant="Variant.Text" Margin="Margin.Dense" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "purno"))" />
                            </CellTemplate>
                        </TemplateColumn>
                         <TemplateColumn Title="@Localizer("PurchaseDate")">
                            <CellTemplate Context="det">
                                 <MudDatePicker id="@($"purdate-{entryDto.EntryDetails.IndexOf(det.Item)}")" @bind-Date="det.Item.PurchaseDate" DateFormat="dd/MM/yyyy" Variant="Variant.Text" Margin="Margin.Dense" PickerClosed="@(() => FocusById($"puramt-{entryDto.EntryDetails.IndexOf(det.Item)}"))" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("PurchaseAmt")">
                             <CellTemplate Context="det">
                                <MudNumericField id="@($"puramt-{entryDto.EntryDetails.IndexOf(det.Item)}")" Value="det.Item.PurchaseAmt" ValueChanged="@((decimal? v) => { det.Item.PurchaseAmt = v; CalculateBalance(det.Item); })" Variant="Variant.Text" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" HideSpinButtons="true" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "puramt"))" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("Received")">
                             <CellTemplate Context="det">
                                <MudNumericField id="@($"recamt-{entryDto.EntryDetails.IndexOf(det.Item)}")" Value="det.Item.ReceivedAmt" ValueChanged="@((decimal? v) => { det.Item.ReceivedAmt = v; CalculateBalance(det.Item); })" Variant="Variant.Text" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" HideSpinButtons="true" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "recamt"))" />
                            </CellTemplate>
                        </TemplateColumn>
                         <TemplateColumn Title="@Localizer("Discount")">
                             <CellTemplate Context="det">
                                <MudNumericField id="@($"discamt-{entryDto.EntryDetails.IndexOf(det.Item)}")" Value="det.Item.DiscountAmt" ValueChanged="@((decimal? v) => { det.Item.DiscountAmt = v; CalculateBalance(det.Item); })" Variant="Variant.Text" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" HideSpinButtons="true" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "discamt"))" />
                            </CellTemplate>
                        </TemplateColumn>
                         <TemplateColumn Title="@Localizer("Returned")">
                             <CellTemplate Context="det">
                                <MudNumericField id="@($"retamt-{entryDto.EntryDetails.IndexOf(det.Item)}")" Value="det.Item.ReturnedAmt" ValueChanged="@((decimal? v) => { det.Item.ReturnedAmt = v; CalculateBalance(det.Item); })" Variant="Variant.Text" Margin="Margin.Dense" Format="@PermanentSettingsData.CurrencyFormat" HideSpinButtons="true" OnKeyDown="@((e) => HandleFieldEnter(e, det.Item, "retamt"))" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("Balance")">
                            <CellTemplate Context="det">
                                <MudText Typo="Typo.body2" Class="d-flex justify-end">@det.Item.BalanceAmt?.ToString(PermanentSettingsData.CurrencyFormat)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@Localizer("Branch")">
                             <CellTemplate Context="det">
                                <MudSelect T="int?" @bind-Value="det.Item.FK_BranchId" Variant="Variant.Text" Margin="Margin.Dense" Dense="true" Class="d-flex align-center">
                                    @foreach(var b in branches)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)b.BranchId)">@b.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn CellClass="d-flex justify-end">
                            <CellTemplate Context="det">
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveRow(det.Item))" Color="Color.Error" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                 </MudDataGrid>
                <MudStack Row="true" Class="justify-end ma-2">
                     <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewRow" Size="Size.Small">@Localizer("AddRow")</MudButton>
                </MudStack>
            </MudPaper>

            <MudStack Row="true" Spacing="3" Class="d-flex justify-start mt-2">
                 <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => Clear(false))" StartIcon="@Icons.Material.Filled.Add">@Localizer("New")</MudButton>
                 @if(Id == 0)
                 {
                    <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">@Localizer("Processing")</MudText>
                        }
                        else
                        {
                            @Localizer("Save")
                        }
                    </MudButton>
                 }
                 <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Disabled="true">@Localizer("Print")</MudButton>
            </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2 mt-0" Elevation="3">
    <MudDataGrid T="SupplierOPEntry"
                 @ref="grid"
                 ServerData="LoadServerData"
                 RowClick="@RowClicked"
                 Dense="true"
                 Bordered="true"
                 Striped="true"
                 Hover="true"
                 SortMode="SortMode.Multiple" Filterable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("SupplierOpeningEntryList")</MudText>
            <MudSpacer />
            <MudTextField T="string" Value="@searchText" ValueChanged="OnSearch" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Dense="true" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.DocNo" Title="@Localizer("DocNo")" />
            <PropertyColumn Property="x => x.EntryDate" Title="@Localizer("EntryDate")" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.EnteredBy" Title="@Localizer("EnteredBy")" />
            <PropertyColumn Property="x => x.Branch.Name" Title="@Localizer("Branch")" />
            <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="SupplierOPEntry" PageSizeOptions="new int[] { 5, 10, 20 }" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
