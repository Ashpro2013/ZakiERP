@page "/technician-master"
@using ZakiSAASERP.Models.Masters
@inject IViewService api
@inject ModelService Dialog
@inject IDialogService DialogService
@inject ISnackbar snackbar
@inject TabService TabService

<PageTitle>@Localizer("TechnicianMaster")</PageTitle>

<MudPaper Class="pa-4 ma-2" Elevation="3">
    <MudStack Spacing="2">
        <MudStack Row="true">
            <MudText Typo="Typo.h5">@Localizer("TechnicianMaster")</MudText>
            <MudSpacer />
            <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="() => TabService.CloseTab(TabId)" Size="Size.Small" />
        </MudStack>

        <EditForm Model="technician" OnValidSubmit="SaveOrUpdate" @ref="form">
             <DataAnnotationsValidator />
             <ValidationSummary />

             <MudGrid>
                 <MudItem xs="12" sm="4">
                     <InfoTextField @ref="_codeField" @bind-Value="technician.Code" Label="@Localizer("Code")" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" ExAutoNext="true" AutoFocus="true" />
                 </MudItem>
                 <MudItem xs="12" sm="4">
                     <InfoTextField @bind-Value="technician.Name" Label="@Localizer("Name")" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" ExAutoNext="true" />
                 </MudItem>
                 <MudItem xs="12" sm="4">
                     <InfoTextField @bind-Value="technician.Position" Label="@Localizer("Position")" Variant="Variant.Outlined" Margin="Margin.Dense" ExAutoNext="true" />
                 </MudItem>
                 <MudItem xs="12" sm="4">
                     <InfoTextField @bind-Value="technician.Mobile" Label="@Localizer("Mobile")" Variant="Variant.Outlined" Margin="Margin.Dense" ExAutoNext="true" />
                 </MudItem>
                 <MudItem xs="12" sm="8">
                     <InfoTextField @bind-Value="technician.Remarks" Label="@Localizer("Remarks")" Variant="Variant.Outlined" Margin="Margin.Dense" ExAutoNext="true" />
                 </MudItem>
             </MudGrid>

             <MudStack Row="true" Spacing="3" Class="mt-4">
                 <MudButton ButtonType="ButtonType.Button" OnClick="@(async () => { if (form.EditContext?.Validate() ?? false) await SaveOrUpdate(); })" Variant="Variant.Filled" Color="@(technician.TechnicianId == 0 ? Color.Success : Color.Info)" Disabled="@_isSaving">
                     @if (_isSaving)
                     {
                         <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                         <MudText Class="ms-2">@Localizer("Processing")</MudText>
                     }
                     else
                     {
                         @Localizer(technician.TechnicianId == 0 ? "Save" : "Update")
                     }
                 </MudButton>
                 <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Delete">@Localizer("Delete")</MudButton>
                 <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="NewClick">@Localizer("New")</MudButton>
             </MudStack>
        </EditForm>
    </MudStack>
</MudPaper>

<MudPaper Class="ma-2 pa-2" Elevation="3">
    <MudDataGrid T="TechnicianMaster" ServerData="LoadServerData" @ref="grid" RowClick="@RowClicked" Dense="true" Bordered="true" Filterable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Localizer("TechnicianList")</MudText>
            <MudSpacer />
            <MudTextField Value="searchText" ValueChanged="@(async (string s) => { searchText = s; if (grid is not null) await grid.ReloadServerData(); })" Placeholder="@Localizer("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" Class="mx-3" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer("Code")" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer("Name")" />
            <PropertyColumn Property="x => x.Position" Title="@Localizer("Position")" />
            <PropertyColumn Property="x => x.Mobile" Title="@Localizer("Mobile")" />
            <PropertyColumn Property="x => x.Remarks" Title="@Localizer("Remarks")" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TechnicianMaster" PageSizeOptions="new int[] { 10, 20, 50 }" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>
