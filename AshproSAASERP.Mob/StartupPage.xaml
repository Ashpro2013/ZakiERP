<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AshproSAASERP.Mob.StartupPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid>

        <!-- Deep gradient background (matches ERP theme) -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f0c29" Offset="0.0" />
                <GradientStop Color="#302b63" Offset="0.5" />
                <GradientStop Color="#1a1a3e" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative top-left orb -->
        <Ellipse WidthRequest="180" HeightRequest="180"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 Margin="-60,-60,0,0" Opacity="0.15">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7c3aed" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Decorative bottom-right orb -->
        <Ellipse WidthRequest="150" HeightRequest="150"
                 HorizontalOptions="End" VerticalOptions="End"
                 Margin="0,0,-45,-45" Opacity="0.15">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#06b6d4" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Center content -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="10"
                             Padding="32,0">

            <!-- Logo icon box -->
            <Border WidthRequest="64" HeightRequest="64"
                    StrokeThickness="0"
                    HorizontalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7c3aed" Offset="0.0" />
                        <GradientStop Color="#06b6d4" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#7c3aed" Offset="0,4" Radius="14" Opacity="0.45" />
                </Border.Shadow>
                <Label Text="A"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- App name -->
            <Label Text="Ashpro SaaS ERP"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   CharacterSpacing="0.5" />

            <!-- Tagline -->
            <Label Text="Enterprise Resource Planning"
                   FontSize="10"
                   TextColor="#9999BB"
                   HorizontalOptions="Center"
                   CharacterSpacing="0.8" />

            <!-- Thin separator -->
            <BoxView HeightRequest="1"
                     WidthRequest="80"
                     Opacity="0.22"
                     Margin="0,4"
                     HorizontalOptions="Center">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="White"       Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Loading spinner -->
            <ActivityIndicator x:Name="Loader"
                               IsRunning="True"
                               IsVisible="True"
                               Color="#7c3aed"
                               WidthRequest="26"
                               HeightRequest="26"
                               HorizontalOptions="Center" />

            <!-- Status text -->
            <Label x:Name="StatusLabel"
                   Text="Initializing..."
                   FontSize="10"
                   TextColor="#7777AA"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>

        <!-- Bottom version badge -->
        <Label Text="© Ashpro Technologies"
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,14"
               FontSize="9"
               TextColor="#FFFFFF22"
               CharacterSpacing="0.5" />

        <!-- DB Config Overlay (glassmorphic dialog card) -->
        <Grid x:Name="DbConfigOverlay" IsVisible="False" BackgroundColor="#DD05041A">
            <ScrollView VerticalOptions="Center" HorizontalOptions="Center" Margin="16">
                <Border MaximumWidthRequest="750"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        StrokeThickness="1"
                        Stroke="#4A3B9B">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#251E4E" Offset="0.0" />
                            <GradientStop Color="#0D0926" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#7c3aed" Offset="0,6" Radius="20" Opacity="0.3" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="16" Padding="28,24">
                        <Label Text="Database Configuration"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                               
                        <Label Text="Select your DB Provider and enter the connection string to continue."
                               FontSize="11"
                               TextColor="#B2B2D5"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                               
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Database Provider" TextColor="#A5A5C7" FontSize="11" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="6" HeightRequest="40">
                                <Button Grid.Column="0" Text="MSSQL" x:Name="BtnMSSQL" Clicked="OnProviderButtonClicked" CommandParameter="MSSQL" HeightRequest="40" CornerRadius="8" BorderWidth="1.5" FontSize="10.5" Padding="0" FontAttributes="Bold" TextColor="White" />
                                <Button Grid.Column="1" Text="SQLite" x:Name="BtnSQLite" Clicked="OnProviderButtonClicked" CommandParameter="SQLite" HeightRequest="40" CornerRadius="8" BorderWidth="1.5" FontSize="10.5" Padding="0" FontAttributes="Bold" TextColor="White" />
                                <Button Grid.Column="2" Text="PSQL" x:Name="BtnPSQL" Clicked="OnProviderButtonClicked" CommandParameter="PSQL" HeightRequest="40" CornerRadius="8" BorderWidth="1.5" FontSize="10.5" Padding="0" FontAttributes="Bold" TextColor="White" />
                                <Button Grid.Column="3" Text="MySQL" x:Name="BtnMySQL" Clicked="OnProviderButtonClicked" CommandParameter="MySQL" HeightRequest="40" CornerRadius="8" BorderWidth="1.5" FontSize="10.5" Padding="0" FontAttributes="Bold" TextColor="White" />
                                <Button Grid.Column="4" Text="Oracle" x:Name="BtnOracle" Clicked="OnProviderButtonClicked" CommandParameter="Oracle" HeightRequest="40" CornerRadius="8" BorderWidth="1.5" FontSize="10.5" Padding="0" FontAttributes="Bold" TextColor="White" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Connection String" TextColor="#A5A5C7" FontSize="11" FontAttributes="Bold" />
                            <Entry x:Name="ConnectionStringEntry"
                                   TextColor="White"
                                   Placeholder="Server=myServerAddress;Database=myDataBase;..."
                                   PlaceholderColor="#4E4E6E"
                                   BackgroundColor="#0F0B24"
                                   HeightRequest="44" />
                        </VerticalStackLayout>

                        <Button x:Name="SaveDbConfigButton"
                                Text="Save &amp; Connect"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="8"
                                Clicked="OnSaveDbConfigClicked"
                                Margin="0,8,0,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7c3aed" Offset="0.0" />
                                    <GradientStop Color="#06b6d4" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

    </Grid>

</ContentPage>
