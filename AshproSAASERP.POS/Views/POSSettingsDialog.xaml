<Window x:Class="AshproSAASERP.POS.Views.POSSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AshproSAASERP.POS.ViewModels"
        mc:Ignorable="d"
        Title="POS Display &amp; Layout Settings"
        Height="720" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, Outfit, sans-serif">

    <Window.Resources>
        <!-- TabItem Custom Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#1E3A8A" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle CheckBox / Switch Style -->
        <Style x:Key="SettingCardCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>

    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header -->
                <RowDefinition Height="*" />
                <!-- Tabs / Content -->
                <RowDefinition Height="65" />
                <!-- Actions Footer -->
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="#EFF6FF" CornerRadius="10" Margin="0,0,14,0">
                        <TextBlock Text="⚙" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="POS Display &amp; Layout Settings" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Configure table columns, button dimensions, panel sizing, and touch interface preferences" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Width="32" Height="32" Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- ==================== TABS CONTENT ==================== -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,10,16,0">

                <!-- TAB 1: GRID COLUMNS & EDITING -->
                <TabItem Header="📋 Grid Columns &amp; Editing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                        <StackPanel>
                            <!-- Visibility Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Datagrid Column Visibility" FontSize="15" FontWeight="Bold" Foreground="#1E293B" />
                                    <TextBlock Text="Toggle which columns are displayed in the active POS transaction table." FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Select All" Padding="12,5" Margin="0,0,8,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Command="{Binding SelectAllColumnsCommand}" />
                                    <Button Content="Default Columns" Padding="12,5" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Command="{Binding ResetDefaultColumnsCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Columns Grid (2 columns) -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Product Code" IsChecked="{Binding Model.ShowItemCode, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Display item code identifier" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Barcode" IsChecked="{Binding Model.ShowBarcode, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Display scanned barcode value" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Arabic Name" IsChecked="{Binding Model.ShowArabicName, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Display secondary item Arabic title" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Exclusive Rate (Ex. Rate)" IsChecked="{Binding Model.ShowExRate, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Rate before tax/VAT" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Inclusive Rate (Inc. Rate)" IsChecked="{Binding Model.ShowIncRate, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Rate including VAT" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Gross Amount" IsChecked="{Binding Model.ShowGross, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Quantity × Rate before discount" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Discount Percentage (%)" IsChecked="{Binding Model.ShowDiscPercentage, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Line discount percentage" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Discount Amount" IsChecked="{Binding Model.ShowDiscAmount, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Line discount monetary total" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Taxable Amount" IsChecked="{Binding Model.ShowTaxableAmount, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Gross minus discount amount" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Tax Percentage (VAT %)" IsChecked="{Binding Model.ShowTaxPercentage, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Tax rate percentage applied" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Tax Amount" IsChecked="{Binding Model.ShowTaxAmount, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Tax monetary value for line" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Unit of Measure" IsChecked="{Binding Model.ShowUnit, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Unit (Pcs, Box, etc.)" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <CheckBox Content="Net Line Amount" IsChecked="{Binding Model.ShowAmount, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                        <TextBlock Text="Total line payable after tax" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Inline Grid Editing Permissions -->
                            <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="Inline Grid Editing Permissions" FontSize="15" FontWeight="Bold" Foreground="#1E293B" />
                                    <TextBlock Text="Control which columns cashiers are permitted to edit directly in the table." FontSize="12" Foreground="#64748B" Margin="0,2,0,8" />

                                    <UniformGrid Columns="2">
                                        <Border Style="{StaticResource SettingCard}">
                                            <StackPanel>
                                                <CheckBox Content="Edit Exclusive Rate (ExcRate)" IsChecked="{Binding Model.AllowEditExcRate, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Allow modifying rate before tax in grid" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingCard}">
                                            <StackPanel>
                                                <CheckBox Content="Edit Inclusive Rate (IncRate)" IsChecked="{Binding Model.AllowEditIncRate, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Allow modifying rate including VAT in grid" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingCard}">
                                            <StackPanel>
                                                <CheckBox Content="Edit Discount % (DiscPer)" IsChecked="{Binding Model.AllowEditDiscPer, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Allow modifying discount % directly in grid" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingCard}">
                                            <StackPanel>
                                                <CheckBox Content="Edit Discount Amount (DiscAmount)" IsChecked="{Binding Model.AllowEditDiscAmount, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Allow modifying discount total directly in grid" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingCard}">
                                            <StackPanel>
                                                <CheckBox Content="Readonly Invoice Number" IsChecked="{Binding Model.ReadonlyInvoiceNumber, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Make invoice number field read-only in POS header" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: LAYOUT & SIZING -->
                <TabItem Header="📐 Layout &amp; Sizing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Category Controls -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Category Navigation Panel" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />

                                        <!-- Panel Width Slider -->
                                        <TextBlock Text="{Binding Model.CategoryPanelWidth, StringFormat='Category Panel Width: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="70" Maximum="220" Value="{Binding Model.CategoryPanelWidth, Mode=TwoWay}" SmallChange="2" LargeChange="10" Margin="0,4,0,12" />

                                        <!-- Button Height Slider -->
                                        <TextBlock Text="{Binding Model.CategoryButtonHeight, StringFormat='Button Height: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="45" Maximum="110" Value="{Binding Model.CategoryButtonHeight, Mode=TwoWay}" SmallChange="2" LargeChange="10" Margin="0,4,0,12" />

                                        <!-- Icon Size Slider -->
                                        <TextBlock Text="{Binding Model.CategoryIconSize, StringFormat='Icon Size: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="20" Maximum="56" Value="{Binding Model.CategoryIconSize, Mode=TwoWay}" SmallChange="2" LargeChange="6" Margin="0,4,0,12" />

                                        <!-- Font Size Slider -->
                                        <TextBlock Text="{Binding Model.CategoryFontSize, StringFormat='Font Size: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="9" Maximum="16" Value="{Binding Model.CategoryFontSize, Mode=TwoWay}" SmallChange="1" LargeChange="2" Margin="0,4,0,12" />

                                        <CheckBox Content="Show Category Images / Icons" IsChecked="{Binding Model.ShowCategoryImages, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Right Column: Product Catalog Controls -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Product Catalog Area &amp; Cards" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />

                                        <!-- Split Height Slider -->
                                        <TextBlock Text="{Binding Model.ProductAreaHeight, StringFormat='Product Area Height (Split %): {0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="25" Maximum="75" Value="{Binding Model.ProductAreaHeight, Mode=TwoWay}" SmallChange="5" LargeChange="10" Margin="0,4,0,12" />

                                        <!-- Card Width Slider -->
                                        <TextBlock Text="{Binding Model.ProductButtonWidth, StringFormat='Card Min Width: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="90" Maximum="240" Value="{Binding Model.ProductButtonWidth, Mode=TwoWay}" SmallChange="4" LargeChange="10" Margin="0,4,0,12" />

                                        <!-- Card Height Slider -->
                                        <TextBlock Text="{Binding Model.ProductButtonHeight, StringFormat='Card Min Height: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="80" Maximum="240" Value="{Binding Model.ProductButtonHeight, Mode=TwoWay}" SmallChange="4" LargeChange="10" Margin="0,4,0,12" />

                                        <!-- Title Font Size Slider -->
                                        <TextBlock Text="{Binding Model.ProductFontSize, StringFormat='Title Font Size: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="10" Maximum="18" Value="{Binding Model.ProductFontSize, Mode=TwoWay}" SmallChange="1" LargeChange="2" Margin="0,4,0,12" />

                                        <!-- Price Font Size Slider -->
                                        <TextBlock Text="{Binding Model.ProductPriceFontSize, StringFormat='Price Font Size: {0}px'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                        <Slider Minimum="10" Maximum="18" Value="{Binding Model.ProductPriceFontSize, Mode=TwoWay}" SmallChange="1" LargeChange="2" Margin="0,4,0,12" />

                                        <CheckBox Content="Show Product Images on Cards" IsChecked="{Binding Model.ShowProductImages, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" Margin="0,4,0,8" />

                                        <DockPanel Margin="0,4,0,0">
                                            <CheckBox Content="Enable Pagination" IsChecked="{Binding Model.EnableProductPagination, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Model.ProductPageSize, StringFormat='Page Size: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Slider Minimum="4" Maximum="60" Value="{Binding Model.ProductPageSize, Mode=TwoWay}" SmallChange="2" LargeChange="6" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Live Interactive Preview Box -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔍 Live Preview" FontSize="13" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Category Preview Item -->
                                        <Border Width="{Binding Model.CategoryPanelWidth}" MinHeight="{Binding Model.CategoryButtonHeight}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,20,0">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="{Binding Model.CategoryIconSize}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Beverages" FontSize="{Binding Model.CategoryFontSize}" FontWeight="SemiBold" TextAlignment="Center" Foreground="#1E293B" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Product Card Preview Item -->
                                        <Border Width="{Binding Model.ProductButtonWidth}" Height="{Binding Model.ProductButtonHeight}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="☕" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                                                <TextBlock Grid.Row="1" Text="Hot Coffee" FontSize="{Binding Model.ProductFontSize}" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                                <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                                    <TextBlock Text="12.00 SAR" FontSize="{Binding Model.ProductPriceFontSize}" FontWeight="ExtraBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: PREFERENCES -->
                <TabItem Header="⚙ Preferences">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Touch & Input -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Touch &amp; Input Behavior" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <CheckBox Content="Show Numeric Keypad by Default" IsChecked="{Binding Model.ShowNumPadByDefault, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Keep the touch number pad visible on POS launch" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <CheckBox Content="Auto-Focus Barcode Input" IsChecked="{Binding Model.AutoFocusBarcode, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Automatically return focus to barcode scan input after item selection" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Checkout & Presentation -->
                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Checkout &amp; Presentation" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <CheckBox Content="Auto-Print Bill upon Save" IsChecked="{Binding Model.AutoPrintBill, Mode=TwoWay}" Style="{StaticResource SettingCardCheckBox}" />
                                                <TextBlock Text="Automatically launch receipt printing after payment completion" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingCard}">
                                            <StackPanel>
                                                <TextBlock Text="Default Payment Mode" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6" />
                                                <ComboBox SelectedValue="{Binding Model.DefaultPaymentMode, Mode=TwoWay}" SelectedValuePath="Content" Padding="8,4" Background="#FFFFFF">
                                                    <ComboBoxItem Content="Cash" />
                                                    <ComboBoxItem Content="Bank" />
                                                </ComboBox>
                                                <TextBlock Text="Default tab selected when opening payment dialog" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ==================== ACTIONS FOOTER ==================== -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12">
                <Grid>
                    <Button Content="↺ Reset All Defaults" HorizontalAlignment="Left" Padding="14,8" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Command="{Binding ResetAllDefaultsCommand}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Padding="18,8" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Command="{Binding CancelCommand}" />
                        <Button Content="💾 Save Settings" Padding="20,8" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

