<Window x:Class="AshproSAASERP.POS.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:AshproSAASERP.POS.Services"
        mc:Ignorable="d"
        Title="Zaki ERP"
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ProviderToBackgroundConverter x:Key="ProvToBg" />
    </Window.Resources>

    <Border CornerRadius="20" ClipToBounds="True" BorderThickness="1" BorderBrush="#352F64">
        <Border.Background>
            <!-- Deep gradient background matching .Desk ERP theme -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f0c29" Offset="0.0" />
                <GradientStop Color="#302b63" Offset="0.5" />
                <GradientStop Color="#1a1a3e" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Decorative top-left orb -->
            <Ellipse Width="260" Height="260"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-80,-80,0,0" Opacity="0.25" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7c3aed" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Decorative bottom-right orb -->
            <Ellipse Width="240" Height="240"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-60,-60" Opacity="0.22" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06b6d4" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Center Splash Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <!-- Logo -->
                <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="#06b6d4" BlurRadius="25" ShadowDepth="4" Opacity="0.45" />
                    </Border.Effect>
                    <Image Source="/Assets/zaki_logo.png" Stretch="Uniform" />
                </Border>

                <!-- App Title -->
                <TextBlock Text="Zaki ERP"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />

                <!-- Tagline -->
                <TextBlock Text="Enterprise Resource Planning"
                           FontSize="11"
                           Foreground="#9999BB"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />

                <!-- Thin Separator -->
                <Border Height="1" Width="100" Margin="0,16,0,16" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="White" Offset="0.5" />
                            <GradientStop Color="Transparent" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Progress Bar -->
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Width="220"
                             Foreground="#7c3aed"
                             Background="#2A244E"
                             BorderThickness="0"
                             HorizontalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <!-- Status Label -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="#A3A3D0"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>

            <!-- Database Configuration Modal Overlay (matching .Desk DbConfigOverlay) -->
            <Grid Background="#D005041A"
                  Visibility="{Binding ShowDbConfig, Converter={StaticResource BoolToVis}}">
                <Border Width="680"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="#4A3B9B"
                        Padding="28,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#251E4E" Offset="0.0" />
                            <GradientStop Color="#0D0926" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#7c3aed" BlurRadius="30" ShadowDepth="6" Opacity="0.35" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Database Configuration"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Select your DB Provider and enter the connection string to continue."
                                   FontSize="11"
                                   Foreground="#B2B2D5"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,18" />

                        <!-- Provider Selection -->
                        <TextBlock Text="Database Provider" Foreground="#A5A5C7" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                        <UniformGrid Columns="5" Margin="0,0,0,16">
                            <Button Content="MSSQL" Command="{Binding SelectProviderCommand}" CommandParameter="MSSQL"
                                    Height="38" Margin="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                    Background="{Binding SelectedProvider, Converter={StaticResource ProvToBg}, ConverterParameter='MSSQL'}" />
                            <Button Content="SQLite" Command="{Binding SelectProviderCommand}" CommandParameter="SQLite"
                                    Height="38" Margin="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                    Background="{Binding SelectedProvider, Converter={StaticResource ProvToBg}, ConverterParameter='SQLite'}" />
                            <Button Content="PSQL" Command="{Binding SelectProviderCommand}" CommandParameter="PSQL"
                                    Height="38" Margin="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                    Background="{Binding SelectedProvider, Converter={StaticResource ProvToBg}, ConverterParameter='PSQL'}" />
                            <Button Content="MySQL" Command="{Binding SelectProviderCommand}" CommandParameter="MySQL"
                                    Height="38" Margin="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                    Background="{Binding SelectedProvider, Converter={StaticResource ProvToBg}, ConverterParameter='MySQL'}" />
                            <Button Content="Oracle" Command="{Binding SelectProviderCommand}" CommandParameter="Oracle"
                                    Height="38" Margin="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                    Background="{Binding SelectedProvider, Converter={StaticResource ProvToBg}, ConverterParameter='Oracle'}" />
                        </UniformGrid>

                        <!-- Connection String Input -->
                        <TextBlock Text="Connection String" Foreground="#A5A5C7" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44"
                                 Background="#0F0B24"
                                 Foreground="White"
                                 BorderBrush="#4A3B9B"
                                 BorderThickness="1"
                                 Padding="10,12"
                                 FontSize="12" />

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#F87171"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />

                        <!-- Save & Connect Button -->
                        <Button Content="Save &amp; Connect"
                                Command="{Binding SaveDbConfigCommand}"
                                Height="46"
                                Margin="0,14,0,0"
                                FontWeight="Bold"
                                FontSize="13"
                                Foreground="White"
                                Cursor="Hand">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7c3aed" Offset="0.0" />
                                    <GradientStop Color="#06b6d4" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Close Button at top right -->
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,14,0"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#8E8EA8"
                    FontSize="12"
                    Cursor="Hand"
                    Click="Close_Click" />
        </Grid>
    </Border>
</Window>

